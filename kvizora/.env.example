# Скопируйте этот файл в .env и впишите свои значения (файл .env читается при npm start).
# Ключ Google Gemini для «теста из фото» и переводов: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Порт сервера (по умолчанию 3000)
PORT=3000
# Забыли пароль администратора? На компьютере-сервере: npm run reset-password -- e-mail
# Тест з підручника: запитів до Gemini на школу за добу (за замовчуванням 300)
# BOOKS_AI_PER_DAY=300
