B.mine = function()
	local parts = { P("Ball", V(2.4, 2.4, 2.4), C(48, 52, 58), "Metal", nil, { refl = 0.1 }) }
	local dirs = {
		V(1, 0, 0),
		V(-1, 0, 0),
		V(0, 1, 0),
		V(0, 0, 1),
		V(0, 0, -1),
		V(0.7, 0.7, 0),
		V(-0.7, 0.7, 0),
		V(0, 0.7, 0.7),
		V(0, 0.7, -0.7),
	}
	for _, d in dirs do
		local dir = d.Unit
		local pos = dir * 1.35
		table.insert(parts, P("Cylinder", V(0.6, 0.25, 0.25), C(90, 90, 95), "Metal", alongAxis(pos, dir)))
	end
	return parts, V(3.6, 3.6, 3.6)
end

