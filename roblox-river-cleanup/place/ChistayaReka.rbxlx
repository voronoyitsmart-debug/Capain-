	CostGrowth = 4,
	CoinBonus = 0.5, -- +50% монет за каждое перерождение
	LuckBonus = 0.05, -- +5% удачи за каждое перерождение
}

----------------------------------------------------------------------
-- Награды
----------------------------------------------------------------------
Config.Daily = {
	Mults = { 2, 3, 4, 6, 8, 10, 20 }, -- множители RewardBase по дням серии
	MinInterval = 20 * 3600, -- раз в 20 часов
	StreakWindow = 48 * 3600, -- если пропустил больше 48 часов — серия сбрасывается
}

-- Подарки за время в игре (за текущий заход)
Config.Gifts = {
	{ Minutes = 3, Mult = 1 },
	{ Minutes = 8, Mult = 2 },
	{ Minutes = 15, Mult = 3 },
	{ Minutes = 25, Mult = 5 },
	{ Minutes = 40, Mult = 8 },
	{ Minutes = 60, Mult = 15, Boost = "Coins2x" },
}

Config.Quests = {
	Slots = 3,
	RerollCooldown = 300, -- заменить задание можно раз в 5 минут
}

-- Каждый новый предмет в коллекции даёт +1.5% к монетам навсегда
Config.Collection = {
	BonusPerItem = 0.015,
}

----------------------------------------------------------------------
-- Появление мусора
----------------------------------------------------------------------
Config.Spawning = {
	StuckChance = 0.35, -- доля мусора, застрявшего у берега (не уплывает)
	StuckLife = { 110, 170 },
	IdleMax = 14, -- сколько мусора держать в зоне, где никого нет
	PrefillCount = 20,
	ArrivalFill = 0.6, -- когда в пустую зону приходит игрок, река сразу заполняется до 60% -- сколько мусора сразу при старте сервера
	PlayerSpawnBonus = 0.35, -- каждый игрок в зоне ускоряет появление на 35%
}

Config.AutoCollect = {
	CooldownMult = 1.6, -- авто-сбор медленнее ручного
}

----------------------------------------------------------------------
-- Глобальные события сервера
----------------------------------------------------------------------
Config.Events = {
	FirstDelay = 240,
	Interval = { 420, 600 },
	List = {
		{
			Key = "TrashStorm",
			Name = "Мусорный шторм",
			Icon = "🌪️",
			Desc = "Мусора в 3 раза больше!",
			Duration = 120,
			SpawnMult = 3,
			MaxMult = 1.6,
		},
		{ Key = "GoldenHour", Name = "Золотой час", Icon = "🌟", Desc = "Все монеты x2!", Duration = 150, CoinMult = 2 },
		{ Key = "LuckyRain", Name = "Звездопад удачи", Icon = "🍀", Desc = "Удача x2 для всех!", Duration = 150, LuckMult = 2 },
	},
}

-- Настройки, которые игрок может переключать
Config.SettingKeys = {
	AutoCollect = true,
	AutoSell = true,
	WaterWalk = true,
	ShowRange = true,
	Sounds = true,
	Music = true,
	Effects = true,
}

----------------------------------------------------------------------
-- Быстрые таблицы (заполняются автоматически)
----------------------------------------------------------------------
Config.BoostByKey = {}
for _, boost in Config.Boosts do
	Config.BoostByKey[boost.Key] = boost
end

Config.HelperByKey = {}
for index, helper in Config.Helpers do
	helper.Index = index
	Config.HelperByKey[helper.Key] = helper
end

Config.EventByKey = {}
for _, event in Config.Events.List do
	Config.EventByKey[event.Key] = event
end

-- Порядок перков для магазина
Config.PerkOrder = {}
for key, perk in Config.Perks do
	perk.Key = key
	table.insert(Config.PerkOrder, key)
end
table.sort(Config.PerkOrder, function(a, b)
	return Config.Perks[a].Order < Config.Perks[b].Order
end)

-- Сколько предметов каждой редкости в каждой зоне (для весов выпадения)
Config.ZoneRarityCount = {}
for zoneId, zone in Config.Zones do
	local counts = {}
	for _, key in zone.Trash do
		local def = Config.Trash[key]
		assert(def, "Нет описания мусора: " .. key)
		def.Key = key
		counts[def.Rarity] = (counts[def.Rarity] or 0) + 1
	end
	Config.ZoneRarityCount[zoneId] = counts
end

Config.TotalTrashTypes = 0
for _ in Config.Trash do
	Config.TotalTrashTypes += 1
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--[[
	Format — красивые числа и время: 1.25K, 3.4M, 12:05, 1ч 20м
]]

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

local function stripZeros(s: string): string
	if string.find(s, "%.") then
		s = string.gsub(s, "0+$", "")
		s = string.gsub(s, "%.$", "")
	end
	return s
end

-- 1234 -> "1.23K", 15000000 -> "15M"
function Format.number(n: number?): string
	local value = n or 0
	if value ~= value then
		return "0"
	end
	local negative = value < 0
	value = math.abs(value)

	local text
	if value < 1000 then
		text = tostring(math.floor(value))
	else
		local index = 1
		while value >= 1000 and index < #SUFFIXES do
			value /= 1000
			index += 1
		end
		local shown
		if value < 10 then
			shown = stripZeros(string.format("%.2f", math.floor(value * 100) / 100))
		elseif value < 100 then
			shown = stripZeros(string.format("%.1f", math.floor(value * 10) / 10))
		else
			shown = tostring(math.floor(value))
		end
		text = shown .. SUFFIXES[index]
	end

	return (negative and "-" or "") .. text
end

-- 1234567 -> "1 234 567"
function Format.spaced(n: number?): string
	local value = math.floor(n or 0)
	local s = tostring(math.abs(value))
	local out = string.reverse(s)
	out = string.gsub(out, "(%d%d%d)", "%1 ")
	out = string.reverse(out)
	out = string.gsub(out, "^ ", "")
	return (value < 0 and "-" or "") .. out
end

-- секунды -> "1ч 05м", "12:34", "0:07"
function Format.time(seconds: number?): string
	local s = math.max(0, math.floor(seconds or 0))
	local h = s // 3600
	local m = (s % 3600) // 60
	local sec = s % 60
	if h > 0 then
		return string.format("%dч %02dм", h, m)
	end
	return string.format("%d:%02d", m, sec)
end

-- длинная форма: "2 ч 30 мин", "45 сек"
function Format.duration(seconds: number?): string
	local s = math.max(0, math.floor(seconds or 0))
	local h = s // 3600
	local m = (s % 3600) // 60
	local sec = s % 60
	if h > 0 then
		if m > 0 then
			return string.format("%d ч %d мин", h, m)
		end
		return string.format("%d ч", h)
	elseif m > 0 then
		if sec > 0 and m < 10 then
			return string.format("%d мин %d сек", m, sec)
		end
		return string.format("%d мин", m)
	end
	return string.format("%d сек", sec)
end

-- Русское склонение: plural(5, "предмет", "предмета", "предметов") -> "предметов"
function Format.plural(n: number, one: string, few: string, many: string): string
	local v = math.abs(math.floor(n)) % 100
	local v1 = v % 10
	if v > 10 and v < 20 then
		return many
	elseif v1 > 1 and v1 < 5 then
		return few
	elseif v1 == 1 then
		return one
	end
	return many
end

function Format.percent(fraction: number): string
	local p = fraction * 100
	if math.abs(p - math.floor(p)) < 0.05 then
		return string.format("%d%%", math.floor(p + 0.5))
	end
	return string.format("%.1f%%", p)
end

function Format.multiplier(m: number): string
	if math.abs(m - math.floor(m)) < 0.005 then
		return "x" .. tostring(math.floor(m))
	end
	return "x" .. stripZeros(string.format("%.2f", m))
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Formulas</string>
          <string name="Source"><![CDATA[--[[
	Formulas — вся математика игры. Используется и сервером, и клиентом,
	поэтому интерфейс всегда показывает те же числа, что считает сервер.

	now — время в секундах (сервер: os.time(), клиент: workspace:GetServerTimeNow())
	eventId — ключ активного события сервера или nil
]]

local Config = require(script.Parent.Config)

local Formulas = {}

local function perks(data)
	return data.Perks or {}
end

----------------------------------------------------------------------
-- Бусты
----------------------------------------------------------------------
function Formulas.boostActive(data, key: string, now: number): boolean
	local record = data.Boosts and data.Boosts[key]
	return record ~= nil and (record.EndsAt or 0) > now
end

-- "active", осталось | "cooldown", осталось | "ready", 0
function Formulas.boostState(data, key: string, now: number): (string, number)
	local record = data.Boosts and data.Boosts[key]
	if record then
		if (record.EndsAt or 0) > now then
			return "active", record.EndsAt - now
		end
		if (record.ReadyAt or 0) > now then
			return "cooldown", record.ReadyAt - now
		end
	end
	return "ready", 0
end

local function eventDef(eventId: string?)
	return eventId and Config.EventByKey[eventId] or nil
end

----------------------------------------------------------------------
-- Множители
----------------------------------------------------------------------
function Formulas.rebirthMultiplier(rebirths: number): number
	return 1 + Config.Rebirth.CoinBonus * (rebirths or 0)
end

function Formulas.rebirthCost(rebirths: number): number
	return math.floor(Config.Rebirth.BaseCost * Config.Rebirth.CostGrowth ^ (rebirths or 0))
end

function Formulas.collectionCount(data): number
	local n = 0
	if data.Discovered then
		for key in data.Discovered do
			if Config.Trash[key] then
				n += 1
			end
		end
	end
	return n
end

function Formulas.collectionBonus(data): number
	return Formulas.collectionCount(data) * Config.Collection.BonusPerItem
end

function Formulas.coinMultiplier(data, now: number, eventId: string?): number
	local m = Formulas.rebirthMultiplier(data.Rebirths)
	m *= 1 + (perks(data).Banker or 0) * Config.Perks.Banker.BonusPerLevel
	m *= 1 + Formulas.collectionBonus(data)
	if Formulas.boostActive(data, "Coins2x", now) then
		m *= 2
	end
	local ev = eventDef(eventId)
	if ev and ev.CoinMult then
		m *= ev.CoinMult
	end
	return m
end

function Formulas.luck(data, now: number, eventId: string?): number
	local l = 1
		+ (perks(data).Luck or 0) * Config.Perks.Luck.BonusPerLevel
		+ (data.Rebirths or 0) * Config.Rebirth.LuckBonus
	if Formulas.boostActive(data, "Luck2x", now) then
		l *= 2
	end
	local ev = eventDef(eventId)
	if ev and ev.LuckMult then
		l *= ev.LuckMult
	end
	return l
end

----------------------------------------------------------------------
-- Цены
----------------------------------------------------------------------
-- Цена покупки уровня `level` перка `key`
function Formulas.perkCost(key: string, level: number): number?
	local def = Config.Perks[key]
	if not def or level < 1 or level > def.MaxLevel then
		return nil
	end
	if def.Costs then
		return def.Costs[level]
	end
	return math.floor(def.BaseCost * def.Growth ^ (level - 1))
end

function Formulas.rewardBase(data): number
	local zone = Config.Zones[math.clamp(data.MaxZone or 1, 1, #Config.Zones)]
	return zone.RewardBase * Formulas.rebirthMultiplier(data.Rebirths)
end

----------------------------------------------------------------------
-- Фабрика
----------------------------------------------------------------------
function Formulas.factoryRate(level: number): number
	if level <= 0 then
		return 0
	end
	return Config.Factory.BaseRate * Config.Factory.RateGrowth ^ (level - 1)
end

-- Цена постройки уровня `level`
function Formulas.factoryCost(level: number): number
	return math.floor(Config.Factory.BaseCost * Config.Factory.CostGrowth ^ (level - 1))
end

-- Сколько секунд строится уровень `level`
function Formulas.factoryBuildTime(level: number): number
	local t = Config.Factory.BaseBuildTime * Config.Factory.BuildGrowth ^ (level - 1)
	return math.min(Config.Factory.MaxBuildTime, math.floor(t))
end

function Formulas.factoryStorageHours(data): number
	local hours = Config.Factory.StorageHours
	local level = math.clamp(perks(data).Storage or 0, 0, #hours - 1)
	return hours[level + 1]
end

local function rateFor(data, level: number): number
	return Formulas.factoryRate(level) * Formulas.rebirthMultiplier(data.Rebirths)
end

function Formulas.factoryCap(data, level: number?): number
	local lvl = level or data.Factory.Level
	return rateFor(data, lvl) * Formulas.factoryStorageHours(data) * 3600
end

-- Сколько произведено на уровне `level` между fromTime и toTime (без учёта склада)
local function accrual(data, level: number, fromTime: number, toTime: number): number
	if level <= 0 or toTime <= fromTime then
		return 0
	end
	local seconds = toTime - fromTime
	local turbo = data.Boosts and data.Boosts.FactoryTurbo
	if turbo and turbo.StartAt and turbo.EndsAt then
		local overlap = math.max(0, math.min(toTime, turbo.EndsAt) - math.max(fromTime, turbo.StartAt))
		local mult = Config.BoostByKey.FactoryTurbo.FactoryMult or 3
		seconds += overlap * (mult - 1)
	end
	return rateFor(data, level) * seconds
end

--[[
	Возвращает состояние фабрики на момент now, НЕ меняя data:
	{ Level, Stored, LastCalc, BuildingTo, BuildEndsAt, Completed }
]]
function Formulas.simulateFactory(data, now: number)
	local f = data.Factory
	local level = f.Level or 0
	local stored = f.Stored or 0
	local last = f.LastCalc or now
	local buildingTo = f.BuildingTo or 0
	local buildEnds = f.BuildEndsAt or 0
	local completed = false

	-- копим на уровне lvl от from до to, но не больше вместимости склада
	local function advance(lvl: number, fromTime: number, toTime: number)
		if toTime <= fromTime then
			return
		end
		local cap = Formulas.factoryCap(data, lvl)
		if stored < cap then
			stored = math.min(cap, stored + accrual(data, lvl, fromTime, toTime))
		end
	end

	if buildingTo > 0 and now >= buildEnds then
		-- до конца стройки фабрика работала на старом уровне
		if buildEnds > last then
			advance(level, last, buildEnds)
			last = buildEnds
		end
		level = buildingTo
		buildingTo = 0
		buildEnds = 0
		completed = true
	end

	if now > last then
		advance(level, last, now)
		last = now
	end

	return {
		Level = level,
		Stored = stored,
		LastCalc = last,
		BuildingTo = buildingTo,
		BuildEndsAt = buildEnds,
		Completed = completed,
	}
end

-- Применяет simulateFactory к данным (только на сервере). Возвращает (completed, gained)
function Formulas.settleFactory(data, now: number): (boolean, number)
	local before = data.Factory.Stored or 0
	local result = Formulas.simulateFactory(data, now)
	local f = data.Factory
	f.Level = result.Level
	f.Stored = result.Stored
	f.LastCalc = result.LastCalc
	f.BuildingTo = result.BuildingTo
	f.BuildEndsAt = result.BuildEndsAt
	return result.Completed, math.max(0, result.Stored - before)
end

----------------------------------------------------------------------
-- Ежедневная награда
----------------------------------------------------------------------
-- (доступна?, номер дня серии, сколько ждать)
function Formulas.dailyStatus(data, now: number): (boolean, number, number)
	local daily = data.Daily or {}
	local last = daily.LastClaim or 0
	local since = now - last
	if last > 0 and since < Config.Daily.MinInterval then
		local nextStreak = ((daily.Streak or 0) % #Config.Daily.Mults) + 1
		return false, nextStreak, Config.Daily.MinInterval - since
	end
	local streak = 1
	if last > 0 and since < Config.Daily.StreakWindow then
		streak = ((daily.Streak or 0) % #Config.Daily.Mults) + 1
	end
	return true, streak, 0
end

function Formulas.dailyReward(data, streak: number): number
	return math.floor(Formulas.rewardBase(data) * Config.Daily.Mults[streak])
end

function Formulas.giftReward(data, index: number): number
	local gift = Config.Gifts[index]
	return math.floor(Formulas.rewardBase(data) * gift.Mult)
end

----------------------------------------------------------------------
-- Шансы выпадения мусора
----------------------------------------------------------------------
-- Возвращает список { {Key, Weight} }, общий вес
function Formulas.trashWeights(zoneId: number, luck: number)
	local zone = Config.Zones[zoneId]
	local counts = Config.ZoneRarityCount[zoneId]
	local list = {}
	local total = 0
	for _, key in zone.Trash do
		local def = Config.Trash[key]
		local rarity = Config.Rarities[def.Rarity]
		local weight = rarity.Weight / counts[def.Rarity] * (math.max(1, luck) ^ rarity.LuckExp)
		total += weight
		table.insert(list, { Key = key, Weight = weight })
	end
	return list, total
end

----------------------------------------------------------------------
-- Итоговые характеристики игрока
----------------------------------------------------------------------
function Formulas.getStats(data, now: number, eventId: string?)
	local net = Config.Nets[data.Net] or Config.Nets[1]
	local backpack = Config.Backpacks[data.Backpack] or Config.Backpacks[1]
	local boots = Config.Boots[data.Boots] or Config.Boots[1]

	local range = net.Range
	local cooldown = net.Cooldown
	if Formulas.boostActive(data, "SuperNet", now) then
		range *= 1.5
		cooldown *= 0.6
	end

	local luck = Formulas.luck(data, now, eventId)
	local factoryRate = rateFor(data, data.Factory and data.Factory.Level or 0)
	if Formulas.boostActive(data, "FactoryTurbo", now) then
		factoryRate *= Config.BoostByKey.FactoryTurbo.FactoryMult or 3
	end

	return {
		Range = range,
		Cooldown = cooldown,
		Multi = net.Multi,
		Capacity = backpack.Capacity,
		WalkSpeed = boots.WalkSpeed,
		JumpHeight = boots.JumpHeight,
		CoinMult = Formulas.coinMultiplier(data, now, eventId),
		Luck = luck,
		ShinyChance = math.min(Config.Shiny.MaxChance, Config.Shiny.BaseChance * luck),
		HelperSlots = 1 + (perks(data).HelperSlots or 0),
		HelperSpeed = if Formulas.boostActive(data, "HelpersFast", now) then 2 else 1,
		FactoryRate = factoryRate,
		AutoCollectInterval = cooldown * Config.AutoCollect.CooldownMult,
	}
end

return Formulas
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">HelperModels</string>
          <string name="Source"><![CDATA[--[[
	HelperModels — модели помощников (утёнок, енот, робот, дрон, кит, НЛО...).
	Перед модели смотрит в -Z. Модель строится вокруг невидимой детали Root.
]]

local Util = require(script.Parent.Util)

local HelperModels = {}

local V = Vector3.new
local C = Color3.fromRGB
local CF = CFrame.new
local ANG = CFrame.Angles
local R = math.rad

local UP = ANG(0, 0, R(90))
local ALONG_Z = ANG(0, R(90), 0)

local function P(shape: string, size: Vector3, color: Color3, mat: string?, cf: CFrame?, extra: any?)
	return { shape = shape, size = size, color = color, mat = mat, cf = cf, extra = extra }
end

local BLACK = C(20, 20, 24)
local WHITE = C(250, 250, 250)

local B = {}

B.duck = function()
	local yellow = C(255, 220, 60)
	return {
		P("Ball", V(1.6, 1.3, 2.0), yellow),
		P("Ball", V(1.1, 1.1, 1.1), yellow, nil, CF(0, 0.85, -0.75)),
		P("Block", V(0.5, 0.22, 0.5), C(255, 140, 30), nil, CF(0, 0.75, -1.35)),
		P("Ball", V(0.2, 0.2, 0.2), BLACK, nil, CF(0.3, 1.0, -1.2)),
		P("Ball", V(0.2, 0.2, 0.2), BLACK, nil, CF(-0.3, 1.0, -1.2)),
		P("Ball", V(0.6, 0.5, 0.6), yellow, nil, CF(0, 0.35, 1.0)),
		P("Ball", V(0.4, 0.8, 1.2), C(240, 200, 40), nil, CF(0.78, 0.1, 0.1)),
		P("Ball", V(0.4, 0.8, 1.2), C(240, 200, 40), nil, CF(-0.78, 0.1, 0.1)),
	}
end

B.frog = function()
	local green = C(90, 200, 80)
	return {
		P("Ball", V(1.8, 1.1, 1.8), green),
		P("Ball", V(1.4, 0.8, 1.4), C(200, 240, 170), nil, CF(0, -0.15, -0.25)),
		P("Ball", V(0.6, 0.6, 0.6), WHITE, nil, CF(0.45, 0.6, -0.5)),
		P("Ball", V(0.6, 0.6, 0.6), WHITE, nil, CF(-0.45, 0.6, -0.5)),
		P("Ball", V(0.3, 0.3, 0.3), BLACK, nil, CF(0.45, 0.65, -0.75)),
		P("Ball", V(0.3, 0.3, 0.3), BLACK, nil, CF(-0.45, 0.65, -0.75)),
		P("Block", V(0.9, 0.06, 0.1), C(60, 120, 50), nil, CF(0, 0.05, -0.9)),
		P("Ball", V(0.6, 0.4, 0.9), green, nil, CF(0.8, -0.4, 0.3)),
		P("Ball", V(0.6, 0.4, 0.9), green, nil, CF(-0.8, -0.4, 0.3)),
	}
end

B.raccoon = function()
	local grey = C(130, 130, 135)
	return {
		P("Ball", V(1.5, 1.3, 1.9), grey),
		P("Ball", V(1.2, 1.2, 1.2), grey, nil, CF(0, 0.8, -0.8)),
		P("Block", V(1.0, 0.3, 0.2), C(30, 30, 30), nil, CF(0, 0.9, -1.33)),
		P("Ball", V(0.18, 0.18, 0.18), WHITE, nil, CF(0.25, 0.92, -1.44)),
		P("Ball", V(0.18, 0.18, 0.18), WHITE, nil, CF(-0.25, 0.92, -1.44)),
		P("Ball", V(0.4, 0.4, 0.4), C(230, 230, 230), nil, CF(0, 0.65, -1.38)),
		P("Ball", V(0.15, 0.15, 0.15), BLACK, nil, CF(0, 0.72, -1.56)),
		P("Block", V(0.3, 0.35, 0.15), C(90, 90, 95), nil, CF(0.4, 1.4, -0.75)),
		P("Block", V(0.3, 0.35, 0.15), C(90, 90, 95), nil, CF(-0.4, 1.4, -0.75)),
		P("Cylinder", V(1.2, 0.45, 0.45), grey, nil, CF(0, 0.2, 1.3) * ALONG_Z),
		P("Cylinder", V(0.25, 0.48, 0.48), C(30, 30, 30), nil, CF(0, 0.2, 1.15) * ALONG_Z),
		P("Cylinder", V(0.25, 0.48, 0.48), C(30, 30, 30), nil, CF(0, 0.2, 1.65) * ALONG_Z),
	}
end

B.beaver = function()
	local brown = C(140, 90, 50)
	return {
		P("Ball", V(1.6, 1.3, 2.0), brown),
		P("Ball", V(1.1, 1.1, 1.1), brown, nil, CF(0, 0.75, -0.85)),
		P("Block", V(0.3, 0.25, 0.06), WHITE, nil, CF(0, 0.45, -1.38)),
		P("Ball", V(0.2, 0.2, 0.2), BLACK, nil, CF(0, 0.75, -1.4)),
		P("Ball", V(0.16, 0.16, 0.16), BLACK, nil, CF(0.28, 0.95, -1.28)),
		P("Ball", V(0.16, 0.16, 0.16), BLACK, nil, CF(-0.28, 0.95, -1.28)),
		P("Block", V(0.9, 0.18, 1.3), C(70, 50, 40), nil, CF(0, -0.2, 1.5) * ANG(R(-15), 0, 0)),
		P("Ball", V(0.25, 0.25, 0.25), C(110, 70, 40), nil, CF(0.4, 1.25, -0.7)),
		P("Ball", V(0.25, 0.25, 0.25), C(110, 70, 40), nil, CF(-0.4, 1.25, -0.7)),
	}
end

B.robot = function()
	local steel = C(170, 180, 190)
	return {
		P("Block", V(1.4, 1.3, 1.1), steel, "Metal"),
		P("Block", V(1.1, 0.8, 0.9), C(190, 200, 210), "Metal", CF(0, 1.1, 0)),
		P("Block", V(0.9, 0.3, 0.05), C(80, 230, 255), "Neon", CF(0, 1.15, -0.46)),
		P("Cylinder", V(0.6, 0.08, 0.08), C(120, 120, 130), "Metal", CF(0, 1.75, 0) * UP),
		P("Ball", V(0.25, 0.25, 0.25), C(255, 60, 60), "Neon", CF(0, 2.1, 0)),
		P("Block", V(0.25, 0.9, 0.25), C(140, 150, 160), "Metal", CF(0.85, 0, 0)),
		P("Block", V(0.25, 0.9, 0.25), C(140, 150, 160), "Metal", CF(-0.85, 0, 0)),
		P("Cylinder", V(0.5, 0.6, 0.6), C(60, 62, 70), "Metal", CF(0, -0.85, 0) * UP),
		P("Cylinder", V(0.1, 0.45, 0.45), C(255, 150, 40), "Neon", CF(0, -1.12, 0) * UP),
		P("Ball", V(0.3, 0.3, 0.3), C(90, 255, 120), "Neon", CF(0, 0.2, -0.56)),
	}
end

B.drone = function()
	local dark = C(40, 42, 48)
	local parts = {
		P("Block", V(1.3, 0.45, 1.3), dark, "Metal"),
		P("Ball", V(0.8, 0.5, 0.8), C(120, 220, 255), "Glass", CF(0, 0.3, 0), { tr = 0.3 }),
		P("Block", V(2.6, 0.12, 0.18), dark, "Metal", ANG(0, R(45), 0)),
		P("Block", V(2.6, 0.12, 0.18), dark, "Metal", ANG(0, R(-45), 0)),
		P("Ball", V(0.25, 0.25, 0.25), C(255, 60, 60), "Neon", CF(0, -0.15, -0.66)),
		P("Block", V(0.15, 0.4, 0.15), C(120, 120, 130), "Metal", CF(0, -0.42, 0)),
	}
	for _, x in { -0.92, 0.92 } do
		for _, z in { -0.92, 0.92 } do
			table.insert(parts, P("Cylinder", V(0.2, 0.25, 0.25), dark, "Metal", CF(x, 0.12, z) * UP))
			local rotor = P("Cylinder", V(0.05, 1.0, 1.0), C(220, 225, 230), "SmoothPlastic", CF(x, 0.26, z) * UP, { tr = 0.45 })
			rotor.name = "Rotor"
			table.insert(parts, rotor)
		end
	end
	return parts
end

B.whale = function()
	local blue = C(70, 130, 210)
	return {
		P("Ball", V(2.8, 2.2, 4.2), blue),
		P("Ball", V(2.2, 1.6, 3.4), C(200, 225, 245), nil, CF(0, -0.45, -0.2)),
		P("Block", V(0.9, 0.2, 1.4), blue, nil, CF(0, 0.25, 2.3)),
		P("Block", V(1.2, 0.15, 0.7), blue, nil, CF(0.55, 0.3, 2.85) * ANG(0, R(-25), 0)),
		P("Block", V(1.2, 0.15, 0.7), blue, nil, CF(-0.55, 0.3, 2.85) * ANG(0, R(25), 0)),
		P("Block", V(1.2, 0.15, 0.6), blue, nil, CF(1.45, -0.3, -0.3) * ANG(0, 0, R(-25))),
		P("Block", V(1.2, 0.15, 0.6), blue, nil, CF(-1.45, -0.3, -0.3) * ANG(0, 0, R(25))),
		P("Ball", V(0.3, 0.3, 0.3), BLACK, nil, CF(1.05, 0.3, -1.4)),
		P("Ball", V(0.3, 0.3, 0.3), BLACK, nil, CF(-1.05, 0.3, -1.4)),
		P("Ball", V(0.4, 0.4, 0.4), C(120, 230, 255), "Neon", CF(0, 1.3, -0.8)),
	}
end

B.ufo = function()
	local parts = {
		P("Cylinder", V(0.5, 3.6, 3.6), C(170, 175, 185), "Metal", UP, { refl = 0.3 }),
		P("Cylinder", V(0.2, 3.9, 3.9), C(80, 240, 255), "Neon", CF(0, -0.05, 0) * UP),
		P("Ball", V(1.7, 1.4, 1.7), C(150, 230, 255), "Glass", CF(0, 0.5, 0), { tr = 0.35 }),
		P("Ball", V(0.6, 0.6, 0.6), C(120, 230, 90), nil, CF(0, 0.55, 0)),
		P("Ball", V(0.15, 0.15, 0.15), BLACK, nil, CF(0.12, 0.65, -0.26)),
		P("Ball", V(0.15, 0.15, 0.15), BLACK, nil, CF(-0.12, 0.65, -0.26)),
		P("Cylinder", V(0.15, 1.4, 1.4), C(255, 240, 120), "Neon", CF(0, -0.32, 0) * UP),
	}
	local colors = { C(255, 80, 80), C(255, 230, 80), C(80, 255, 140), C(80, 170, 255) }
	for i = 0, 7 do
		local a = R(i * 45)
		table.insert(
			parts,
			P("Ball", V(0.3, 0.3, 0.3), colors[i % 4 + 1], "Neon", CF(math.cos(a) * 1.6, 0.18, math.sin(a) * 1.6))
		)
	end
	return parts
end

-- Масштаб помощников (крупные — побольше)
local SCALE = {
	duck = 0.8,
	frog = 0.8,
	raccoon = 0.85,
	beaver = 0.85,
	robot = 0.85,
	drone = 1,
	whale = 1,
	ufo = 0.9,
}

function HelperModels.has(key: string): boolean
	return B[key] ~= nil
end

function HelperModels.build(key: string): Model
	local builder = B[key] or B.duck
	local specs = builder()
	local scale = SCALE[key] or 1

	local model = Instance.new("Model")
	model.Name = key

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = V(0.5, 0.5, 0.5)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.CastShadow = false
	root.CFrame = CFrame.identity
	root.Parent = model

	for index, spec in specs do
		local part = Instance.new("Part")
		part.Name = spec.name or ("P" .. index)
		Util.applyShape(part, spec.shape, spec.size * scale)
		part.Color = spec.color
		part.Material = Util.material(spec.mat)
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.CastShadow = false
		local cf = spec.cf or CFrame.identity
		part.CFrame = CFrame.new(cf.Position * scale) * cf.Rotation
		if spec.extra then
			part.Transparency = spec.extra.tr or 0
			part.Reflectance = spec.extra.refl or 0
		end
		part.Parent = model
	end

	model.PrimaryPart = root
	return model
end

return HelperModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--[[
	Remotes — все сетевые события игры. Сервер создаёт их, клиент ждёт.

	Request (RemoteFunction)  клиент → сервер: покупки, награды, настройки
	Collect (RemoteEvent)     клиент → сервер: «ловлю мусор с таким Id»
	State   (RemoteEvent)     сервер → клиент: свежие данные игрока
	Notify  (RemoteEvent)     сервер → клиент: всплывающее сообщение
	Effect  (Unreliable)      сервер → все:    эффекты вылова/продажи
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local DEFINITIONS = {
	{ Name = "Request", Class = "RemoteFunction" },
	{ Name = "Collect", Class = "RemoteEvent" },
	{ Name = "State", Class = "RemoteEvent" },
	{ Name = "Notify", Class = "RemoteEvent" },
	{ Name = "Effect", Class = "UnreliableRemoteEvent", Fallback = "RemoteEvent" },
}

local Remotes = {}

local folder: Folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Remotes") :: Folder
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, def in DEFINITIONS do
		if not folder:FindFirstChild(def.Name) then
			local ok, remote = pcall(Instance.new, def.Class)
			if not ok and def.Fallback then
				remote = Instance.new(def.Fallback)
			end
			remote.Name = def.Name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

function Remotes.get(name: string): any
	if RunService:IsServer() then
		return folder:FindFirstChild(name)
	end
	return folder:WaitForChild(name)
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">RiverMath</string>
          <string name="Source"><![CDATA[--[[
	RiverMath — геометрия мира и движение мусора по реке.

	Мусор двигается по формуле от времени (workspace:GetServerTimeNow()),
	поэтому сервер и все клиенты видят его в одном и том же месте,
	а сервер не тратит трафик на рассылку позиций каждый кадр.
]]

local Config = require(script.Parent.Config)

local W = Config.World
local RiverMath = {}

function RiverMath.zoneCount(): number
	return #Config.Zones
end

function RiverMath.zoneOriginZ(zoneId: number): number
	return (zoneId - 1) * W.ZoneSpacing
end

function RiverMath.riverZ(zoneId: number): number
	return RiverMath.zoneOriginZ(zoneId) + W.RiverOffsetZ
end

-- В какой зоне находится точка (по координате Z)
function RiverMath.zoneFromZ(z: number): number
	local index = math.floor((z + W.HalfDepth) / W.ZoneSpacing) + 1
	return math.clamp(index, 1, #Config.Zones)
end

-- Точка появления на базе зоны
function RiverMath.hubPosition(zoneId: number): Vector3
	return Vector3.new(0, 0, RiverMath.zoneOriginZ(zoneId) + W.HubZ - 10)
end

-- Центр площадки переработки
function RiverMath.sellPadPosition(zoneId: number): Vector3
	return Vector3.new(-26, 0, RiverMath.zoneOriginZ(zoneId) + W.HubZ)
end

-- Стоит ли точка над рекой (для «Водомерки»)
function RiverMath.isOverRiver(pos: Vector3, margin: number?): (boolean, number)
	local zoneId = RiverMath.zoneFromZ(pos.Z)
	local half = W.RiverWidth / 2 + (margin or 0)
	local over = math.abs(pos.Z - RiverMath.riverZ(zoneId)) <= half and math.abs(pos.X) <= W.HalfWidth
	return over, zoneId
end

----------------------------------------------------------------------
-- Движение мусора
----------------------------------------------------------------------
local function motion(origin: Vector3, vel: Vector3, t0: number, seed: number, t: number)
	local dt = math.max(0, t - t0)
	local x = origin.X + vel.X * dt
	local z = origin.Z + vel.Z * dt
	local moving = vel.X ~= 0 or vel.Z ~= 0
	if moving then
		-- плавное покачивание поперёк течения
		z += math.sin(t * 0.55 + seed) * 1.1
	end
	local bob = math.sin(t * 2.1 + seed * 1.7) * (if moving then 0.2 else 0.12)
	local y = W.WaterY + 0.1 + bob
	return x, y, z, dt, moving
end

function RiverMath.trashPosition(origin: Vector3, vel: Vector3, t0: number, seed: number, t: number): Vector3
	local x, y, z = motion(origin, vel, t0, seed, t)
	return Vector3.new(x, y, z)
end

function RiverMath.trashCFrame(origin: Vector3, vel: Vector3, t0: number, seed: number, t: number): CFrame
	local x, y, z, dt, moving = motion(origin, vel, t0, seed, t)
	local spin = if moving then 0.18 + (seed % 1) * 0.25 else 0.03
	local yaw = seed * 2.3 + dt * spin
	local pitch = math.cos(t * 1.1 + seed) * 0.12
	local roll = math.sin(t * 1.35 + seed * 0.7) * 0.14
	return CFrame.new(x, y, z) * CFrame.Angles(pitch, yaw, roll)
end

-- Сколько секунд мусор плывёт от начала до конца реки
function RiverMath.flowLifetime(speed: number): number
	return (W.RiverEndX - W.RiverStartX) / math.max(0.1, speed)
end

return RiverMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--[[
	Signal — простой сигнал без копирования таблиц (в отличие от BindableEvent).
]]

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn)
	local handlers = self._handlers
	local entry = { fn = fn, connected = true }
	table.insert(handlers, entry)
	return {
		Disconnect = function()
			entry.connected = false
			local index = table.find(handlers, entry)
			if index then
				table.remove(handlers, index)
			end
		end,
	}
end

function Signal:Fire(...)
	-- копия списка, чтобы обработчики могли отключаться во время вызова
	local list = table.clone(self._handlers)
	for _, entry in list do
		if entry.connected then
			task.spawn(entry.fn, ...)
		end
	end
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">TrashModels</string>
          <string name="Source"><![CDATA[--[[
	TrashModels — 3D-модели мусора, собранные из простых деталей.
	Никаких внешних ассетов: всё работает сразу после открытия места.

	TrashModels.build(key)     -> Model (PrimaryPart = невидимый Hitbox для кликов)
	TrashModels.decorate(model, key) -> подсветка и подпись для редких предметов

	Подсказка: у цилиндра в Roblox ось идёт вдоль X.
]]

local Config = require(script.Parent.Config)
local Util = require(script.Parent.Util)

local TrashModels = {}

local V = Vector3.new
local C = Color3.fromRGB
local CF = CFrame.new
local ANG = CFrame.Angles
local R = math.rad

local UP = ANG(0, 0, R(90)) -- ось цилиндра вертикально
local ALONG_Z = ANG(0, R(90), 0) -- ось цилиндра вдоль Z

type Spec = {
	shape: string,
	size: Vector3,
	color: Color3,
	mat: string?,
	cf: CFrame?,
	extra: { tr: number?, refl: number? }?,
}

-- Поворот, при котором ось X детали (ось цилиндра) смотрит вдоль dir.
-- CFrame.lookAt тут не годится: при направлении строго вверх он вырождается.
local function alongAxis(pos: Vector3, dir: Vector3): CFrame
	local d = dir.Unit
	local dot = Vector3.xAxis:Dot(d)
	if dot > 0.9999 then
		return CF(pos)
	elseif dot < -0.9999 then
		return CF(pos) * ANG(0, math.pi, 0)
	end
	return CF(pos) * CFrame.fromAxisAngle(Vector3.xAxis:Cross(d).Unit, math.acos(dot))
end

local function P(shape: string, size: Vector3, color: Color3, mat: string?, cf: CFrame?, extra: any?): Spec
	return { shape = shape, size = size, color = color, mat = mat, cf = cf, extra = extra }
end

local B: { [string]: () -> ({ Spec }, Vector3) } = {}

----------------------------------------------------------------------
-- Зона 1: Тихий ручей
----------------------------------------------------------------------
B.paper = function()
	return {
		P("Ball", V(1.3, 1.1, 1.2), C(236, 232, 220), "Fabric"),
		P("Ball", V(0.9, 0.8, 0.9), C(222, 216, 200), "Fabric", CF(0.45, 0.15, 0.2)),
		P("Ball", V(0.7, 0.6, 0.7), C(242, 240, 232), "Fabric", CF(-0.35, 0.2, -0.3)),
	}, V(2.6, 2, 2.6)
end

local function bottle(body: Color3, label: Color3, cap: Color3, tr: number, glow: Color3?)
	local parts = {
		P("Cylinder", V(2.2, 1, 1), body, "Glass", nil, { tr = tr }),
		P("Cylinder", V(0.9, 1.04, 1.04), label, "SmoothPlastic", CF(-0.2, 0, 0)),
		P("Cylinder", V(0.55, 0.55, 0.55), body, "Glass", CF(1.35, 0, 0), { tr = tr }),
		P("Cylinder", V(0.25, 0.62, 0.62), cap, "SmoothPlastic", CF(1.72, 0, 0)),
	}
	if glow then
		table.insert(parts, P("Cylinder", V(1.8, 0.7, 0.7), glow, "Neon", CF(0.1, 0, 0)))
	end
	return parts, V(3.6, 2, 2.4)
end

B.bottle = function()
	return bottle(C(140, 205, 235), C(60, 165, 95), C(220, 50, 50), 0.35)
end

B.goldbottle = function()
	return bottle(C(255, 205, 60), C(255, 245, 200), C(255, 255, 255), 0.25, C(255, 215, 90))
end

B.can = function()
	return {
		P("Cylinder", V(1.5, 1, 1), C(210, 40, 45), "Metal"),
		P("Cylinder", V(0.6, 1.02, 1.02), C(245, 245, 245), "SmoothPlastic"),
		P("Cylinder", V(0.1, 1.04, 1.04), C(200, 200, 205), "Metal", CF(0.72, 0, 0)),
		P("Cylinder", V(0.1, 1.04, 1.04), C(200, 200, 205), "Metal", CF(-0.72, 0, 0)),
	}, V(2.6, 2, 2.6)
end

B.bag = function()
	return {
		P("Ball", V(2.2, 0.7, 1.7), C(245, 245, 240), "SmoothPlastic", nil, { tr = 0.15 }),
		P("Ball", V(1.3, 0.55, 1.1), C(235, 235, 230), "SmoothPlastic", CF(0.9, 0.15, 0.1), { tr = 0.15 }),
		P("Block", V(0.15, 0.15, 0.9), C(230, 60, 60), "SmoothPlastic", CF(1.55, 0.2, 0)),
	}, V(3.2, 1.8, 2.6)
end

B.boot = function()
	local leather = C(115, 72, 40)
	return {
		P("Block", V(1.1, 0.3, 2.5), C(40, 32, 28), "Rubber", CF(0, -0.45, 0)),
		P("Block", V(1.0, 0.7, 1.9), leather, "Fabric", CF(0, 0, 0.2)),
		P("Ball", V(1.0, 0.75, 1.0), leather, "Fabric", CF(0, -0.05, -0.85)),
		P("Block", V(1.0, 1.4, 0.9), C(105, 66, 38), "Fabric", CF(0, 0.6, 0.75)),
		P("Block", V(0.9, 0.08, 0.6), C(230, 230, 220), "Fabric", CF(0, 0.38, -0.2)),
	}, V(2.6, 2.8, 3.2)
end

B.rod = function()
	return {
		P("Cylinder", V(5.5, 0.25, 0.25), C(70, 45, 25), "Wood"),
		P("Cylinder", V(2.2, 0.12, 0.12), C(225, 225, 225), "SmoothPlastic", CF(3.8, 0, 0)),
		P("Cylinder", V(0.4, 0.8, 0.8), C(90, 90, 100), "Metal", CF(-1.6, -0.1, 0.45) * ALONG_Z),
		P("Ball", V(0.55, 0.55, 0.55), C(230, 40, 40), "SmoothPlastic", CF(4.4, 0.05, 0.9)),
		P("Ball", V(0.35, 0.35, 0.35), C(245, 245, 245), "SmoothPlastic", CF(4.4, 0.35, 0.9)),
	}, V(8, 2, 2.8)
end

----------------------------------------------------------------------
-- Зона 2: Городской канал
----------------------------------------------------------------------
B.cup = function()
	return {
		P("Cylinder", V(1.6, 1, 1), C(250, 250, 245), "SmoothPlastic"),
		P("Cylinder", V(0.7, 1.07, 1.07), C(150, 100, 60), "Cardboard", CF(-0.1, 0, 0)),
		P("Cylinder", V(0.18, 1.12, 1.12), C(60, 40, 30), "SmoothPlastic", CF(0.84, 0, 0)),
	}, V(2.6, 2, 2.6)
end

B.pizzabox = function()
	return {
		P("Block", V(3, 0.35, 3), C(205, 165, 115), "Cardboard"),
		P("Block", V(3, 0.1, 3), C(195, 155, 105), "Cardboard", CF(0, 0.3, 0.35) * ANG(R(-12), 0, 0)),
		P("Ball", V(0.9, 0.05, 0.7), C(160, 110, 55), "SmoothPlastic", CF(0.5, 0.45, 0.2)),
		P("Block", V(1.4, 0.03, 0.5), C(220, 50, 40), "SmoothPlastic", CF(-0.5, 0.42, -0.6)),
	}, V(3.6, 1.6, 3.6)
end

B.ball = function()
	return {
		P("Ball", V(1.9, 1.9, 1.9), C(255, 120, 40), "SmoothPlastic"),
