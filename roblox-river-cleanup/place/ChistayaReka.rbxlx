Config.RarityOrder = { "Common", "Uncommon", "Rare", "Epic", "Legendary" }

-- «Сияющий» мусор: случайный шанс при вылове, стоит в несколько раз дороже
Config.Shiny = {
	BaseChance = 0.03,
	MaxChance = 0.45,
	ValueMult = 5,
}

