		P("Block", V(2.0, 2.0, 0.1), C(78, 84, 94), "Metal", CF(0, 0, -1.22)),
		P("Cylinder", V(0.2, 0.8, 0.8), steel, "Metal", CF(-0.3, 0.2, -1.3) * ALONG_Z, { refl = 0.3 }),
		P("Block", V(0.15, 0.8, 0.15), steel, "Metal", CF(0.65, 0, -1.33)),
		P("Cylinder", V(1.8, 0.12, 0.12), C(60, 140, 60), "Grass", CF(0.9, 0.9, 1.0) * ANG(0, 0, R(70))),
		P("Cylinder", V(1.4, 0.12, 0.12), C(70, 150, 70), "Grass", CF(-0.8, 0.8, 1.1) * ANG(0, 0, R(110))),
	}, V(3.2, 3.2, 3.2)
end

B.crown = function()
	local gold = C(255, 200, 50)
	local parts = {
		P("Cylinder", V(0.9, 2.4, 2.4), gold, "Foil", UP, { refl = 0.25 }),
		P("Cylinder", V(0.06, 2.1, 2.1), C(150, 20, 45), "Fabric", CF(0, 0.47, 0) * UP),
	}
	local gems = { C(80, 170, 255), C(255, 70, 90), C(90, 255, 140) }
	for i = 0, 5 do
		local a = R(i * 60)
		local x, z = math.cos(a) * 1.1, math.sin(a) * 1.1
		table.insert(
			parts,
			P("Block", V(0.35, 0.9, 0.18), gold, "Foil", CF(x, 0.8, z) * ANG(0, R(90) - a, 0), { refl = 0.25 })
		)
		table.insert(
			parts,
			P("Ball", V(0.32, 0.32, 0.32), gems[i % 3 + 1], "Neon", CF(math.cos(a) * 1.22, 0, math.sin(a) * 1.22))
		)
	end
	return parts, V(3.2, 2.8, 3.2)
end

----------------------------------------------------------------------
-- Сборка
----------------------------------------------------------------------
local function makePart(spec: Spec, index: number): Part
	local part = Instance.new("Part")
	part.Name = "P" .. index
	Util.applyShape(part, spec.shape, spec.size)
	part.Color = spec.color
	part.Material = Util.material(spec.mat)
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.CFrame = spec.cf or CFrame.identity
	if spec.extra then
		part.Transparency = spec.extra.tr or 0
		part.Reflectance = spec.extra.refl or 0
	end
	return part
end

function TrashModels.has(key: string): boolean
	return B[key] ~= nil
end

function TrashModels.keys(): { string }
	local list = {}
	for key in B do
		table.insert(list, key)
	end
	table.sort(list)
	return list
end

-- Собирает модель предмета в точке (0, 0, 0)
function TrashModels.build(key: string): Model
	local builder = B[key] or B.paper
	local specs, hitboxSize = builder()

	local model = Instance.new("Model")
	model.Name = key

	local hitbox = Instance.new("Part")
	hitbox.Name = "Hitbox"
	hitbox.Size = hitboxSize
	hitbox.Transparency = 1
	hitbox.Anchored = true
	hitbox.CanCollide = false
	hitbox.CanTouch = false
	hitbox.CanQuery = true
	hitbox.CastShadow = false
	hitbox.CFrame = CFrame.identity
	hitbox.Parent = model

	for index, spec in specs do
		makePart(spec, index).Parent = model
	end

	model.PrimaryPart = hitbox
	return model
end

-- Подпись, свечение и искры для редкого мусора (вызывает сервер)
function TrashModels.decorate(model: Model, key: string)
	local def = Config.Trash[key]
	if not def then
		return
	end
	local rarity = Config.Rarities[def.Rarity]
	local hitbox = model.PrimaryPart
	if not hitbox then
		return
	end

	if rarity.Order >= 3 then
		local gui = Instance.new("BillboardGui")
		gui.Name = "Tag"
		gui.Size = UDim2.fromOffset(190, 30)
		gui.StudsOffset = Vector3.new(0, 2.8, 0)
		gui.MaxDistance = 110
		gui.AlwaysOnTop = false
		gui.LightInfluence = 0
		gui.ResetOnSpawn = false
		gui.Adornee = hitbox

		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = rarity.Color
		label.Text = if rarity.Order >= 5 then "★ " .. def.Name .. " ★" else def.Name
		label.Parent = gui

		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Color = Color3.fromRGB(15, 20, 30)
		stroke.Parent = label

		gui.Parent = hitbox
	end

	if rarity.Order >= 4 then
		local light = Instance.new("PointLight")
		light.Color = rarity.Color
		light.Range = if rarity.Order >= 5 then 14 else 9
		light.Brightness = if rarity.Order >= 5 then 2.2 else 1.4
		light.Shadows = false
		light.Parent = hitbox

		local sparkles = Instance.new("ParticleEmitter")
		sparkles.Name = "Sparkles"
		sparkles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		sparkles.Rate = if rarity.Order >= 5 then 14 else 6
		sparkles.Lifetime = NumberRange.new(0.6, 1.2)
		sparkles.Speed = NumberRange.new(1, 2.5)
		sparkles.SpreadAngle = Vector2.new(180, 180)
		sparkles.LightEmission = 1
		sparkles.Color = ColorSequence.new(rarity.Color)
		sparkles.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.45),
			NumberSequenceKeypoint.new(1, 0),
		})
		sparkles.Parent = hitbox
	end
end

return TrashModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--[[
	Util — мелкие помощники для создания объектов.
]]

local Util = {}

-- Безопасно достаёт материал по имени (новые материалы есть не во всех версиях)
local materialCache = {}
function Util.material(name: string?): Enum.Material
	if not name then
		return Enum.Material.SmoothPlastic
	end
	local cached = materialCache[name]
	if cached then
		return cached
	end
	local ok, value = pcall(function()
		return (Enum.Material :: any)[name]
	end)
	local result = if ok and value then value else Enum.Material.SmoothPlastic
	materialCache[name] = result
	return result
end

-- create("Part", {Size = ..., Parent = ...}) — Parent ставится последним
function Util.create(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

-- Простая неподвижная деталь для карты.
-- Shape можно передать строкой ("Ball", "Cylinder"), Material — тоже строкой.
function Util.part(props: { [string]: any }): Part
	local defaults = {
		Anchored = true,
		TopSurface = Enum.SurfaceType.Smooth,
		BottomSurface = Enum.SurfaceType.Smooth,
	}
	local shape = nil
	local parent = nil
	for key, value in props do
		if key == "Shape" and type(value) == "string" then
			shape = value
		elseif key == "Parent" then
			parent = value
		else
			defaults[key] = value
		end
	end
	if typeof(defaults.Material) == "string" then
		defaults.Material = Util.material(defaults.Material)
	end
	local cframe = defaults.CFrame
	defaults.CFrame = nil
	local part = Util.create("Part", defaults)
	if shape then
		Util.applyShape(part, shape, part.Size)
	end
	if cframe then
		part.CFrame = cframe
	end
	if parent then
		part.Parent = parent
	end
	return part
end

function Util.wedge(props: { [string]: any }): WedgePart
	local defaults = {
		Anchored = true,
		TopSurface = Enum.SurfaceType.Smooth,
		BottomSurface = Enum.SurfaceType.Smooth,
	}
	for key, value in props do
		defaults[key] = value
	end
	if typeof(defaults.Material) == "string" then
		defaults.Material = Util.material(defaults.Material)
	end
	return Util.create("WedgePart", defaults)
end

--[[
	Деталь формы Ball в Roblox всегда идеальный шар (берётся меньшая сторона).
	Для сплюснутых шаров (эллипсоидов) делаем блок + SpecialMesh «Sphere».
	shape: "Ball" | "Block" | "Cylinder" | "Wedge"
]]
function Util.applyShape(part: BasePart, shape: string, size: Vector3)
	local uniform = math.abs(size.X - size.Y) < 1e-3 and math.abs(size.Y - size.Z) < 1e-3
	if shape == "Ball" and not uniform then
		(part :: Part).Shape = Enum.PartType.Block
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = part
	elseif part:IsA("Part") then
		part.Shape = (Enum.PartType :: any)[shape]
	end
	part.Size = size
end

function Util.lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

function Util.flatDistance(a: Vector3, b: Vector3): number
	local dx = a.X - b.X
	local dz = a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

function Util.deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in value do
		out[k] = Util.deepCopy(v)
	end
	return out
end

-- Дополняет target недостающими полями из template (рекурсивно)
function Util.reconcile(target: { [any]: any }, template: { [any]: any })
	for key, value in template do
		if target[key] == nil then
			target[key] = Util.deepCopy(value)
		elseif type(value) == "table" and type(target[key]) == "table" and next(value) ~= nil then
			-- массивы-шаблоны (например, Quests = {}) пустые, поэтому не трогаем
			Util.reconcile(target[key], value)
		end
	end
	return target
end

function Util.countKeys(t: { [any]: any }?): number
	local n = 0
	if t then
		for _ in t do
			n += 1
		end
	end
	return n
end

return Util
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="14">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Чистая Река — точка входа сервера.

	Все системы лежат в папке Services. Сначала у каждой вызывается Init
	(подготовка, постройка карты), потом Start (циклы, подписки на события).
]]

local Players = game:GetService("Players")

-- Персонажей загружаем сами, когда карта построена и данные игрока загружены
Players.CharacterAutoLoads = false

local ORDER = {
	"DataService",
	"NetService",
	"WorldService",
	"EventService",
	"ZoneService",
	"PlayerService",
	"QuestService",
	"TrashService",
	"HelperService",
	"ShopService",
	"FactoryService",
	"BoostService",
	"RewardService",
	"RebirthService",
	"LeaderboardService",
}

local servicesFolder = script:WaitForChild("Services")
local Services = {}

for _, name in ORDER do
	Services[name] = require(servicesFolder:WaitForChild(name))
end

for _, name in ORDER do
	local service = Services[name]
	if service.Init then
		local ok, err = pcall(service.Init, service, Services)
		if not ok then
			warn(string.format("[Чистая Река] Ошибка в %s:Init — %s", name, tostring(err)))
		end
	end
end

for _, name in ORDER do
	local service = Services[name]
	if service.Start then
		task.spawn(function()
			local ok, err = pcall(service.Start, service)
			if not ok then
				warn(string.format("[Чистая Река] Ошибка в %s:Start — %s", name, tostring(err)))
			end
		end)
	end
end

print("[Чистая Река] Сервер запущен ✔")
]]></string>
      </Properties>
      <Item class="Folder" referent="15">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">BoostService</string>
            <string name="Source"><![CDATA[--[[
	BoostService — бесплатные бусты. Включил — работает N минут,
	потом перезарядка. Купить нельзя — только подождать ⏳
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)

local BoostService = {}

local Services
local announced: { [Player]: { [string]: string } } = {}

-- Включить буст бесплатно, не трогая перезарядку (подарки, ежедневка)
function BoostService.grant(data, key: string)
	local def = Config.BoostByKey[key]
	if not def then
		return
	end
	local now = os.time()
	if key == "FactoryTurbo" then
		Formulas.settleFactory(data, now)
	end
	local record = data.Boosts[key] or {}
	if (record.EndsAt or 0) > now then
		record.EndsAt += def.Duration
	else
		record.StartAt = now
		record.EndsAt = now + def.Duration
	end
	record.ReadyAt = math.max(record.ReadyAt or 0, 0)
	data.Boosts[key] = record
end

function BoostService.resetCooldowns(data)
	for _, record in data.Boosts do
		record.ReadyAt = 0
	end
end

function BoostService:Init(services)
	Services = services
end

function BoostService:Start()
	local Net = Services.NetService

	Net.on("ActivateBoost", function(player, data, key)
		local def = type(key) == "string" and Config.BoostByKey[key]
		if not def then
			return false
		end
		local now = os.time()
		local state, left = Formulas.boostState(data, key, now)
		if state == "active" then
			return false, "Уже работает! Осталось " .. Format.time(left)
		elseif state == "cooldown" then
			return false, "Перезарядка: " .. Format.duration(left) .. " ⏳ Просто подожди!"
		end
		if key == "FactoryTurbo" then
			Formulas.settleFactory(data, now)
		end
		data.Boosts[key] = { StartAt = now, EndsAt = now + def.Duration, ReadyAt = now + def.Cooldown }
		Services.PlayerService.applyStats(player)
		return true, string.format("%s %s включён на %s!", def.Icon, def.Name, Format.duration(def.Duration))
	end)

	Players.PlayerRemoving:Connect(function(player)
		announced[player] = nil
	end)

	-- сообщаем, когда буст закончился и когда он снова готов
	while true do
		task.wait(1)
		local now = os.time()
		for _, player in Players:GetPlayers() do
			local data = Services.DataService.get(player)
			if data then
				local mine = announced[player]
				if not mine then
					mine = {}
					announced[player] = mine
					for key in data.Boosts do
						mine[key] = (Formulas.boostState(data, key, now))
					end
				end
				for _, def in Config.Boosts do
					local state = Formulas.boostState(data, def.Key, now)
					local previous = mine[def.Key]
					if previous and previous ~= state then
						if previous == "active" then
							Net.notify(player, def.Icon .. " «" .. def.Name .. "» закончился", "info")
							Net.markDirty(player)
							Services.PlayerService.applyStats(player)
						end
						if state == "ready" then
							Net.notify(player, "⚡ Бесплатный буст «" .. def.Name .. "» снова готов!", "success")
							Net.markDirty(player)
						end
					end
					mine[def.Key] = state
				end
			end
		end
	end
end

return BoostService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--[[
	DataService — загрузка и сохранение прогресса игроков (DataStoreService).

	• Защита от одновременной игры на двух серверах (блокировка сессии).
	• Повторные попытки при ошибках, автосохранение, сохранение при выходе
	  и при выключении сервера.
	• В Studio без доступа к API игра работает, но прогресс не сохраняется.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Signal = require(Shared.Signal)
local Util = require(Shared.Util)

local DataService = {}
DataService.Loaded = Signal.new() -- (player, data, info)

local LOCK_FRESH = 300 -- блокировка считается живой 5 минут
local profiles: { [Player]: any } = {}
local beforeSave: { (Player, any) -> () } = {}
local store: DataStore? = nil
local storeError: string? = nil

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

function DataService.template()
	local now = os.time()
	return {
		Version = 1,
		Coins = 0,
		TotalCoins = 0,
		Net = 1,
		Backpack = 1,
		Boots = 1,
		MaxZone = 1,
		LastZone = 1,
		Inventory = {},
		InvSize = 0,
		InvValue = 0,
		Perks = {},
		HelpersOwned = {},
		Equipped = {},
		Factory = { Level = 0, Stored = 0, LastCalc = now, BuildingTo = 0, BuildEndsAt = 0 },
		Rebirths = 0,
		Discovered = {},
		Boosts = {},
		Daily = { Streak = 0, LastClaim = 0 },
		Quests = {},
		QuestsDone = 0,
		QuestRerollAt = 0,
		Settings = {
			AutoCollect = true,
			AutoSell = true,
			WaterWalk = true,
			ShowRange = true,
			Sounds = true,
			Music = true,
			Effects = true,
		},
		Stats = {
			TrashCollected = 0,
			Legendary = 0,
			Shiny = 0,
			Sells = 0,
			HelperCollected = 0,
			PlayTime = 0,
			BestSell = 0,
		},
		Tutorial = { Collected = false, Sold = false, Bought = false },
		FirstJoin = now,
		LastOnline = now,
	}
end

-- Чиним данные: значения в допустимых границах, мусорные ключи удаляем
function DataService.sanitize(data)
	data.Net = math.clamp(math.floor(tonumber(data.Net) or 1), 1, #Config.Nets)
	data.Backpack = math.clamp(math.floor(tonumber(data.Backpack) or 1), 1, #Config.Backpacks)
	data.Boots = math.clamp(math.floor(tonumber(data.Boots) or 1), 1, #Config.Boots)
	data.MaxZone = math.clamp(math.floor(tonumber(data.MaxZone) or 1), 1, #Config.Zones)
	data.LastZone = math.clamp(math.floor(tonumber(data.LastZone) or 1), 1, data.MaxZone)
	data.Coins = math.max(0, tonumber(data.Coins) or 0)
	data.Rebirths = math.max(0, math.floor(tonumber(data.Rebirths) or 0))

	for key, level in data.Perks do
		local def = Config.Perks[key]
		if not def then
			data.Perks[key] = nil
		else
			data.Perks[key] = math.clamp(math.floor(tonumber(level) or 0), 0, def.MaxLevel)
		end
	end

	for key in data.HelpersOwned do
		if not Config.HelperByKey[key] then
			data.HelpersOwned[key] = nil
		end
	end
	local equipped = {}
	local slots = 1 + (data.Perks.HelperSlots or 0)
	for _, key in data.Equipped do
		if data.HelpersOwned[key] and not table.find(equipped, key) and #equipped < slots then
			table.insert(equipped, key)
		end
	end
	data.Equipped = equipped

	-- инвентарь: пересчитываем занятое место
	local size = 0
	for key, count in data.Inventory do
		local def = Config.Trash[key]
		if not def or type(count) ~= "number" or count <= 0 then
			data.Inventory[key] = nil
		else
			size += def.Size * count
		end
	end
	data.InvSize = size
	if size == 0 then
		data.InvValue = 0
	end

	for key in data.Boosts do
		if not Config.BoostByKey[key] then
			data.Boosts[key] = nil
		end
	end

	local f = data.Factory
	f.Level = math.clamp(math.floor(tonumber(f.Level) or 0), 0, Config.Factory.MaxLevel)
	f.BuildingTo = math.clamp(math.floor(tonumber(f.BuildingTo) or 0), 0, Config.Factory.MaxLevel)
	if f.BuildingTo ~= 0 and f.BuildingTo ~= f.Level + 1 then
		f.BuildingTo = 0
		f.BuildEndsAt = 0
	end
	f.Stored = math.max(0, tonumber(f.Stored) or 0)
	f.LastCalc = math.min(tonumber(f.LastCalc) or os.time(), os.time())

	for key, value in data.Settings do
		if Config.SettingKeys[key] == nil or type(value) ~= "boolean" then
			data.Settings[key] = nil
		end
	end
	Util.reconcile(data.Settings, DataService.template().Settings)
end

----------------------------------------------------------------------
-- Хранилище
----------------------------------------------------------------------
local function openStore()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		storeError = tostring(result)
		warn("[Данные] Не удалось открыть DataStore:", storeError)
	end
end

local function loadRaw(player: Player): (boolean, any, string?)
	if not store then
		return false, nil, storeError or "DataStore недоступен"
	end
	local key = keyFor(player)
	local lastError = "неизвестная ошибка"
	for attempt = 1, 6 do
		local lockedByOther = false
		local ok, result = pcall(function()
			return (store :: DataStore):UpdateAsync(key, function(old)
				local now = os.time()
				if type(old) == "table" and type(old.Lock) == "table" then
					local lock = old.Lock
					local fresh = now - (tonumber(lock.Time) or 0) < LOCK_FRESH
					-- другой сервер держит сохранение: ждём, на последних попытках забираем
					if lock.JobId ~= game.JobId and fresh and attempt < 5 then
						lockedByOther = true
						return nil
					end
				end
				local wrapper = if type(old) == "table" then old else {}
				wrapper.Lock = { JobId = game.JobId, Time = now }
				return wrapper
			end)
		end)
		if ok and not lockedByOther then
			local data = if type(result) == "table" then result.Data else nil
			return true, data, nil
		end
		if not ok then
			lastError = tostring(result)
			if RunService:IsStudio() then
				break
			end
			task.wait(1.5 * attempt)
		else
			lastError = "сохранение занято другим сервером"
			task.wait(4)
		end
		if not player.Parent then
			break
		end
	end
	return false, nil, lastError
end

function DataService.save(player: Player, release: boolean?): boolean
	local profile = profiles[player]
	if not profile or not profile.CanSave or not store then
		return false
	end
	for _, hook in beforeSave do
		local ok, err = pcall(hook, player, profile.Data)
		if not ok then
			warn("[Данные] Ошибка перед сохранением:", err)
		end
	end
	local data = profile.Data
	data.LastOnline = os.time()

	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(profile.Key, function(old)
			if type(old) == "table" and type(old.Lock) == "table" then
				local lock = old.Lock
				local fresh = os.time() - (tonumber(lock.Time) or 0) < LOCK_FRESH
				if lock.JobId ~= game.JobId and fresh then
					-- сохранение забрал другой сервер — не затираем его данные
					return nil
				end
			end
			return {
				Data = data,
				Lock = if release then nil else { JobId = game.JobId, Time = os.time() },
				SavedAt = os.time(),
			}
		end)
	end)
	if not ok then
		warn("[Данные] Ошибка сохранения для " .. player.Name .. ":", err)
	end
	profile.LastSave = os.clock()
	return ok
end

----------------------------------------------------------------------
-- Публичное API
----------------------------------------------------------------------
function DataService.get(player: Player)
	local profile = profiles[player]
	return profile and profile.Data or nil
end

function DataService.canSave(player: Player): boolean
	local profile = profiles[player]
	return profile ~= nil and profile.CanSave
end

function DataService.isNew(player: Player): boolean
	local profile = profiles[player]
	return profile ~= nil and profile.IsNew
end

function DataService.addBeforeSave(fn: (Player, any) -> ())
	table.insert(beforeSave, fn)
end

function DataService.players(): { Player }
	local list = {}
	for player in profiles do
		if player.Parent then
			table.insert(list, player)
		end
	end
	return list
end

local function onPlayerAdded(player: Player)
	local ok, raw, err = loadRaw(player)
	if not player.Parent then
		return
	end

	local canSave = ok
	if not ok then
		if RunService:IsStudio() then
			warn(
				"[Данные] Сохранения не работают в Studio. Чтобы включить: Home → Game Settings → Security → "
					.. "Enable Studio Access to API Services (нужно сначала опубликовать игру). Ошибка: "
					.. tostring(err)
			)
		else
			player:Kick("Не удалось загрузить сохранение 😢 Перезайди через минуту. (" .. tostring(err) .. ")")
			return
		end
	end

	local isNew = raw == nil
	local data = if type(raw) == "table" then raw else DataService.template()
	Util.reconcile(data, DataService.template())
	DataService.sanitize(data)

	profiles[player] = {
		Data = data,
		CanSave = canSave,
		Key = keyFor(player),
		IsNew = isNew,
		LastSave = os.clock(),
	}

	DataService.Loaded:Fire(player, data, { IsNew = isNew, CanSave = canSave })
end

local function onPlayerRemoving(player: Player)
	if profiles[player] then
		DataService.save(player, true)
		profiles[player] = nil
	end
end

function DataService:Init()
	openStore()
end

function DataService:Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.save(player, true)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)

	-- автосохранение
	while true do
		task.wait(Config.AutoSaveInterval)
		for player, profile in profiles do
			if player.Parent and profile.CanSave then
				task.spawn(DataService.save, player, false)
				task.wait(0.5)
			end
		end
	end
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[--[[
	EventService — глобальные события сервера: «Мусорный шторм», «Золотой час»,
	«Звездопад удачи». Запускаются сами по таймеру, для всех бесплатно.

	Клиенты узнают о событии через атрибуты ReplicatedStorage: EventId, EventEndsAt.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local EventService = {}

local Services
local current: { Key: string, EndsAt: number }? = nil
local rng = Random.new()

function EventService.current(): string?
	if current and os.time() < current.EndsAt then
		return current.Key
	end
	return nil
end

function EventService.def()
	local key = EventService.current()
	return key and Config.EventByKey[key] or nil
end

function EventService.start(key: string)
	local def = Config.EventByKey[key]
	if not def then
		return
	end
	current = { Key = key, EndsAt = os.time() + def.Duration }
	ReplicatedStorage:SetAttribute("EventId", key)
	ReplicatedStorage:SetAttribute("EventEndsAt", current.EndsAt)
	Services.NetService.notifyAll(string.format("%s %s! %s", def.Icon, def.Name, def.Desc), "event")
	for _, player in Services.DataService.players() do
		Services.NetService.markDirty(player)
	end
end

function EventService.stop()
	if current then
		local def = Config.EventByKey[current.Key]
		current = nil
		ReplicatedStorage:SetAttribute("EventId", "")
		ReplicatedStorage:SetAttribute("EventEndsAt", 0)
		if def then
			Services.NetService.notifyAll(def.Icon .. " Событие «" .. def.Name .. "» закончилось. Следующее — скоро!", "info")
		end
	end
end

function EventService:Init(services)
	Services = services
	ReplicatedStorage:SetAttribute("EventId", "")
	ReplicatedStorage:SetAttribute("EventEndsAt", 0)
	ReplicatedStorage:SetAttribute("NextEventAt", os.time() + Config.Events.FirstDelay)
end

function EventService:Start()
	task.wait(Config.Events.FirstDelay)
	local list = Config.Events.List
	local last = nil
	while true do
		local def
		repeat
			def = list[rng:NextInteger(1, #list)]
		until def.Key ~= last or #list == 1
		last = def.Key
		EventService.start(def.Key)
		task.wait(def.Duration)
		EventService.stop()
		local pause = rng:NextInteger(Config.Events.Interval[1], Config.Events.Interval[2])
		ReplicatedStorage:SetAttribute("NextEventAt", os.time() + pause)
		task.wait(pause)
	end
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">FactoryService</string>
            <string name="Source"><![CDATA[--[[
	FactoryService — фабрика переработки: пассивный доход.
	Копит монеты даже когда игрока нет в игре (до заполнения склада).
	Улучшение строится по времени — ускорить нельзя, только подождать ⏳
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)

local FactoryService = {}

local Services

function FactoryService.settle(player: Player, data)
	local completed = Formulas.settleFactory(data, os.time())
	if completed then
		Services.NetService.notify(player, "🏭 Стройка завершена! Фабрика теперь " .. data.Factory.Level .. " уровня", "success")
		Services.NetService.markDirty(player)
	end
end

function FactoryService:Init(services)
	Services = services

	Services.DataService.Loaded:Connect(function(player, data)
		local before = data.Factory.Stored
		local completed = Formulas.settleFactory(data, os.time())
		local gained = math.floor(data.Factory.Stored - before)
		if data.Factory.Level > 0 and gained >= 1 then
			task.delay(4, function()
				Services.NetService.notify(
					player,
					"🏭 Пока тебя не было, фабрика накопила " .. Format.number(gained) .. " 💰 — забери в меню «Фабрика»!",
					"success"
				)
			end)
		end
		if completed then
			task.delay(5, function()
				Services.NetService.notify(player, "🏗️ Пока тебя не было, стройка фабрики завершилась!", "success")
			end)
		end
	end)

	Services.DataService.addBeforeSave(function(_player, data)
		Formulas.settleFactory(data, os.time())
	end)
end

function FactoryService:Start()
	local Net = Services.NetService

	Net.on("FactoryClaim", function(player, data)
		FactoryService.settle(player, data)
		local amount = math.floor(data.Factory.Stored)
		if amount < 1 then
			if data.Factory.Level <= 0 then
				return false, "Сначала построй фабрику!"
			end
			return false, "Пока пусто — фабрика копит монеты ⏳"
		end
		data.Factory.Stored -= amount
		data.Coins += amount
		data.TotalCoins += amount
		return true, "🏭 +" .. Format.number(amount) .. " 💰 с фабрики"
	end)

	Net.on("FactoryUpgrade", function(player, data)
		FactoryService.settle(player, data)
		local f = data.Factory
		local now = os.time()
		if f.BuildingTo > 0 then
			return false, "Уже строится! Осталось " .. Format.duration(f.BuildEndsAt - now) .. " ⏳"
		end
		local target = f.Level + 1
		if target > Config.Factory.MaxLevel then
			return false, "Фабрика уже максимального уровня 🏆"
		end
		local cost = Formulas.factoryCost(target)
		if data.Coins < cost then
			return false, "Не хватает " .. Format.number(cost - data.Coins) .. " 💰"
		end
		data.Coins -= cost
		data.Tutorial.Bought = true
		local buildTime = Formulas.factoryBuildTime(target)
		f.BuildingTo = target
		f.BuildEndsAt = now + buildTime
		if f.Level == 0 then
			return true, "🏗️ Фабрика строится! Готово через " .. Format.duration(buildTime)
		end
		return true, "🏗️ Улучшение до " .. target .. " ур. началось! Готово через " .. Format.duration(buildTime)
	end)

	while true do
		task.wait(2)
		for _, player in Players:GetPlayers() do
			local data = Services.DataService.get(player)
			if data then
				FactoryService.settle(player, data)
			end
		end
	end
end

return FactoryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">HelperService</string>
            <string name="Source"><![CDATA[--[[
	HelperService — помощники. Покупаются за монеты один раз навсегда,
	надеваются в слоты и сами ловят ближайший мусор рядом с хозяином.
	Модели помощников рисует клиент (по атрибуту игрока "Helpers").
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)

local HelperService = {}

local Services
local timers: { [Player]: { [number]: number } } = {}

function HelperService.refresh(player: Player, data)
	player:SetAttribute("Helpers", table.concat(data.Equipped, ","))
end

local function slotsOf(data): number
	return 1 + (data.Perks.HelperSlots or 0)
end

function HelperService:Init(services)
	Services = services
	Services.DataService.Loaded:Connect(function(player, data)
		HelperService.refresh(player, data)
	end)
end

function HelperService:Start()
	local Net = Services.NetService

	Net.on("BuyHelper", function(player, data, key)
		local def = type(key) == "string" and Config.HelperByKey[key]
		if not def then
			return false
		end
		if data.HelpersOwned[key] then
			return false, "Этот помощник у тебя уже есть"
		end
		if data.Coins < def.Cost then
			return false, "Не хватает " .. Format.number(def.Cost - data.Coins) .. " 💰"
		end
		data.Coins -= def.Cost
		data.HelpersOwned[key] = true
		data.Tutorial.Bought = true
		if #data.Equipped < slotsOf(data) then
			table.insert(data.Equipped, key)
		end
		HelperService.refresh(player, data)
		return true, "🐾 Новый помощник: " .. def.Name .. "!"
	end)

	Net.on("EquipHelper", function(player, data, key)
		local def = type(key) == "string" and Config.HelperByKey[key]
		if not def or not data.HelpersOwned[key] then
			return false
		end
		if table.find(data.Equipped, key) then
			return false, "Уже помогает тебе"
		end
		if #data.Equipped >= slotsOf(data) then
			return false, "Все слоты заняты — сними помощника или купи слот во вкладке «Перки»"
		end
		table.insert(data.Equipped, key)
		HelperService.refresh(player, data)
		return true
	end)

	Net.on("UnequipHelper", function(player, data, key)
		local index = type(key) == "string" and table.find(data.Equipped, key)
		if not index then
			return false
		end
		table.remove(data.Equipped, index)
		HelperService.refresh(player, data)
		timers[player] = nil
		return true
	end)

	Players.PlayerRemoving:Connect(function(player)
		timers[player] = nil
	end)

	while true do
		task.wait(0.1)
		local t = workspace:GetServerTimeNow()
		for _, player in Players:GetPlayers() do
			local data = Services.DataService.get(player)
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if data and root and #data.Equipped > 0 then
				local zone = Services.ZoneService.zoneOf(player)
				if zone <= data.MaxZone then
					local stats = Formulas.getStats(data, os.time(), Services.EventService.current())
					local mine = timers[player]
					if not mine then
						mine = {}
						timers[player] = mine
					end
					for index, key in data.Equipped do
						if index > stats.HelperSlots then
							break
						end
						local def = Config.HelperByKey[key]
						if def and t >= (mine[index] or 0) then
							local rec = Services.TrashService.findNearest(zone, root.Position, def.Range)
							if rec then
								local ok, reason = Services.TrashService.collect(player, data, rec, "helper", index)
								if not ok and reason == "full" then
									mine[index] = t + 2
								else
									mine[index] = t + def.Interval / stats.HelperSpeed
								end
							else
								mine[index] = t + 0.5
							end
						end
					end
				end
			end
		end
	end
end

return HelperService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--[[
	LeaderboardService — доски рекордов в первой зоне:
	«Топ уборщиков» (сколько мусора выловлено) и «Топ перерождений».
	Использует OrderedDataStore. Если хранилище недоступно (Studio),
	доски показывают игроков текущего сервера.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local LeaderboardService = {}

local Services
local nameCache: { [number]: string } = {}

local BOARDS = {
	{
		Name = "TopTrash",
		Store = Config.TopTrashStore,
		Value = function(data)
			return data.Stats.TrashCollected
		end,
	},
	{
		Name = "TopRebirth",
		Store = Config.TopRebirthStore,
		Value = function(data)
			return data.Rebirths
		end,
	},
}

local function nameOf(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.DisplayName
		return player.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if ok and name then name else ("Игрок " .. userId)
	nameCache[userId] = result
	return result
end

local function rowsOf(boardName: string)
	local board = workspace:FindFirstChild("Map")
	board = board and board:FindFirstChild("Leaderboards")
	board = board and board:FindFirstChild(boardName)
	board = board and board:FindFirstChild("Board")
	local gui = board and board:FindFirstChild("SurfaceFront")
	return gui and gui:FindFirstChild("Root")
end

local function render(boardName: string, entries: { { UserId: number, Value: number } })
	local root = rowsOf(boardName)
	if not root then
		return
	end
	for i = 1, 10 do
		local row = root:FindFirstChild("Row" .. i)
		if row then
			local entry = entries[i]
			row.PlayerName.Text = if entry then nameOf(entry.UserId) else "—"
			row.Value.Text = if entry then Format.number(entry.Value) else ""
		end
	end
end

local function localEntries(valueFn)
	local entries = {}
	for _, player in Players:GetPlayers() do
		local data = Services.DataService.get(player)
		if data then
			table.insert(entries, { UserId = player.UserId, Value = valueFn(data) })
		end
	end
	table.sort(entries, function(a, b)
		return a.Value > b.Value
	end)
	return entries
end

local function refresh(board, store)
	if store then
		for _, player in Players:GetPlayers() do
			local data = Services.DataService.get(player)
			if data and Services.DataService.canSave(player) then
				pcall(function()
					store:SetAsync(tostring(player.UserId), math.floor(board.Value(data)))
				end)
			end
		end
		local ok, pages = pcall(function()
			return store:GetSortedAsync(false, 10)
		end)
		if ok and pages then
			local entries = {}
			for _, item in pages:GetCurrentPage() do
				local userId = tonumber(item.key)
				if userId then
					table.insert(entries, { UserId = userId, Value = item.value })
				end
			end
			render(board.Name, entries)
			return
		end
	end
	render(board.Name, localEntries(board.Value))
end

function LeaderboardService:Init(services)
	Services = services
end

function LeaderboardService:Start()
	local stores = {}
	for index, board in BOARDS do
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore(board.Store)
		end)
		stores[index] = if ok then store else nil
	end

	task.wait(8)
	while true do
		for index, board in BOARDS do
			local ok, err = pcall(refresh, board, stores[index])
			if not ok then
				warn("[Рекорды]", err)
			end
		end
		task.wait(Config.LeaderboardRefresh)
	end
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">NetService</string>
            <string name="Source"><![CDATA[--[[
	NetService — связь с клиентами.

	• NetService.on("Действие", function(player, data, ...) return ok, "сообщение" end)
	• Защита от спама запросами.
	• Рассылка свежих данных игроку (не чаще 4 раз в секунду — бережём трафик).
	• Уведомления: NetService.notify(player, "текст", "success" | "error" | "info" | "legendary")
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local NetService = {}

local Services
local handlers: { [string]: (Player, any, ...any) -> (boolean?, string?) } = {}
local dirty: { [Player]: boolean } = {}
local buckets: { [Player]: { tokens: number, last: number } } = {}
local metaProviders: { (Player, { [string]: any }) -> () } = {}

local BUCKET_SIZE = 25
local BUCKET_REFILL = 12 -- запросов в секунду

local RequestRemote = Remotes.get("Request")
local StateRemote = Remotes.get("State")
local NotifyRemote = Remotes.get("Notify")
local EffectRemote = Remotes.get("Effect")

local function allow(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if not bucket then
		bucket = { tokens = BUCKET_SIZE, last = now }
		buckets[player] = bucket
	end
	bucket.tokens = math.min(BUCKET_SIZE, bucket.tokens + (now - bucket.last) * BUCKET_REFILL)
	bucket.last = now
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

function NetService.on(action: string, handler)
	handlers[action] = handler
end

function NetService.addMeta(provider: (Player, { [string]: any }) -> ())
	table.insert(metaProviders, provider)
end

function NetService.markDirty(player: Player)
	dirty[player] = true
end

function NetService.notify(player: Player, text: string, kind: string?)
	if player.Parent then
		NotifyRemote:FireClient(player, text, kind or "info")
	end
end

function NetService.notifyAll(text: string, kind: string?)
	NotifyRemote:FireAllClients(text, kind or "info")
end

function NetService.effectAll(...)
	EffectRemote:FireAllClients(...)
end

function NetService.effect(player: Player, ...)
	if player.Parent then
		EffectRemote:FireClient(player, ...)
	end
end

function NetService.push(player: Player)
	local data = Services.DataService.get(player)
	if not data or not player.Parent then
		return
	end
	local meta = { ServerTime = os.time() }
	for _, provider in metaProviders do
		local ok, err = pcall(provider, player, meta)
		if not ok then
			warn("[Сеть] meta:", err)
		end
	end
	StateRemote:FireClient(player, data, meta)
end

function NetService:Init(services)
	Services = services
end

function NetService:Start()
	RequestRemote.OnServerInvoke = function(player: Player, action: any, ...)
		if type(action) ~= "string" then
			return { ok = false }
		end
		if not allow(player) then
			return { ok = false, msg = "Слишком быстро! Подожди секунду." }
		end
		local data = Services.DataService.get(player)
		if not data then
			return { ok = false, msg = "Данные ещё загружаются…" }
		end
		local handler = handlers[action]
		if not handler then
			return { ok = false, msg = "Неизвестное действие" }
		end
		local ok, result, msg = pcall(handler, player, data, ...)
		if not ok then
			warn(string.format("[Сеть] Ошибка в «%s»: %s", action, tostring(result)))
			return { ok = false, msg = "Ошибка на сервере, попробуй ещё раз" }
		end
		NetService.markDirty(player)
		return { ok = result ~= false, msg = msg }
	end

	-- клиент просит прислать данные (например, после перезапуска скрипта)
	NetService.on("Sync", function()
		return true
	end)

	Players.PlayerRemoving:Connect(function(player)
		dirty[player] = nil
		buckets[player] = nil
	end)

	while true do
		task.wait(0.25)
		for player in dirty do
			dirty[player] = nil
			if player.Parent then
				NetService.push(player)
			end
		end
	end
end

return NetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">PlayerService</string>
            <string name="Source"><![CDATA[--[[
	PlayerService — появление персонажа, скорость бега, таблица лидеров (leaderstats),
	время в игре и приветствие.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)
local RiverMath = require(Shared.RiverMath)

local PlayerService = {}

local Services
local sessionStart: { [Player]: number } = {}

-- Появление персонажа (LoadCharacterAsync — новое имя LoadCharacter)
function PlayerService.spawnCharacter(player: Player)
	if not player.Parent then
		return
	end
	local ok = pcall(function()
		(player :: any):LoadCharacterAsync()
	end)
	if not ok and player.Parent then
		pcall(function()
			player:LoadCharacter()
		end)
	end
end

function PlayerService.sessionStart(player: Player): number
	return sessionStart[player] or os.time()
end

function PlayerService.applyStats(player: Player)
	local data = Services.DataService.get(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not data or not humanoid then
		return
	end
	local stats = Formulas.getStats(data, os.time(), Services.EventService.current())
	humanoid.WalkSpeed = stats.WalkSpeed
	humanoid.UseJumpPower = false
	humanoid.JumpHeight = stats.JumpHeight
end

local function setupLeaderstats(player: Player)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"

	local coins = Instance.new("StringValue")
	coins.Name = "💰 Монеты"
	coins.Value = "0"
	coins.Parent = folder

	local trash = Instance.new("IntValue")
	trash.Name = "🗑️ Мусор"
	trash.Parent = folder

	local rebirths = Instance.new("IntValue")
	rebirths.Name = "🌀 Перерожд."
	rebirths.Parent = folder

	folder.Parent = player
end

local function updateLeaderstats(player: Player)
	local data = Services.DataService.get(player)
	local folder = player:FindFirstChild("leaderstats")
	if not data or not folder then
		return
	end
	local coins = folder:FindFirstChild("💰 Монеты") :: StringValue?
	local trash = folder:FindFirstChild("🗑️ Мусор") :: IntValue?
	local rebirths = folder:FindFirstChild("🌀 Перерожд.") :: IntValue?
	if coins then
		coins.Value = Format.number(data.Coins)
	end
	if trash then
		trash.Value = data.Stats.TrashCollected
	end
	if rebirths then
		rebirths.Value = data.Rebirths
	end
end

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root then
		return
	end
	while not character.Parent do
		task.wait()
	end
	task.wait()
	PlayerService.applyStats(player)

	local data = Services.DataService.get(player)
	if data and data.LastZone > 1 and data.LastZone <= data.MaxZone then
		Services.ZoneService.teleport(player, data.LastZone)
	else
		player:SetAttribute("Zone", 1)
	end

	humanoid.Died:Connect(function()
		task.delay(Players.RespawnTime, function()
			PlayerService.spawnCharacter(player)
		end)
	end)
end

local function onLoaded(player: Player, data, info)
	sessionStart[player] = os.time()
	player:SetAttribute("SessionStart", sessionStart[player])
	setupLeaderstats(player)
	updateLeaderstats(player)

	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	PlayerService.spawnCharacter(player)

	local Net = Services.NetService
	Net.markDirty(player)
	if info.IsNew then
		task.delay(2, function()
			Net.notify(player, "Привет! 🌊 Кликай по мусору в реке, чтобы выловить его сачком!", "info")
		end)
	else
		local away = os.time() - (data.LastOnline or os.time())
		if away > 120 then
			task.delay(2, function()
				Net.notify(player, "С возвращением! Тебя не было " .. Format.duration(away) .. " 👋", "info")
			end)
		end
	end
	if not info.CanSave then
		task.delay(4, function()
			Net.notify(
				player,
				"⚠️ Сохранения выключены (Studio без доступа к API). Прогресс не запишется.",
				"error"
			)
		end)
	end
end

function PlayerService:Init(services)
	Services = services
	Services.DataService.Loaded:Connect(onLoaded)
end

function PlayerService:Start()
	Services.NetService.addMeta(function(player, meta)
		meta.SessionStart = sessionStart[player] or os.time()
		meta.CanSave = Services.DataService.canSave(player)
		meta.HubSpawn = RiverMath.hubPosition(1)
	end)

	Players.PlayerRemoving:Connect(function(player)
		local data = Services.DataService.get(player)
		if data and sessionStart[player] then
			data.Stats.PlayTime += os.time() - sessionStart[player]
		end
		sessionStart[player] = nil
	end)

	while true do
		task.wait(1)
		for _, player in Players:GetPlayers() do
			updateLeaderstats(player)
		end
	end
end

PlayerService.updateLeaderstats = updateLeaderstats

-- подсказка в консоли Studio
if #Config.Zones == 0 then
	warn("[Чистая Река] В Config нет зон!")
end

return PlayerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">QuestService</string>
            <string name="Source"><![CDATA[--[[
	QuestService — задания. У игрока всегда 3 задания; выполнил — забрал
	награду — получил новое. Не нравится задание — можно заменить (раз в 5 минут).
]]

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)

local QuestService = {}

local Services
local rng = Random.new()

local KINDS = { "Collect", "CollectType", "CollectRare", "Earn", "Sell", "Helper", "Shiny", "ZoneCollect" }

local function pickTrash(zoneId: number, rarities: { string }): string
	local list = {}
	for _, key in Config.Zones[zoneId].Trash do
		if table.find(rarities, Config.Trash[key].Rarity) then
			table.insert(list, key)
		end
	end
	return list[rng:NextInteger(1, #list)]
end

function QuestService.generate(data, exclude: { [string]: boolean }?)
	local base = Formulas.rewardBase(data)
	local zoneId = data.MaxZone
	local candidates = {}
	for _, kind in KINDS do
		local allowed = not (exclude and exclude[kind])
		if kind == "Helper" and #data.Equipped == 0 then
			allowed = false
		end
		if allowed then
			table.insert(candidates, kind)
		end
	end
	if #candidates == 0 then
		candidates = { "Collect" }
	end
	local kind = candidates[rng:NextInteger(1, #candidates)]

	local target, reward, text, param = 1, base, "", nil
	if kind == "Collect" then
		target = rng:NextInteger(5, 12) * 5
		reward = base * target / 4
		text = string.format("Собери %d %s мусора", target, Format.plural(target, "предмет", "предмета", "предметов"))
	elseif kind == "CollectType" then
		local uncommon = rng:NextNumber() < 0.4
		param = pickTrash(zoneId, if uncommon then { "Uncommon" } else { "Common" })
		target = if uncommon then rng:NextInteger(4, 8) else rng:NextInteger(8, 16)
		reward = base * target * (if uncommon then 1.4 else 0.6)
		text = string.format("Поймай %d × «%s»", target, Config.Trash[param].Name)
	elseif kind == "CollectRare" then
		target = rng:NextInteger(2, 4)
		reward = base * 6 * target
		text = string.format(
			"Поймай %d %s (или ещё круче)",
			target,
			Format.plural(target, "редкий предмет", "редких предмета", "редких предметов")
		)
	elseif kind == "Earn" then
		target = math.floor(base * rng:NextInteger(15, 30))
		reward = base * 8
		text = "Заработай " .. Format.number(target) .. " монет на переработке"
	elseif kind == "Sell" then
		target = rng:NextInteger(3, 6)
		reward = base * 3 * target
		text = string.format("Сдай мусор на переработку %d %s", target, Format.plural(target, "раз", "раза", "раз"))
	elseif kind == "Helper" then
		target = rng:NextInteger(4, 8) * 5
		reward = base * target / 3
		text = string.format(
			"Пусть помощники поймают %d %s",
			target,
			Format.plural(target, "предмет", "предмета", "предметов")
		)
	elseif kind == "Shiny" then
		target = rng:NextInteger(1, 2)
		reward = base * 12 * target
		text = string.format("Найди %d %s ✨", target, Format.plural(target, "сияющий предмет", "сияющих предмета", "сияющих предметов"))
	elseif kind == "ZoneCollect" then
		param = zoneId
		target = rng:NextInteger(6, 10) * 5
		reward = base * target / 3.5
		text = string.format("Собери %d %s в зоне «%s»", target, Format.plural(target, "предмет", "предмета", "предметов"), Config.Zones[zoneId].Name)
	end

	return {
		Id = HttpService:GenerateGUID(false),
		Kind = kind,
		Target = target,
		Progress = 0,
		Reward = math.max(1, math.floor(reward)),
		Text = text,
		Param = param,
		Done = false,
	}
end

local function activeKinds(data, skipId: string?)
	local kinds = {}
	for _, quest in data.Quests do
		if quest.Id ~= skipId then
			kinds[quest.Kind] = true
		end
	end
	return kinds
end

-- Проверяем, что задание ещё выполнимо (после перерождения зоны закрываются)
local function valid(data, quest): boolean
	if type(quest) ~= "table" or type(quest.Id) ~= "string" or type(quest.Target) ~= "number" then
		return false
	end
	if quest.Kind == "CollectType" then
		local def = Config.Trash[quest.Param]
		return def ~= nil and def.Zone <= data.MaxZone
	elseif quest.Kind == "ZoneCollect" then
		return type(quest.Param) == "number" and quest.Param <= data.MaxZone
	end
	return table.find(KINDS, quest.Kind) ~= nil
end

function QuestService.ensure(data)
	local kept = {}
	for _, quest in data.Quests do
		if valid(data, quest) and #kept < Config.Quests.Slots then
			table.insert(kept, quest)
		end
	end
	data.Quests = kept
	while #data.Quests < Config.Quests.Slots do
		table.insert(data.Quests, QuestService.generate(data, activeKinds(data)))
	end
end

function QuestService.reset(data)
	data.Quests = {}
	QuestService.ensure(data)
end

local function progress(player: Player, quest, amount: number)
	if quest.Done or amount <= 0 then
		return
	end
	quest.Progress = math.min(quest.Target, quest.Progress + amount)
	if quest.Progress >= quest.Target then
		quest.Done = true
		Services.NetService.notify(player, "✅ Задание выполнено! Забери награду в меню 📜", "success")
	end
end

function QuestService.onCollect(player: Player, data, key: string, source: string, zoneId: number, shiny: boolean)
	local def = Config.Trash[key]
	local rarityOrder = Config.Rarities[def.Rarity].Order
	for _, quest in data.Quests do
		local kind = quest.Kind
		local matches = kind == "Collect"
			or (kind == "CollectType" and quest.Param == key)
			or (kind == "CollectRare" and rarityOrder >= 3)
			or (kind == "Helper" and source == "helper")
			or (kind == "Shiny" and shiny)
			or (kind == "ZoneCollect" and quest.Param == zoneId)
		if matches then
			progress(player, quest, 1)
		end
	end
end

function QuestService.onSell(player: Player, data, coins: number)
	for _, quest in data.Quests do
		if quest.Kind == "Earn" then
			progress(player, quest, coins)
		elseif quest.Kind == "Sell" then
			progress(player, quest, 1)
		end
	end
end

local function findQuest(data, id: any)
	if type(id) ~= "string" then
		return nil, nil
	end
	for index, quest in data.Quests do
		if quest.Id == id then
			return quest, index
		end
	end
	return nil, nil
end

function QuestService:Init(services)
	Services = services
	-- подписываемся в Init, чтобы не пропустить первых игроков
	Services.DataService.Loaded:Connect(function(player, data)
		QuestService.ensure(data)
		Services.NetService.markDirty(player)
	end)
end

function QuestService:Start()
	local Net = Services.NetService

	Net.on("ClaimQuest", function(_player, data, id)
		local quest, index = findQuest(data, id)
		if not quest or not index then
			return false, "Задание не найдено"
		end
		if not quest.Done then
			return false, "Задание ещё не выполнено"
		end
		data.Coins += quest.Reward
		data.TotalCoins += quest.Reward
		data.QuestsDone += 1
		table.remove(data.Quests, index)
		table.insert(data.Quests, index, QuestService.generate(data, activeKinds(data)))
		return true, "📜 Награда за задание: +" .. Format.number(quest.Reward) .. " 💰"
	end)

	Net.on("RerollQuest", function(_player, data, id)
		local quest, index = findQuest(data, id)
		if not quest or not index then
			return false, "Задание не найдено"
		end
		if quest.Done then
			return false, "Сначала забери награду!"
		end
		local now = os.time()
		if now < (data.QuestRerollAt or 0) then
			return false, "Заменить можно через " .. Format.duration(data.QuestRerollAt - now) .. " ⏳"
		end
		data.QuestRerollAt = now + Config.Quests.RerollCooldown
		local exclude = activeKinds(data)
		exclude[quest.Kind] = true
		data.Quests[index] = QuestService.generate(data, exclude)
		return true, "🔄 Новое задание!"
	end)
end

return QuestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">RebirthService</string>
            <string name="Source"><![CDATA[--[[
	RebirthService — перерождение. Сбрасывает монеты, сачок, рюкзак, обувь и зоны,
	но навсегда даёт +50% монет и +5% удачи. Перки, помощники, фабрика,
	коллекция и статистика остаются.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)

local RebirthService = {}

local Services

function RebirthService:Init(services)
	Services = services
end

function RebirthService:Start()
	local Net = Services.NetService

	Net.on("Rebirth", function(player, data)
		local cost = Formulas.rebirthCost(data.Rebirths)
		if data.Coins < cost then
			return false, "Для перерождения нужно " .. Format.number(cost) .. " 💰"
		end

		Formulas.settleFactory(data, os.time())
		data.Coins = 0
		data.Net = 1
		data.Backpack = 1
		data.Boots = 1
		data.MaxZone = 1
		data.LastZone = 1
		data.Inventory = {}
		data.InvSize = 0
		data.InvValue = 0
		data.Rebirths += 1

		Services.QuestService.reset(data)
		Services.ZoneService.teleport(player, 1)
		Services.PlayerService.applyStats(player)

		local mult = Formulas.rebirthMultiplier(data.Rebirths)
		Net.notifyAll(string.format("🌀 %s совершает перерождение №%d!", player.DisplayName, data.Rebirths), "legendary")
		return true, "🌀 Перерождение №" .. data.Rebirths .. "! Теперь монеты " .. Format.multiplier(mult)
	end)
end

return RebirthService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[--[[
	RewardService — бесплатные награды:
	• ежедневная награда (серия из 7 дней, на 7-й день все бусты перезаряжаются);
	• подарки за время в игре (3, 8, 15, 25, 40, 60 минут за заход).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)

local RewardService = {}

local Services
local claimedGifts: { [Player]: { [number]: boolean } } = {}

function RewardService:Init(services)
	Services = services
	Services.DataService.Loaded:Connect(function(player, data)
		claimedGifts[player] = {}
		local available = Formulas.dailyStatus(data, os.time())
		if available then
			task.delay(6, function()
				Services.NetService.notify(player, "🎁 Ежедневная награда ждёт! Открой меню «Награды»", "success")
			end)
		end
	end)
end

function RewardService:Start()
	local Net = Services.NetService

	Net.addMeta(function(player, meta)
		local list = {}
		for index in claimedGifts[player] or {} do
			table.insert(list, index)
		end
		meta.GiftsClaimed = list
	end)

	Net.on("ClaimDaily", function(_player, data)
		local now = os.time()
		local available, streak, wait = Formulas.dailyStatus(data, now)
		if not available then
			return false, "Следующая награда через " .. Format.duration(wait) .. " ⏳"
		end
		local reward = Formulas.dailyReward(data, streak)
		data.Coins += reward
		data.TotalCoins += reward
		data.Daily.Streak = streak
		data.Daily.LastClaim = now
		local extra = ""
		if streak == #Config.Daily.Mults then
			Services.BoostService.resetCooldowns(data)
			extra = " Все бусты перезаряжены! ⚡"
		end
		return true, string.format("🎁 День %d: +%s 💰!%s", streak, Format.number(reward), extra)
	end)

	Net.on("ClaimGift", function(player, data, index)
		if type(index) ~= "number" then
			return false
		end
		index = math.floor(index)
		local gift = Config.Gifts[index]
		local claimed = claimedGifts[player]
		if not gift or not claimed then
			return false
		end
		if claimed[index] then
			return false, "Этот подарок уже получен"
		end
		local elapsed = os.time() - Services.PlayerService.sessionStart(player)
		local need = gift.Minutes * 60
		if elapsed < need then
			return false, "Подарок откроется через " .. Format.duration(need - elapsed) .. " ⏳"
		end
		claimed[index] = true
		local reward = Formulas.giftReward(data, index)
		data.Coins += reward
		data.TotalCoins += reward
		local extra = ""
		if gift.Boost then
			Services.BoostService.grant(data, gift.Boost)
			local boost = Config.BoostByKey[gift.Boost]
			extra = " + " .. boost.Icon .. " " .. boost.Name .. "!"
		end
		return true, "🎁 Подарок: +" .. Format.number(reward) .. " 💰" .. extra
	end)

	Players.PlayerRemoving:Connect(function(player)
		claimedGifts[player] = nil
	end)
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--[[
	ShopService — магазин. Всё покупается ТОЛЬКО за внутриигровые монеты.
	Никаких робуксов, геймпассов и developer products в игре нет.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)

local ShopService = {}

local Services

local function notEnough(data, cost: number): string
	return "Не хватает " .. Format.number(cost - data.Coins) .. " 💰 — лови ещё мусор!"
end

-- Покупка следующего уровня (сачок, рюкзак, обувь)
local function tierHandler(list, field: string, after: ((Player, any) -> ())?)
	return function(player: Player, data, tier: any)
		if type(tier) ~= "number" then
			return false
		end
		tier = math.floor(tier)
		local item = list[tier]
		if not item then
			return false
		end
		local current = data[field]
		if tier <= current then
			return false, "Уже куплено"
		end
		if tier ~= current + 1 then
			return false, "Сначала купи предыдущий уровень"
		end
		if data.Coins < item.Cost then
			return false, notEnough(data, item.Cost)
		end
		data.Coins -= item.Cost
		data[field] = tier
		data.Tutorial.Bought = true
		if after then
			after(player, data)
		end
		return true, item.Icon .. " Куплено: " .. item.Name
	end
end

function ShopService:Init(services)
	Services = services
end

function ShopService:Start()
	local Net = Services.NetService

	Net.on("BuyNet", tierHandler(Config.Nets, "Net"))
	Net.on("BuyBackpack", tierHandler(Config.Backpacks, "Backpack"))
	Net.on(
		"BuyBoots",
		tierHandler(Config.Boots, "Boots", function(player)
			Services.PlayerService.applyStats(player)
		end)
	)

	Net.on("BuyPerk", function(player, data, key)
		local def = type(key) == "string" and Config.Perks[key]
		if not def then
			return false
		end
		local level = data.Perks[key] or 0
		if level >= def.MaxLevel then
			return false, "Уже максимальный уровень 🏆"
		end
		local cost = Formulas.perkCost(key, level + 1) :: number
		if data.Coins < cost then
			return false, notEnough(data, cost)
		end
		if key == "Storage" then
			Formulas.settleFactory(data, os.time())
		end
		data.Coins -= cost
		data.Perks[key] = level + 1
		data.Tutorial.Bought = true
		if key == "HelperSlots" then
			Services.HelperService.refresh(player, data)
		end
		local suffix = if def.MaxLevel > 1 then " (ур. " .. (level + 1) .. ")" else ""
		return true, def.Icon .. " " .. def.Name .. suffix .. " — куплено!"
	end)

	Net.on("SetSetting", function(_player, data, name, value)
		if type(name) ~= "string" or Config.SettingKeys[name] == nil or type(value) ~= "boolean" then
			return false
		end
		data.Settings[name] = value
		return true
	end)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">TrashService</string>
            <string name="Source"><![CDATA[--[[
	TrashService — сердце игры.

	• Мусор появляется у труб плотины и плывёт по течению (или застревает у берега).
	• Позиция считается формулой от времени — сервер и клиенты видят одно и то же.
	• Вылов: клиент присылает Id предмета, сервер проверяет дальность сачка,
	  перезарядку, открыта ли зона и есть ли место в рюкзаке.
	• Продажа: площадка ♻️ на базе каждой зоны (или перк «Продажа где угодно»).
	• Авто-сбор (перк), авто-продажа (перк).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)
local Remotes = require(Shared.Remotes)
local RiverMath = require(Shared.RiverMath)
local TrashModels = require(Shared.TrashModels)
local Util = require(Shared.Util)

local TrashService = {}

local W = Config.World
local Services
local folder: Folder
local rng = Random.new()

type Rec = {
	Id: number,
	Key: string,
	Zone: number,
	Origin: Vector3,
	Vel: Vector3,
	T0: number,
	Seed: number,
	Expire: number,
	Model: Model?,
}

local active: { [number]: Rec } = {}
local zoneRecs: { [number]: { [number]: Rec } } = {}
local zoneCounts: { [number]: number } = {}
local nextSpawn: { [number]: number } = {}
local zoneActive: { [number]: boolean } = {}
local nextId = 0

local lastCollect: { [Player]: number } = {}
local nextAuto: { [Player]: number } = {}
local lastFullWarn: { [Player]: number } = {}
local padDebounce: { [Player]: number } = {}

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function statsFor(data)
	return Formulas.getStats(data, os.time(), Services.EventService.current())
end

function TrashService.position(rec: Rec, t: number): Vector3
	return RiverMath.trashPosition(rec.Origin, rec.Vel, rec.T0, rec.Seed, t)
end

function TrashService.count(zoneId: number): number
	return zoneCounts[zoneId] or 0
end

local function removeRecord(rec: Rec)
	if not active[rec.Id] then
		return
	end
	active[rec.Id] = nil
	zoneRecs[rec.Zone][rec.Id] = nil
	zoneCounts[rec.Zone] -= 1
	if rec.Model then
		rec.Model:Destroy()
		rec.Model = nil
	end
end

----------------------------------------------------------------------
-- Появление мусора
----------------------------------------------------------------------
local function pickType(zoneId: number, luck: number): string
	local list, total = Formulas.trashWeights(zoneId, luck)
	local roll = rng:NextNumber() * total
	for _, entry in list do
		roll -= entry.Weight
		if roll <= 0 then
			return entry.Key
		end
	end
	return list[#list].Key
end

local function spawnTrash(zoneId: number, t: number, luck: number, prefill: boolean?)
	local zone = Config.Zones[zoneId]
	local key = pickType(zoneId, luck)
	local rz = RiverMath.riverZ(zoneId)
	local half = W.RiverWidth / 2
	local seed = rng:NextNumber(0, 100)

	local origin, vel, t0, expire
	if rng:NextNumber() < Config.Spawning.StuckChance then
		-- застрял у берега: не уплывает, но через пару минут тонет
		local side = if rng:NextNumber() < 0.5 then -1 else 1
		local z = rz + side * (half - rng:NextNumber(1.5, 6))
		local x = rng:NextNumber(W.RiverStartX + 12, W.RiverEndX - 12)
		origin = Vector3.new(x, W.WaterY, z)
		vel = Vector3.zero
		t0 = t
		expire = t + rng:NextNumber(Config.Spawning.StuckLife[1], Config.Spawning.StuckLife[2])
	else
		local z = rz + rng:NextNumber(-half + 3, half - 3)
		local speed = rng:NextNumber(zone.FlowSpeed[1], zone.FlowSpeed[2])
		local lifetime = RiverMath.flowLifetime(speed)
		origin = Vector3.new(W.RiverStartX, W.WaterY, z)
		vel = Vector3.new(speed, 0, 0)
		t0 = if prefill then t - rng:NextNumber(0, lifetime * 0.9) else t
		expire = t0 + lifetime
	end

	nextId += 1
	local id = nextId
	local model = TrashModels.build(key)
	TrashModels.decorate(model, key)
	model.Name = "T" .. id
	local cf = RiverMath.trashCFrame(origin, vel, t0, seed, t)
	model:PivotTo(cf)
	model:SetAttribute("Id", id)
	model:SetAttribute("Type", key)
	model:SetAttribute("Zone", zoneId)
	model:SetAttribute("T0", t0)
	model:SetAttribute("Origin", origin)
	model:SetAttribute("Vel", vel)
	model:SetAttribute("Seed", seed)
	model:SetAttribute("Pivot0", cf)
	model.Parent = folder

	local rec: Rec = {
		Id = id,
		Key = key,
		Zone = zoneId,
		Origin = origin,
		Vel = vel,
		T0 = t0,
		Seed = seed,
		Expire = expire,
		Model = model,
	}
	active[id] = rec
	zoneRecs[zoneId][id] = rec
	zoneCounts[zoneId] += 1
end

-- Удача зоны: лучшая удача среди игроков в ней (немного ослабленная) + событие
local function zoneLuck(players: { Player }): number
	local best = 1
	for _, player in players do
		local data = Services.DataService.get(player)
		if data then
			best = math.max(best, Formulas.luck(data, os.time(), nil))
		end
	end
	local luck = best ^ 0.5
	local event = Services.EventService.def()
	if event and event.LuckMult then
		luck *= event.LuckMult
	end
	return luck
end

----------------------------------------------------------------------
-- Поиск и вылов
----------------------------------------------------------------------
function TrashService.findNearest(zoneId: number, pos: Vector3, range: number, exclude: { [Rec]: boolean }?): (Rec?, number)
	local best: Rec? = nil
	local bestDist = range
	local recs = zoneRecs[zoneId]
	if not recs then
		return nil, math.huge
	end
	local t = serverNow()
	for _, rec in recs do
		if not (exclude and exclude[rec]) then
			local d = Util.flatDistance(TrashService.position(rec, t), pos)
			if d <= bestDist then
				best = rec
				bestDist = d
			end
		end
	end
	return best, bestDist
end

local function warnFull(player: Player, data)
	local now = os.clock()
	if now - (lastFullWarn[player] or 0) < 3 then
		return
	end
	lastFullWarn[player] = now
	local text = "🎒 Рюкзак полон! Неси мусор на ♻️ переработку"
	if (data.Perks.SellAnywhere or 0) > 0 then
		text = "🎒 Рюкзак полон! Нажми «Продать» ♻️"
	end
	Services.NetService.notify(player, text, "error")
end

-- Положить предмет в рюкзак. source: "click" | "auto" | "helper"
function TrashService.collect(player: Player, data, rec: Rec, source: string, helperIndex: number?): (boolean, string?)
	if not active[rec.Id] then
		return false, "gone"
	end
	local def = Config.Trash[rec.Key]
	local stats = statsFor(data)

	if data.InvSize + def.Size > stats.Capacity then
		if (data.Perks.AutoSell or 0) > 0 and data.Settings.AutoSell then
			TrashService.sell(player, data, "auto")
		end
		if data.InvSize + def.Size > stats.Capacity then
			return false, "full"
		end
	end

	local t = serverNow()
	local pos = TrashService.position(rec, t)
	removeRecord(rec)

	local shiny = rng:NextNumber() < stats.ShinyChance
	local value = def.Value * (if shiny then Config.Shiny.ValueMult else 1)

	data.Inventory[rec.Key] = (data.Inventory[rec.Key] or 0) + 1
	data.InvSize += def.Size
	data.InvValue += value
	data.Stats.TrashCollected += 1
	data.Tutorial.Collected = true
	if shiny then
		data.Stats.Shiny += 1
	end
	if source == "helper" then
		data.Stats.HelperCollected += 1
	end

	local Net = Services.NetService
	local rarity = Config.Rarities[def.Rarity]
	if not data.Discovered[rec.Key] then
		data.Discovered[rec.Key] = true
		Net.notify(
			player,
			string.format("📖 Новое в коллекции: %s (+%s к монетам навсегда)", def.Name, Format.percent(Config.Collection.BonusPerItem)),
			"info"
		)
	end
	if def.Rarity == "Legendary" then
		data.Stats.Legendary += 1
		Net.notifyAll(string.format("🌟 %s: легендарная находка — %s!", player.DisplayName, def.Name), "legendary")
	elseif rarity.Order == 4 then
		Net.notify(player, "💜 Эпическая находка: " .. def.Name .. "!", "info")
	end
	if shiny then
		Net.notify(player, string.format("✨ Сияющий «%s»! Стоит в %d раз дороже", def.Name, Config.Shiny.ValueMult), "success")
	end

	Services.QuestService.onCollect(player, data, rec.Key, source, rec.Zone, shiny)
	Net.effectAll("collect", player.UserId, rec.Key, pos, shiny, helperIndex or 0)
	Net.markDirty(player)
	return true, nil
end

-- Продать весь рюкзак. Возвращает полученные монеты
function TrashService.sell(player: Player, data, source: string): number
	if data.InvSize <= 0 or data.InvValue <= 0 then
		data.Inventory = {}
		data.InvSize = 0
		data.InvValue = 0
		return 0
	end
	local mult = Formulas.coinMultiplier(data, os.time(), Services.EventService.current())
	local coins = math.max(1, math.floor(data.InvValue * mult + 0.5))
	local items = 0
	for _, count in data.Inventory do
		items += count
	end

	data.Coins += coins
	data.TotalCoins += coins
	data.Inventory = {}
	data.InvSize = 0
	data.InvValue = 0
	data.Stats.Sells += 1
	data.Stats.BestSell = math.max(data.Stats.BestSell or 0, coins)
	data.Tutorial.Sold = true

	Services.QuestService.onSell(player, data, coins)
	Services.NetService.effect(player, "sell", coins, items, source)
	Services.NetService.markDirty(player)
	return coins
end

local function nearSellPad(player: Player): boolean
	local root = rootOf(player)
	if not root then
		return false
	end
	local zone = RiverMath.zoneFromZ(root.Position.Z)
	local pad = RiverMath.sellPadPosition(zone)
	return Util.flatDistance(root.Position, pad) <= 9 and math.abs(root.Position.Y - pad.Y) < 8
end

----------------------------------------------------------------------
-- Запуск
----------------------------------------------------------------------
local function onClick(player: Player, id: any)
	if type(id) ~= "number" then
		return
	end
	local data = Services.DataService.get(player)
	local rec = active[id]
	local root = rootOf(player)
	if not data or not rec or not root then
		return
	end
	if rec.Zone > data.MaxZone then
		return
	end

	local stats = statsFor(data)
	local t = serverNow()
	if t - (lastCollect[player] or 0) < stats.Cooldown * 0.75 then
		return
	end
	local pos = TrashService.position(rec, t)
	local reach = stats.Range + 6 + root.AssemblyLinearVelocity.Magnitude * 0.25
	if Util.flatDistance(root.Position, pos) > reach then
		return
	end
	lastCollect[player] = t

	local targets = { rec }
	if stats.Multi > 1 then
		local others = {}
		for _, other in zoneRecs[rec.Zone] do
			if other ~= rec then
				local op = TrashService.position(other, t)
				local d = Util.flatDistance(op, pos)
				if d <= 10 and Util.flatDistance(op, root.Position) <= reach then
					table.insert(others, { rec = other, d = d })
				end
			end
		end
		table.sort(others, function(a, b)
			return a.d < b.d
		end)
		for i = 1, math.min(#others, stats.Multi - 1) do
			table.insert(targets, others[i].rec)
		end
	end

	for _, target in targets do
		local ok, reason = TrashService.collect(player, data, target, "click")
		if not ok then
			if reason == "full" then
				warnFull(player, data)
			end
			break
		end
	end
end

local function hookSellPad(pad: BasePart)
	pad.Touched:Connect(function(hit)
		local character = hit:FindFirstAncestorOfClass("Model")
		local player = character and Players:GetPlayerFromCharacter(character)
		if not player then
			return
		end
		local now = os.clock()
		if now - (padDebounce[player] or 0) < 1 then
			return
		end
		padDebounce[player] = now
		local data = Services.DataService.get(player)
		if data and data.InvSize > 0 then
			TrashService.sell(player, data, "pad")
		end
	end)
end

function TrashService:Init(services)
	Services = services
	for zoneId in Config.Zones do
		zoneRecs[zoneId] = {}
		zoneCounts[zoneId] = 0
		nextSpawn[zoneId] = 0
	end
	local old = workspace:FindFirstChild("Trash")
	if old then
		old:Destroy()
	end
	folder = Instance.new("Folder")
	folder.Name = "Trash"
	folder.Parent = workspace
end

function TrashService:Start()
	local Net = Services.NetService

	Remotes.get("Collect").OnServerEvent:Connect(onClick)

	Net.on("SellAll", function(player, data)
		if data.InvSize <= 0 then
			return false, "Рюкзак пуст — сначала налови мусора 🎣"
		end
		if (data.Perks.SellAnywhere or 0) <= 0 and not nearSellPad(player) then
			return false, "Подойди к ♻️ переработке или купи перк «Продажа где угодно»"
		end
		TrashService.sell(player, data, "button")
		return true
	end)

	for _, pad in Services.WorldService.folder("SellPads"):GetDescendants() do
		if pad:IsA("BasePart") and pad:GetAttribute("SellPad") then
			hookSellPad(pad)
		end
	end

	Players.PlayerRemoving:Connect(function(player)
		lastCollect[player] = nil
		nextAuto[player] = nil
		lastFullWarn[player] = nil
		padDebounce[player] = nil
	end)

	-- сразу немного мусора, чтобы река не была пустой
	local t0 = serverNow()
	for zoneId in Config.Zones do
		for _ = 1, Config.Spawning.PrefillCount do
			spawnTrash(zoneId, t0, 1, true)
		end
	end

	local lastPollution = 0
	local lastPadCheck = 0
	while true do
		task.wait(0.1)
		local t = serverNow()
		local event = Services.EventService.def()
		local spawnMult = event and event.SpawnMult or 1
		local maxMult = event and event.MaxMult or 1

		-- появление и исчезновение
		for zoneId, zone in Config.Zones do
			for _, rec in zoneRecs[zoneId] do
				if t >= rec.Expire then
					removeRecord(rec)
				end
			end
			local present = #Services.ZoneService.playersIn(zoneId) > 0
			if present and not zoneActive[zoneId] then
				-- в пустую зону пришёл игрок: сразу оживляем реку,
				-- мусор раскидан по всей длине (а не только у труб)
				local players = Services.ZoneService.playersIn(zoneId)
				local target = math.floor(zone.MaxTrash * Config.Spawning.ArrivalFill)
				local luck = zoneLuck(players)
				for _ = 1, math.max(0, target - zoneCounts[zoneId]) do
					spawnTrash(zoneId, t, luck, true)
				end
			end
			zoneActive[zoneId] = present
			if t >= nextSpawn[zoneId] then
				local players = Services.ZoneService.playersIn(zoneId)
				local max = if #players > 0 then math.floor(zone.MaxTrash * maxMult) else Config.Spawning.IdleMax
				if zoneCounts[zoneId] < max then
					spawnTrash(zoneId, t, zoneLuck(players))
				end
				local speedup = 1 + Config.Spawning.PlayerSpawnBonus * math.max(0, #players - 1)
				local interval = zone.SpawnInterval / speedup / spawnMult
				if #players == 0 then
					interval *= 3
				end
				nextSpawn[zoneId] = t + interval * rng:NextNumber(0.7, 1.3)
			end
		end

		-- авто-сбор
		for _, player in Players:GetPlayers() do
			local data = Services.DataService.get(player)
			if data and (data.Perks.AutoCollect or 0) > 0 and data.Settings.AutoCollect and t >= (nextAuto[player] or 0) then
				local root = rootOf(player)
				local zone = Services.ZoneService.zoneOf(player)
				if root and zone <= data.MaxZone then
					local stats = statsFor(data)
					local rec = TrashService.findNearest(zone, root.Position, stats.Range)
					if rec then
						local ok, reason = TrashService.collect(player, data, rec, "auto")
						if not ok and reason == "full" then
							warnFull(player, data)
							nextAuto[player] = t + 2
						else
							nextAuto[player] = t + stats.AutoCollectInterval
						end
					else
						nextAuto[player] = t + 0.3
					end
				end
			end
		end

		-- стоишь на площадке — продаём (Touched срабатывает только при касании)
		if t - lastPadCheck > 1 then
			lastPadCheck = t
			for _, player in Players:GetPlayers() do
				local data = Services.DataService.get(player)
				if data and data.InvSize > 0 and nearSellPad(player) then
					TrashService.sell(player, data, "pad")
				end
			end
		end

		-- загрязнение реки (для цвета воды у клиентов)
		if t - lastPollution > 2 then
			lastPollution = t
			for zoneId, zone in Config.Zones do
				ReplicatedStorage:SetAttribute("Pollution" .. zoneId, math.clamp(zoneCounts[zoneId] / zone.MaxTrash, 0, 1))
			end
		end
	end
end

return TrashService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--[[
	WorldService — строит весь мир при запуске сервера.

	Остров посреди моря, на нём 6 зон друг за другом (по оси Z).
	В каждой зоне: река из Terrain-воды (течёт по оси X), плотина с трубами,
	откуда приплывает мусор, решётка на выходе, два моста, база
	(переработка, магазин), декорации своей темы и ворота в следующую зону.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local RiverMath = require(Shared.RiverMath)
local Util = require(Shared.Util)

local WorldService = {}

local W = Config.World
local V = Vector3.new
local C = Color3.fromRGB
local CF = CFrame.new
local ANG = CFrame.Angles
local R = math.rad
local UP = ANG(0, 0, R(90))
local ALONG_Z = ANG(0, R(90), 0)

local LAND_HALF_X = W.HalfWidth + 24

local Map: Folder
local Folders: { [string]: Folder } = {}

-- Вид построек по темам
local STYLE = {
	Meadow = {
		Path = "Ground",
		Fence = C(140, 100, 60),
		FenceMat = "Wood",
		Wall = "Cobblestone",
		WallColor = C(150, 150, 140),
		Bridge = "WoodPlanks",
		BridgeColor = C(150, 110, 70),
	},
	City = {
		Path = "Cobblestone",
		Fence = C(60, 62, 70),
		FenceMat = "Metal",
		Wall = "Brick",
		WallColor = C(165, 95, 75),
		Bridge = "Concrete",
		BridgeColor = C(175, 175, 175),
	},
	Swamp = {
		Path = "WoodPlanks",
		Fence = C(90, 70, 45),
		FenceMat = "Wood",
		Wall = "WoodPlanks",
		WallColor = C(95, 75, 50),
		Bridge = "WoodPlanks",
		BridgeColor = C(110, 85, 55),
	},
	Industrial = {
		Path = "Concrete",
		Fence = C(120, 120, 125),
		FenceMat = "DiamondPlate",
		Wall = "Concrete",
		WallColor = C(135, 135, 135),
		Bridge = "DiamondPlate",
		BridgeColor = C(115, 115, 120),
	},
	Toxic = {
		Path = "Cobblestone",
		Fence = C(70, 80, 60),
		FenceMat = "CorrodedMetal",
		Wall = "CorrodedMetal",
		WallColor = C(95, 105, 80),
		Bridge = "CorrodedMetal",
		BridgeColor = C(105, 95, 75),
	},
	Ocean = {
		Path = "WoodPlanks",
		Fence = C(225, 215, 185),
		FenceMat = "Wood",
		Wall = "Sand",
		WallColor = C(220, 200, 150),
		Bridge = "WoodPlanks",
		BridgeColor = C(185, 150, 105),
	},
}

local function styleFor(zoneId: number)
	return STYLE[Config.Zones[zoneId].Theme.Decor] or STYLE.Meadow
end

----------------------------------------------------------------------
-- Помощники построения
----------------------------------------------------------------------
local function fill(cframe: CFrame, size: Vector3, material: string)
	workspace.Terrain:FillBlock(cframe, size, Util.material(material))
end

local function P(parent: Instance, props: { [string]: any }): Part
	props.Parent = parent
	return Util.part(props)
end

local function newModel(name: string, parent: Instance): Model
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

local function label(parent: Instance, props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Font = Enum.Font.GothamBlack,
		TextColor3 = C(255, 255, 255),
		TextScaled = true,
		Parent = parent,
	}
	for key, value in props do
		defaults[key] = value
	end
	local text = Util.create("TextLabel", defaults)
	Util.create("UIStroke", { Thickness = 2, Color = C(15, 20, 30), Transparency = 0.2, Parent = text })
	return text
end

-- Табличка над объектом, всегда смотрит на камеру
local function billboard(adornee: BasePart, title: string, subtitle: string?, color: Color3, offsetY: number)
	local gui = Util.create("BillboardGui", {
		Name = "Sign",
		Size = UDim2.fromScale(16, 4.2),
		StudsOffset = V(0, offsetY, 0),
		MaxDistance = 220,
		LightInfluence = 0,
		AlwaysOnTop = false,
		Adornee = adornee,
		Parent = adornee,
	})
	label(gui, { Name = "Title", Text = title, TextColor3 = color, Size = UDim2.fromScale(1, 0.62) })
	if subtitle then
		label(gui, {
			Name = "Subtitle",
			Text = subtitle,
			Font = Enum.Font.GothamBold,
			Size = UDim2.fromScale(1, 0.34),
			Position = UDim2.fromScale(0, 0.64),
		})
	end
	return gui
end

-- Надпись на грани детали
local function surface(part: BasePart, face: Enum.NormalId, build: (SurfaceGui) -> ())
	local gui = Util.create("SurfaceGui", {
		Name = "Surface" .. face.Name,
		Face = face,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 40,
		LightInfluence = 0,
		Parent = part,
	})
	build(gui)
	return gui
end

local function prompt(part: BasePart, action: string, object: string, openUI: string)
	local p = Util.create("ProximityPrompt", {
		ActionText = action,
		ObjectText = object,
		HoldDuration = 0,
		MaxActivationDistance = 14,
		RequiresLineOfSight = false,
		Parent = part,
	})
	p:SetAttribute("OpenUI", openUI)
	return p
end

local function sparkleEmitter(parent: Instance, color: Color3, rate: number)
	return Util.create("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
		Rate = rate,
		Lifetime = NumberRange.new(1, 2),
		Speed = NumberRange.new(2, 4),
		SpreadAngle = Vector2.new(25, 25),
		EmissionDirection = Enum.NormalId.Top,
		LightEmission = 0.8,
		Color = ColorSequence.new(color),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }),
		Parent = parent,
	})
end

local function smokeEmitter(parent: Instance, color: Color3)
	return Util.create("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/smoke_main.dds",
		Rate = 5,
		Lifetime = NumberRange.new(4, 6),
		Speed = NumberRange.new(3, 5),
		SpreadAngle = Vector2.new(12, 12),
		EmissionDirection = Enum.NormalId.Top,
		RotSpeed = NumberRange.new(-30, 30),
		Rotation = NumberRange.new(0, 360),
		Color = ColorSequence.new(color),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 7) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) }),
		Parent = parent,
	})
end

----------------------------------------------------------------------
-- Освещение
----------------------------------------------------------------------
local function setupLighting()
	Lighting.ClockTime = 14.2
	Lighting.Brightness = 2.4
	Lighting.GlobalShadows = true
	Lighting.Ambient = C(95, 95, 105)
	Lighting.OutdoorAmbient = C(140, 140, 150)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GeographicLatitude = 35

	for _, child in Lighting:GetChildren() do
		if child:IsA("Atmosphere") or child:IsA("Sky") or child:IsA("PostEffect") then
			child:Destroy()
		end
	end
	Util.create("Sky", { Name = "Sky", Parent = Lighting })
	Util.create("Atmosphere", {
		Name = "Atmosphere",
		Density = 0.26,
		Offset = 0.15,
		Color = C(200, 215, 230),
		Decay = C(110, 125, 150),
		Glare = 0.25,
		Haze = 1.2,
		Parent = Lighting,
	})
	Util.create("BloomEffect", { Intensity = 0.5, Size = 24, Threshold = 1.6, Parent = Lighting })
	Util.create("ColorCorrectionEffect", { Saturation = 0.12, Contrast = 0.06, Brightness = 0.01, Parent = Lighting })
	Util.create("SunRaysEffect", { Intensity = 0.05, Spread = 0.8, Parent = Lighting })

	local terrain = workspace.Terrain
	terrain.WaterWaveSize = 0.12
	terrain.WaterWaveSpeed = 7
	terrain.WaterReflectance = 0.35
	terrain.WaterTransparency = 0.45
	terrain.WaterColor = Config.Zones[1].Theme.WaterClean
	pcall(function()
		terrain:SetMaterialColor(Enum.Material.Grass, C(95, 175, 70))
		terrain:SetMaterialColor(Enum.Material.LeafyGrass, C(90, 120, 60))
		terrain:SetMaterialColor(Enum.Material.Sand, C(225, 205, 150))
		terrain:SetMaterialColor(Enum.Material.Mud, C(85, 70, 50))
	end)
end

----------------------------------------------------------------------
-- Рельеф: море, остров, реки, дорожки
----------------------------------------------------------------------
local function buildTerrain()
	local count = #Config.Zones
	local firstZ = RiverMath.zoneOriginZ(1) - W.HalfDepth
	local lastZ = RiverMath.zoneOriginZ(count) + W.HalfDepth
	local midZ = (firstZ + lastZ) / 2
	local length = lastZ - firstZ

	-- море вокруг острова
	fill(CF(0, -24, midZ), V(1000, 8, length + 700), "Sand")
	fill(CF(0, -11, midZ), V(1000, 18, length + 700), "Water")
	-- пляж по краю
	fill(CF(0, -4, midZ), V(LAND_HALF_X * 2 + 40, 8, length + 48), "Sand")

	for zoneId, zone in Config.Zones do
		local oz = RiverMath.zoneOriginZ(zoneId)
		local rz = RiverMath.riverZ(zoneId)
		local theme = zone.Theme
		local style = styleFor(zoneId)

		-- земля
		fill(CF(0, -14, oz), V(LAND_HALF_X * 2, 20, W.ZoneSpacing), "Ground")
		fill(CF(0, -2, oz), V(LAND_HALF_X * 2, 4, W.ZoneSpacing), theme.Ground)

		-- дорожки
		local path = style.Path
		local hubZ = oz + W.HubZ
		fill(CF(0, -2, hubZ - 6), V(84, 4, 40), path) -- площадь базы
		fill(CF(0, -2, oz - 26), V(232, 4, 8), path) -- набережная (юг)
		fill(CF(0, -2, oz - 34), V(12, 4, 8), path)
		for _, bx in W.BridgeX do
			fill(CF(bx, -2, oz - 20), V(10, 4, 8), path)
			fill(CF(bx, -2, oz + 42), V(10, 4, 20), path)
		end
		fill(CF(0, -2, oz + 50), V(134, 4, 8), path) -- набережная (север)
		fill(CF(0, -2, oz + 76), V(14, 4, 52), path) -- дорога к воротам
		if zoneId > 1 then
			fill(CF(0, -2, oz - 89), V(14, 4, 24), path)
		end

		-- река (уходит в море с обеих сторон)
		local riverLen = LAND_HALF_X * 2 + 60
		fill(CF(0, -4, rz), V(riverLen - 20, 8, W.RiverWidth + 12), theme.Bank)
		fill(CF(0, -6, rz), V(riverLen, 12, W.RiverWidth), "Air")
		fill(CF(0, -14, rz), V(riverLen, 4, W.RiverWidth), theme.Bed)
		fill(CF(0, -7, rz), V(riverLen, 10, W.RiverWidth), "Water")
	end
end

----------------------------------------------------------------------
-- Стены, заборы, ворота
----------------------------------------------------------------------
local function invisibleWall(cframe: CFrame, size: Vector3)
	P(Folders.Walls, {
		Name = "InvisibleWall",
		Size = size,
		CFrame = cframe,
		Transparency = 1,
		CanCollide = true,
		CastShadow = false,
	})
end

local function fenceLine(fromPos: Vector3, toPos: Vector3, style, skip: (Vector3) -> boolean)
	local dir = toPos - fromPos
	local length = dir.Magnitude
	local steps = math.max(1, math.floor(length / 12))
	local prev: Vector3? = nil
	for i = 0, steps do
		local pos = fromPos + dir * (i / steps)
		if skip(pos) then
			prev = nil
		else
			P(Folders.Fences, {
				Name = "Post",
				Size = V(0.8, 4.2, 0.8),
				CFrame = CF(pos + V(0, 2.1, 0)),
				Material = style.FenceMat,
				Color = style.Fence,
			})
			if prev then
				local mid = (prev + pos) / 2
				local span = (pos - prev).Magnitude
				for _, h in { 1.6, 3.3 } do
					P(Folders.Fences, {
						Name = "Rail",
						Size = V(0.3, 0.4, span),
						CFrame = CFrame.lookAt(mid + V(0, h, 0), pos + V(0, h, 0)),
						Material = style.FenceMat,
						Color = style.Fence,
					})
				end
			end
			prev = pos
		end
	end
end

local function buildWalls()
	local count = #Config.Zones
	local firstZ = RiverMath.zoneOriginZ(1) - W.HalfDepth
	local lastZ = RiverMath.zoneOriginZ(count) + W.HalfDepth
	local midZ = (firstZ + lastZ) / 2
	local length = lastZ - firstZ

	invisibleWall(CF(-W.HalfWidth - 1, 40, midZ), V(2, 140, length + 4))
	invisibleWall(CF(W.HalfWidth + 1, 40, midZ), V(2, 140, length + 4))
	invisibleWall(CF(0, 40, firstZ - 1), V(W.HalfWidth * 2 + 4, 140, 2))
	invisibleWall(CF(0, 40, lastZ + 1), V(W.HalfWidth * 2 + 4, 140, 2))

	-- заборы по краям каждой зоны (с разрывом над рекой)
	for zoneId = 1, count do
		local oz = RiverMath.zoneOriginZ(zoneId)
		local rz = RiverMath.riverZ(zoneId)
		local style = styleFor(zoneId)
		local function overRiver(pos: Vector3)
			return math.abs(pos.Z - rz) < W.RiverWidth / 2 + 3
		end
		for _, side in { -1, 1 } do
			local x = side * (W.HalfWidth - 0.6)
			fenceLine(V(x, 0, oz - W.HalfDepth + 1), V(x, 0, oz + W.HalfDepth - 1), style, overRiver)
		end
		if zoneId == 1 then
			fenceLine(V(-W.HalfWidth + 1, 0, firstZ + 0.6), V(W.HalfWidth - 1, 0, firstZ + 0.6), style, function()
				return false
			end)
		end
		if zoneId == count then
			fenceLine(V(-W.HalfWidth + 1, 0, lastZ - 0.6), V(W.HalfWidth - 1, 0, lastZ - 0.6), style, function()
				return false
			end)
		end
	end
end

-- Ворота между зоной zoneId и следующей
local function buildGate(zoneId: number)
	local nextZone = zoneId + 1
	local zone = Config.Zones[nextZone]
	local z = RiverMath.zoneOriginZ(zoneId) + W.HalfDepth
	local style = styleFor(nextZone)
	local accent = zone.Theme.Accent
	local segLen = W.HalfWidth - W.GateWidth / 2

	local model = newModel("Gate_" .. nextZone, Folders.Gates)
	model:SetAttribute("Zone", nextZone)

	for _, side in { -1, 1 } do
		local cx = side * (W.GateWidth / 2 + segLen / 2)
		P(model, {
			Name = "Wall",
			Size = V(segLen, W.WallHeight, 3),
			CFrame = CF(cx, W.WallHeight / 2, z),
			Material = style.Wall,
			Color = style.WallColor,
		})
		P(model, {
			Name = "WallCap",
			Size = V(segLen, 1, 4),
			CFrame = CF(cx, W.WallHeight + 0.5, z),
			Material = style.Wall,
			Color = style.WallColor:Lerp(C(0, 0, 0), 0.25),
		})
		P(model, {
			Name = "WallBlock",
			Size = V(segLen, 110, 2),
			CFrame = CF(cx, W.WallHeight + 55, z),
			Transparency = 1,
			CastShadow = false,
		})
		local pillar = P(model, {
			Name = "Pillar",
			Size = V(4, W.WallHeight + 4, 4),
			CFrame = CF(side * (W.GateWidth / 2 + 2), (W.WallHeight + 4) / 2, z),
			Material = style.Wall,
			Color = style.WallColor:Lerp(C(255, 255, 255), 0.15),
		})
		P(model, {
			Name = "PillarLight",
			Shape = "Ball",
			Size = V(2.4, 2.4, 2.4),
			CFrame = CF(pillar.Position + V(0, (W.WallHeight + 4) / 2 + 1, 0)),
			Material = "Neon",
			Color = accent,
		})
	end

	local blocker = P(model, {
		Name = "Gate",
		Size = V(W.GateWidth, 130, 2),
		CFrame = CF(0, 45, z),
		Transparency = 1,
		CanCollide = true,
		CastShadow = false,
	})
	blocker:SetAttribute("Zone", nextZone)

	local field = P(model, {
		Name = "GateField",
		Size = V(W.GateWidth, W.WallHeight, 0.6),
		CFrame = CF(0, W.WallHeight / 2, z),
		Material = "ForceField",
		Color = C(255, 90, 90),
		CanCollide = false,
		CastShadow = false,
	})
	field:SetAttribute("Zone", nextZone)
	prompt(field, "Открыть зону", zone.Name, "Zones")

	local sign = P(model, {
		Name = "GateSign",
		Size = V(W.GateWidth + 6, 6, 1),
		CFrame = CF(0, W.WallHeight + 4, z),
		Material = "SmoothPlastic",
		Color = C(30, 36, 48),
	})
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		surface(sign, face, function(gui)
			label(gui, {
				Name = "Label",
				Text = string.format(
					"🔒 Зона %d: %s\n💰 %s монет",
					nextZone,
					zone.Name,
					Format.number(zone.Cost)
				),
				TextColor3 = accent,
			})
		end)
	end
end

----------------------------------------------------------------------
-- Начало и конец реки
----------------------------------------------------------------------
local function buildRiverEnds(zoneId: number)
	local rz = RiverMath.riverZ(zoneId)
	local model = newModel("RiverEnds_" .. zoneId, Folders.River)

	-- плотина с трубами (отсюда течёт мусор)
	P(model, {
		Name = "Dam",
		Size = V(6, 18, W.RiverWidth + 10),
		CFrame = CF(-W.HalfWidth - 3, 1, rz),
		Material = "Concrete",
		Color = C(150, 150, 150),
	})
	P(model, {
		Name = "DamTop",
		Size = V(7, 1, W.RiverWidth + 12),
		CFrame = CF(-W.HalfWidth - 3, 10.5, rz),
		Material = "Concrete",
		Color = C(120, 120, 120),
	})
	for _, dz in { -14, 0, 14 } do
		P(model, {
			Name = "Pipe",
			Shape = "Cylinder",
			Size = V(6, 8, 8),
			CFrame = CF(-W.HalfWidth + 1, 0, rz + dz),
			Material = "Metal",
			Color = C(110, 115, 120),
		})
		local mouth = P(model, {
			Name = "PipeMouth",
			Shape = "Cylinder",
			Size = V(0.2, 6.4, 6.4),
			CFrame = CF(-W.HalfWidth + 4.1, 0, rz + dz),
			Material = "SmoothPlastic",
			Color = C(25, 25, 28),
			CanCollide = false,
		})
		Util.create("ParticleEmitter", {
			Texture = "rbxasset://textures/particles/sparkles_main.dds",
			Rate = 18,
			Lifetime = NumberRange.new(0.5, 0.9),
			Speed = NumberRange.new(6, 10),
			SpreadAngle = Vector2.new(25, 25),
			EmissionDirection = Enum.NormalId.Right,
			Acceleration = V(0, -25, 0),
			Color = ColorSequence.new(C(235, 245, 255)),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0.1) }),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) }),
			Parent = mouth,
		})
	end

	-- решётка на выходе: сюда уплывает непойманный мусор
	local z0 = rz - W.RiverWidth / 2 + 1
	local bars = math.floor(W.RiverWidth / 2)
	for i = 0, bars - 1 do
		P(model, {
			Name = "Bar",
			Shape = "Cylinder",
			Size = V(16, 0.5, 0.5),
			CFrame = CF(W.HalfWidth - 3, -4, z0 + i * 2) * UP,
			Material = "Metal",
			Color = C(90, 95, 100),
			CanCollide = false,
		})
	end
	P(model, {
		Name = "GrateBeam",
		Size = V(1.2, 1.2, W.RiverWidth + 6),
		CFrame = CF(W.HalfWidth - 3, 4.5, rz),
		Material = "Metal",
		Color = C(70, 75, 80),
	})
end

----------------------------------------------------------------------
-- Мосты
----------------------------------------------------------------------
local function buildBridges(zoneId: number)
	local rz = RiverMath.riverZ(zoneId)
	local style = styleFor(zoneId)
	local length = W.RiverWidth + 14
	for _, bx in W.BridgeX do
		local model = newModel("Bridge", Folders.Bridges)
		P(model, {
			Name = "Deck",
			Size = V(10, 1, length),
			CFrame = CF(bx, 0.5, rz),
			Material = style.Bridge,
			Color = style.BridgeColor,
		})
		for _, side in { -1, 1 } do
			P(model, {
				Name = "Rail",
				Size = V(0.6, 0.6, length),
				CFrame = CF(bx + side * 4.7, 3.2, rz),
				Material = style.Bridge,
				Color = style.BridgeColor:Lerp(C(0, 0, 0), 0.2),
			})
			for i = -3, 3 do
				P(model, {
					Name = "Baluster",
					Size = V(0.4, 2.4, 0.4),
					CFrame = CF(bx + side * 4.7, 2, rz + i * (length / 7)),
					Material = style.Bridge,
					Color = style.BridgeColor:Lerp(C(0, 0, 0), 0.2),
				})
			end
			for _, dz in { -10, 10 } do
				P(model, {
					Name = "Pile",
					Shape = "Cylinder",
					Size = V(14, 1.2, 1.2),
					CFrame = CF(bx + side * 3.5, -6.5, rz + dz) * UP,
					Material = "Wood",
					Color = C(90, 65, 45),
				})
			end
		end
	end
end

----------------------------------------------------------------------
-- База зоны: переработка, ларьки
----------------------------------------------------------------------
local function buildSellPad(zoneId: number)
	local pos = RiverMath.sellPadPosition(zoneId)
	local model = newModel("SellStation_" .. zoneId, Folders.SellPads)
	local green = C(70, 215, 110)

	local pad = P(model, {
		Name = "SellPad",
		Size = V(14, 0.6, 14),
		CFrame = CF(pos + V(0, 0.3, 0)),
		Material = "SmoothPlastic",
		Color = C(50, 160, 85),
		CanTouch = true,
	})
	pad:SetAttribute("SellPad", true)
	pad:SetAttribute("Zone", zoneId)

	for _, edge in { { V(0, 0, 7), V(14.4, 0.7, 0.6) }, { V(0, 0, -7), V(14.4, 0.7, 0.6) }, { V(7, 0, 0), V(0.6, 0.7, 14.4) }, { V(-7, 0, 0), V(0.6, 0.7, 14.4) } } do
		P(model, {
			Name = "Border",
			Size = edge[2],
			CFrame = CF(pos + edge[1] + V(0, 0.35, 0)),
			Material = "Neon",
			Color = green,
			CanCollide = false,
		})
	end
	surface(pad, Enum.NormalId.Top, function(gui)
		label(gui, { Text = "♻️", TextTransparency = 0.15 })
	end)
	sparkleEmitter(pad, green, 4)
	billboard(pad, "♻️ ПЕРЕРАБОТКА", "Встань сюда — мусор продастся", green, 7)

	-- контейнеры для сортировки
	local bins = { C(60, 120, 220), C(240, 200, 50), C(70, 180, 90) }
	for i, color in bins do
		local bx = pos.X + (i - 2) * 4.2
		local bz = pos.Z - 10
		P(model, {
			Name = "Bin",
			Size = V(3.4, 4, 3.4),
			CFrame = CF(bx, 2, bz),
			Material = "SmoothPlastic",
			Color = color,
		})
		P(model, {
			Name = "BinLid",
			Size = V(3.7, 0.5, 3.7),
			CFrame = CF(bx, 4.25, bz) * ANG(R(-12), 0, 0),
			Material = "SmoothPlastic",
			Color = color:Lerp(C(0, 0, 0), 0.25),
		})
	end
	return pad
end

-- Ларёк с навесом и кнопкой E
local function buildStall(name: string, pos: Vector3, title: string, subtitle: string, accent: Color3, openUI: string, action: string)
	local model = newModel(name, Folders.Hubs)
	P(model, {
		Name = "Floor",
		Size = V(14, 0.4, 10),
		CFrame = CF(pos + V(0, 0.2, 0)),
		Material = "WoodPlanks",
		Color = C(160, 120, 80),
	})
	local counter = P(model, {
		Name = "Counter",
		Size = V(12, 3.5, 2),
		CFrame = CF(pos + V(0, 1.75, 4)),
		Material = "Wood",
		Color = C(130, 90, 55),
	})
	P(model, {
		Name = "CounterTop",
		Size = V(12.6, 0.4, 2.6),
		CFrame = CF(pos + V(0, 3.7, 4)),
		Material = "SmoothPlastic",
		Color = accent,
	})
	for _, x in { -6.5, 6.5 } do
		for _, z in { -4.5, 4.5 } do
			P(model, {
				Name = "Post",
				Shape = "Cylinder",
				Size = V(8, 0.8, 0.8),
				CFrame = CF(pos + V(x, 4, z)) * UP,
				Material = "Wood",
				Color = C(120, 85, 55),
			})
		end
	end
	P(model, {
		Name = "Roof",
		Size = V(16, 0.8, 12),
		CFrame = CF(pos + V(0, 8.4, 0)),
		Material = "SmoothPlastic",
		Color = accent:Lerp(C(0, 0, 0), 0.2),
	})
	for i = 0, 7 do
		P(model, {
			Name = "Awning",
			Size = V(2, 1.4, 0.4),
			CFrame = CF(pos + V(-7 + i * 2, 7.4, 6)),
			Material = "Fabric",
			Color = if i % 2 == 0 then accent else C(250, 250, 250),
			CanCollide = false,
		})
	end
	surface(counter, Enum.NormalId.Back, function(gui)
		label(gui, { Text = title, TextColor3 = accent })
	end)
	billboard(counter, title, subtitle, accent, 8)
	prompt(counter, action, title, openUI)
	return model
end

local function buildFactory(zoneId: number)
	local oz = RiverMath.zoneOriginZ(zoneId)
	local pos = V(-64, 0, oz - 74)
	local model = newModel("Factory", Folders.Hubs)
	local brick = C(170, 80, 60)
	P(model, { Name = "Body", Size = V(22, 12, 14), CFrame = CF(pos + V(0, 6, 0)), Material = "Brick", Color = brick })
	P(model, {
		Name = "Roof",
		Size = V(24, 1, 16),
		CFrame = CF(pos + V(0, 12.5, 0)),
		Material = "Metal",
		Color = C(80, 85, 90),
	})
	for i, x in { -6, 0, 6 } do
		local chimney = P(model, {
			Name = "Chimney",
			Shape = "Cylinder",
			Size = V(8 + i * 2, 2.6, 2.6),
			CFrame = CF(pos + V(x, 13 + (8 + i * 2) / 2, -3)) * UP,
			Material = "Brick",
			Color = brick:Lerp(C(0, 0, 0), 0.2),
		})
		smokeEmitter(chimney, C(220, 225, 230))
	end
	for i = -2, 2 do
		P(model, {
			Name = "Window",
			Size = V(2.4, 2.6, 0.2),
			CFrame = CF(pos + V(i * 4, 8, 7.05)),
			Material = "Neon",
			Color = C(255, 220, 120),
			CanCollide = false,
		})
	end
	P(model, {
		Name = "Door",
		Size = V(5, 6, 0.3),
		CFrame = CF(pos + V(0, 3, 7.1)),
		Material = "DiamondPlate",
		Color = C(90, 95, 100),
	})
	local panel = P(model, {
		Name = "Panel",
		Size = V(3, 4, 1.2),
		CFrame = CF(pos + V(6, 2, 9.5)),
		Material = "Metal",
		Color = C(60, 65, 75),
	})
	P(model, {
		Name = "PanelScreen",
		Size = V(2.4, 1.8, 0.1),
		CFrame = CF(pos + V(6, 2.8, 10.15)),
		Material = "Neon",
		Color = C(90, 255, 160),
		CanCollide = false,
	})
	billboard(panel, "🏭 ФАБРИКА", "Копит монеты, пока тебя нет", C(255, 200, 90), 9)
	prompt(panel, "Открыть фабрику", "Фабрика переработки", "Factory")
end

local function buildRebirthPortal(zoneId: number)
	local oz = RiverMath.zoneOriginZ(zoneId)
	local pos = V(64, 0, oz - 80)
	local model = newModel("RebirthPortal", Folders.Hubs)
	local purple = C(180, 90, 255)
	P(model, {
		Name = "Base",
		Shape = "Cylinder",
		Size = V(1, 16, 16),
		CFrame = CF(pos + V(0, 0.5, 0)) * UP,
		Material = "Slate",
		Color = C(60, 55, 80),
	})
	local center = pos + V(0, 8, 0)
	for i = 0, 15 do
		local a = R(i * 22.5)
		P(model, {
			Name = "Ring",
			Size = V(2.2, 1.2, 1.2),
			CFrame = CF(center + V(math.cos(a) * 6.5, math.sin(a) * 6.5, 0)) * ANG(0, 0, a + R(90)),
			Material = "Neon",
			Color = purple,
			CanCollide = false,
		})
	end
	local core = P(model, {
		Name = "Core",
		Shape = "Cylinder",
		Size = V(0.4, 12, 12),
		CFrame = CF(center) * ALONG_Z,
		Material = "ForceField",
		Color = purple,
		CanCollide = false,
	})
	sparkleEmitter(core, purple, 10)
	billboard(core, "🌀 ПЕРЕРОЖДЕНИЕ", "Начни заново с бонусом к монетам", purple, 9)
	prompt(core, "Перерождение", "Портал", "Rebirth")
end

local function buildLeaderboard(name: string, title: string, valueTitle: string, pos: Vector3, yaw: number, color: Color3)
	local model = newModel(name, Folders.Leaderboards)
	local cf = CF(pos) * ANG(0, yaw, 0)
	local board = P(model, {
		Name = "Board",
		Size = V(16, 20, 1),
		CFrame = cf * CF(0, 12, 0),
		Material = "SmoothPlastic",
		Color = C(28, 34, 46),
	})
	for _, x in { -7, 7 } do
		P(model, {
			Name = "Leg",
			Size = V(1, 4, 1),
			CFrame = cf * CF(x, 1, 0),
			Material = "Metal",
			Color = C(60, 65, 75),
		})
	end
	P(model, {
		Name = "Frame",
		Size = V(16.8, 0.8, 1.4),
		CFrame = cf * CF(0, 22.2, 0),
		Material = "Neon",
		Color = color,
	})
	surface(board, Enum.NormalId.Front, function(gui)
		gui.PixelsPerStud = 30
		local root = Util.create("Frame", {
			Name = "Root",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Parent = gui,
		})
		Util.create("UIPadding", {
			PaddingTop = UDim.new(0, 12),
			PaddingLeft = UDim.new(0, 16),
			PaddingRight = UDim.new(0, 16),
			Parent = root,
		})
		label(root, { Name = "Title", Text = title, TextColor3 = color, Size = UDim2.new(1, 0, 0, 60) })
		label(root, {
			Name = "Header",
			Text = "Игрок                    " .. valueTitle,
			Font = Enum.Font.GothamBold,
			TextColor3 = C(170, 180, 200),
			Size = UDim2.new(1, 0, 0, 26),
			Position = UDim2.fromOffset(0, 62),
		})
		for i = 1, 10 do
			local row = Util.create("Frame", {
				Name = "Row" .. i,
				BackgroundColor3 = if i % 2 == 0 then C(40, 48, 64) else C(34, 41, 56),
				Size = UDim2.new(1, 0, 0, 44),
				Position = UDim2.fromOffset(0, 94 + (i - 1) * 48),
				Parent = root,
			})
			Util.create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = row })
			local medal = if i == 1 then C(255, 205, 60) elseif i == 2 then C(210, 215, 225) elseif i == 3 then C(215, 140, 80) else C(200, 205, 215)
			label(row, { Name = "Rank", Text = "#" .. i, TextColor3 = medal, Size = UDim2.new(0.14, 0, 1, -8), Position = UDim2.fromOffset(4, 4) })
			label(row, {
				Name = "PlayerName",
				Text = "—",
				Font = Enum.Font.GothamBold,
				TextXAlignment = Enum.TextXAlignment.Left,
				Size = UDim2.new(0.56, 0, 1, -12),
				Position = UDim2.new(0.16, 0, 0, 6),
			})
			label(row, {
				Name = "Value",
				Text = "",
				TextColor3 = color,
				TextXAlignment = Enum.TextXAlignment.Right,
				Size = UDim2.new(0.26, 0, 1, -12),
				Position = UDim2.new(0.72, 0, 0, 6),
			})
		end
	end)
	return board
end

local function buildZoneSign(zoneId: number)
	local oz = RiverMath.zoneOriginZ(zoneId)
	local zone = Config.Zones[zoneId]
	local model = newModel("ZoneSign_" .. zoneId, Folders.Hubs)
	local pos = V(0, 0, oz - 34)
	for _, x in { -13, 13 } do
		P(model, {
			Name = "Post",
			Size = V(1.2, 13, 1.2),
			CFrame = CF(pos + V(x, 6.5, 0)),
			Material = "Wood",
			Color = C(110, 80, 50),
		})
	end
	local board = P(model, {
		Name = "Board",
		Size = V(28, 8, 0.8),
		CFrame = CF(pos + V(0, 10, 0)),
		Material = "SmoothPlastic",
		Color = C(28, 34, 46),
	})
	surface(board, Enum.NormalId.Front, function(gui)
		if zoneId == 1 then
			label(gui, {
				Text = "🌊 ЧИСТАЯ РЕКА",
				TextColor3 = zone.Theme.Accent,
				Size = UDim2.fromScale(1, 0.42),
			})
			label(gui, {
				Font = Enum.Font.GothamBold,
				Text = "1) Кликай по мусору в реке  2) Сдавай на ♻️ переработку\n3) Покупай улучшения 🛒  •  Здесь нет доната — всё за монеты!",
				Size = UDim2.fromScale(0.96, 0.5),
				Position = UDim2.fromScale(0.02, 0.46),
			})
		else
			label(gui, {
				Text = string.format("Зона %d • %s", zoneId, zone.Name),
				TextColor3 = zone.Theme.Accent,
				Size = UDim2.fromScale(1, 0.55),
			})
			label(gui, {
				Font = Enum.Font.GothamBold,
				Text = "Мусор здесь дороже. Удачной уборки!",
				Size = UDim2.fromScale(0.9, 0.34),
				Position = UDim2.fromScale(0.05, 0.6),
			})
		end
	end)
end

local function buildSpawn()
	local pos = RiverMath.hubPosition(1)
	local spawn = Util.create("SpawnLocation", {
		Name = "Spawn",
		Size = V(10, 1, 10),
		Anchored = true,
		Neutral = true,
		Duration = 0,
		Material = Enum.Material.SmoothPlastic,
		Color = Config.Zones[1].Theme.Accent,
		TopSurface = Enum.SurfaceType.Smooth,
		Parent = Map,
	})
	spawn.CFrame = CFrame.lookAt(pos + V(0, 0.5, 0), pos + V(0, 0.5, 10))
	for _, child in spawn:GetChildren() do
		if child:IsA("Decal") then
			child:Destroy()
		end
	end
end

local function buildHub(zoneId: number)
	local oz = RiverMath.zoneOriginZ(zoneId)
	local hubZ = oz + W.HubZ
	local zone = Config.Zones[zoneId]

	buildSellPad(zoneId)
	buildStall("ShopStall_" .. zoneId, V(26, 0, hubZ), "🛒 МАГАЗИН", "Сачки • Рюкзаки • Перки", C(90, 170, 255), "Shop", "Открыть магазин")
	buildZoneSign(zoneId)

	if zoneId == 1 then
		buildStall("HelpersStall", V(54, 0, hubZ - 8), "🐾 ПОМОЩНИКИ", "Ловят мусор за тебя", C(255, 170, 60), "Helpers", "Помощники")
		buildFactory(zoneId)
		buildRebirthPortal(zoneId)
		buildLeaderboard("TopTrash", "🏆 ТОП УБОРЩИКОВ", "Мусор", V(-92, 0, oz - 46), R(-90), C(110, 220, 120))
		buildLeaderboard("TopRebirth", "🌀 ТОП ПЕРЕРОЖДЕНИЙ", "Раз", V(92, 0, oz - 46), R(90), C(185, 110, 255))
	else
		buildStall("TeleportStall_" .. zoneId, V(54, 0, hubZ - 8), "🗺️ ТЕЛЕПОРТ", "Быстро в любую открытую зону", zone.Theme.Accent, "Teleport", "Телепорт")
	end
end

----------------------------------------------------------------------
-- Декорации
----------------------------------------------------------------------
local Decor = {}

function Decor.tree(parent, pos: Vector3, rng: Random, leaf: Color3, trunk: Color3, scale: number)
	local model = newModel("Tree", parent)
	local h = rng:NextNumber(7, 11) * scale
	P(model, {
		Name = "Trunk",
		Shape = "Cylinder",
		Size = V(h, 1.6 * scale, 1.6 * scale),
		CFrame = CF(pos + V(0, h / 2, 0)) * UP,
		Material = "Wood",
		Color = trunk,
	})
	for _ = 1, 3 do
		local s = rng:NextNumber(5.5, 8.5) * scale
		P(model, {
			Name = "Leaves",
			Shape = "Ball",
			Size = V(s, s, s),
			CFrame = CF(pos + V(rng:NextNumber(-2, 2) * scale, h + rng:NextNumber(-1, 2) * scale, rng:NextNumber(-2, 2) * scale)),
			Material = "Grass",
			Color = leaf:Lerp(C(255, 255, 200), rng:NextNumber(0, 0.12)),
			CanCollide = false,
		})
	end
end

function Decor.deadTree(parent, pos: Vector3, rng: Random, color: Color3)
	local model = newModel("DeadTree", parent)
	local h = rng:NextNumber(8, 13)
	P(model, {
		Name = "Trunk",
		Shape = "Cylinder",
		Size = V(h, 1.4, 1.4),
		CFrame = CF(pos + V(0, h / 2, 0)) * UP,
		Material = "Wood",
		Color = color,
	})
	for i = 1, 3 do
		local a = R(rng:NextNumber(0, 360))
		local len = rng:NextNumber(3, 5)
		local base = pos + V(0, h * (0.5 + i * 0.13), 0)
		local dir = V(math.cos(a), 0.8, math.sin(a)).Unit
		P(model, {
			Name = "Branch",
			Size = V(0.6, 0.6, len),
			CFrame = CFrame.lookAt(base + dir * len / 2, base + dir * len),
			Material = "Wood",
			Color = color,
			CanCollide = false,
		})
	end
end

function Decor.bush(parent, pos: Vector3, rng: Random, color: Color3)
	local model = newModel("Bush", parent)
	for _ = 1, 3 do
		local s = rng:NextNumber(2.4, 4)
		P(model, {
			Name = "Leaf",
			Shape = "Ball",
			Size = V(s, s, s),
			CFrame = CF(pos + V(rng:NextNumber(-1.5, 1.5), s * 0.35, rng:NextNumber(-1.5, 1.5))),
			Material = "Grass",
			Color = color:Lerp(C(0, 0, 0), rng:NextNumber(0, 0.2)),
			CanCollide = false,
		})
	end
end

function Decor.rock(parent, pos: Vector3, rng: Random, color: Color3)
	local s = rng:NextNumber(2, 5)
	P(parent, {
		Name = "Rock",
		Size = V(s * rng:NextNumber(1, 1.6), s * rng:NextNumber(0.6, 1), s),
		CFrame = CF(pos + V(0, s * 0.25, 0)) * ANG(R(rng:NextNumber(-15, 15)), R(rng:NextNumber(0, 360)), R(rng:NextNumber(-15, 15))),
		Material = "Slate",
		Color = color:Lerp(C(255, 255, 255), rng:NextNumber(0, 0.15)),
	})
end

function Decor.flowers(parent, pos: Vector3, rng: Random)
	local model = newModel("Flowers", parent)
	local colors = { C(255, 90, 120), C(255, 230, 80), C(170, 120, 255), C(255, 255, 255) }
	for _ = 1, 5 do
		local p = pos + V(rng:NextNumber(-2, 2), 0, rng:NextNumber(-2, 2))
		P(model, {
			Name = "Stem",
			Size = V(0.15, 1.2, 0.15),
			CFrame = CF(p + V(0, 0.6, 0)),
			Material = "Grass",
			Color = C(70, 150, 60),
			CanCollide = false,
		})
		P(model, {
			Name = "Bloom",
			Shape = "Ball",
			Size = V(0.6, 0.6, 0.6),
			CFrame = CF(p + V(0, 1.3, 0)),
			Material = "SmoothPlastic",
			Color = colors[rng:NextInteger(1, #colors)],
			CanCollide = false,
		})
	end
end

function Decor.lamp(parent, pos: Vector3, color: Color3)
	local model = newModel("Lamp", parent)
	P(model, {
		Name = "Pole",
		Shape = "Cylinder",
		Size = V(10, 0.5, 0.5),
		CFrame = CF(pos + V(0, 5, 0)) * UP,
		Material = "Metal",
		Color = C(45, 48, 55),
	})
	local bulb = P(model, {
		Name = "Bulb",
		Shape = "Ball",
		Size = V(1.4, 1.4, 1.4),
		CFrame = CF(pos + V(0, 10.4, 0)),
		Material = "Neon",
		Color = color,
		CanCollide = false,
	})
	Util.create("PointLight", { Color = color, Range = 16, Brightness = 1.2, Parent = bulb })
end

function Decor.bench(parent, pos: Vector3, yaw: number)
	local model = newModel("Bench", parent)
	local cf = CF(pos) * ANG(0, yaw, 0)
	local wood = C(150, 105, 65)
	P(model, { Name = "Seat", Size = V(5, 0.3, 1.4), CFrame = cf * CF(0, 1.4, 0), Material = "WoodPlanks", Color = wood })
	P(model, { Name = "Back", Size = V(5, 1.2, 0.25), CFrame = cf * CF(0, 2.3, 0.6), Material = "WoodPlanks", Color = wood })
	for _, x in { -2.1, 2.1 } do
		P(model, { Name = "Leg", Size = V(0.3, 1.3, 1.3), CFrame = cf * CF(x, 0.65, 0), Material = "Metal", Color = C(50, 50, 55) })
	end
end

function Decor.building(parent, pos: Vector3, rng: Random)
	local model = newModel("Building", parent)
	local w = rng:NextNumber(14, 20)
	local d = rng:NextNumber(14, 18)
	local h = rng:NextNumber(22, 42)
	local colors = { C(180, 110, 90), C(150, 160, 175), C(205, 190, 160), C(120, 135, 160), C(190, 150, 120) }
	local color = colors[rng:NextInteger(1, #colors)]
	P(model, { Name = "Body", Size = V(w, h, d), CFrame = CF(pos + V(0, h / 2, 0)), Material = "Concrete", Color = color })
	P(model, {
		Name = "Roof",
		Size = V(w + 1, 1, d + 1),
		CFrame = CF(pos + V(0, h + 0.5, 0)),
		Material = "Slate",
		Color = color:Lerp(C(0, 0, 0), 0.35),
	})
	local floors = math.floor(h / 6)
	for f = 1, floors do
		local y = f * 6 - 2
		for _, side in { -1, 1 } do
			P(model, {
				Name = "Windows",
				Size = V(w - 3, 2.2, 0.2),
				CFrame = CF(pos + V(0, y, side * (d / 2 + 0.1))),
				Material = if rng:NextNumber() < 0.35 then "Neon" else "Glass",
				Color = if rng:NextNumber() < 0.35 then C(255, 225, 150) else C(120, 170, 210),
				CanCollide = false,
			})
		end
	end
end

function Decor.car(parent, pos: Vector3, rng: Random, yaw: number)
	local model = newModel("Car", parent)
	local cf = CF(pos) * ANG(0, yaw, 0)
	local colors = { C(220, 60, 60), C(60, 120, 220), C(240, 200, 60), C(240, 240, 240), C(60, 60, 65) }
	local color = colors[rng:NextInteger(1, #colors)]
	P(model, { Name = "Body", Size = V(4.4, 1.6, 9), CFrame = cf * CF(0, 1.6, 0), Material = "SmoothPlastic", Color = color })
	P(model, { Name = "Cabin", Size = V(4, 1.4, 4.8), CFrame = cf * CF(0, 3.1, -0.4), Material = "Glass", Color = C(110, 150, 180), Transparency = 0.2 })
	for _, x in { -2.2, 2.2 } do
		for _, z in { -2.8, 2.8 } do
			P(model, {
				Name = "Wheel",
				Shape = "Cylinder",
				Size = V(0.8, 1.8, 1.8),
				CFrame = cf * CF(x, 0.9, z),
				Material = "SmoothPlastic",
				Color = C(25, 25, 25),
			})
		end
	end
end

function Decor.mushroom(parent, pos: Vector3, rng: Random)
	local model = newModel("Mushroom", parent)
	local s = rng:NextNumber(0.8, 1.6)
	P(model, {
		Name = "Stem",
		Shape = "Cylinder",
		Size = V(2 * s, 0.8 * s, 0.8 * s),
		CFrame = CF(pos + V(0, s, 0)) * UP,
		Material = "SmoothPlastic",
		Color = C(235, 225, 205),
	})
	P(model, {
		Name = "Cap",
		Shape = "Ball",
		Size = V(2.8 * s, 1.3 * s, 2.8 * s),
		CFrame = CF(pos + V(0, 2.1 * s, 0)),
		Material = "SmoothPlastic",
		Color = if rng:NextNumber() < 0.5 then C(210, 50, 50) else C(160, 90, 200),
		CanCollide = false,
	})
	for _ = 1, 3 do
		local a = R(rng:NextNumber(0, 360))
		P(model, {
			Name = "Spot",
			Shape = "Ball",
			Size = V(0.5 * s, 0.5 * s, 0.5 * s),
			CFrame = CF(pos + V(math.cos(a) * 0.8 * s, 2.55 * s, math.sin(a) * 0.8 * s)),
			Material = "SmoothPlastic",
			Color = C(255, 255, 255),
			CanCollide = false,
		})
	end
end

function Decor.reeds(parent, pos: Vector3, rng: Random)
	local model = newModel("Reeds", parent)
	for _ = 1, 6 do
		local h = rng:NextNumber(3, 5)
		local p = pos + V(rng:NextNumber(-1.5, 1.5), 0, rng:NextNumber(-1.5, 1.5))
		P(model, {
			Name = "Reed",
			Size = V(0.2, h, 0.2),
			CFrame = CF(p + V(0, h / 2 - 1, 0)) * ANG(R(rng:NextNumber(-8, 8)), 0, R(rng:NextNumber(-8, 8))),
			Material = "Grass",
			Color = C(120, 140, 60),
			CanCollide = false,
		})
		P(model, {
			Name = "Head",
			Size = V(0.4, 0.9, 0.4),
			CFrame = CF(p + V(0, h - 0.8, 0)),
			Material = "Fabric",
			Color = C(110, 70, 40),
			CanCollide = false,
		})
	end
end

function Decor.fireflies(parent, pos: Vector3, color: Color3)
	local holder = P(parent, {
		Name = "Fireflies",
		Size = V(14, 6, 14),
		CFrame = CF(pos + V(0, 4, 0)),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
	})
	Util.create("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
		Rate = 3,
		Lifetime = NumberRange.new(3, 5),
		Speed = NumberRange.new(0.3, 0.8),
		SpreadAngle = Vector2.new(180, 180),
		LightEmission = 1,
		Color = ColorSequence.new(color),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(0.5, 0.45), NumberSequenceKeypoint.new(1, 0) }),
		Parent = holder,
	})
end

function Decor.factoryBuilding(parent, pos: Vector3, rng: Random)
	local model = newModel("Plant", parent)
	local w = rng:NextNumber(18, 26)
	local h = rng:NextNumber(14, 22)
	P(model, { Name = "Hall", Size = V(w, h, 18), CFrame = CF(pos + V(0, h / 2, 0)), Material = "Concrete", Color = C(140, 140, 135) })
	P(model, {
		Name = "Stripe",
		Size = V(w + 0.2, 1.2, 18.2),
		CFrame = CF(pos + V(0, h - 3, 0)),
		Material = "SmoothPlastic",
		Color = C(235, 150, 50),
	})
	for i = 1, 2 do
		local ch = rng:NextNumber(14, 22)
		local chimney = P(model, {
			Name = "Chimney",
			Shape = "Cylinder",
			Size = V(ch, 3, 3),
			CFrame = CF(pos + V((i - 1.5) * w * 0.5, h + ch / 2, 3)) * UP,
			Material = "Brick",
			Color = C(150, 70, 55),
		})
		smokeEmitter(chimney, C(120, 120, 120))
	end
end

function Decor.pipes(parent, pos: Vector3, yaw: number)
	local model = newModel("Pipes", parent)
	local cf = CF(pos) * ANG(0, yaw, 0)
	for i = 0, 1 do
		P(model, {
			Name = "Pipe",
			Shape = "Cylinder",
			Size = V(16, 1.4, 1.4),
			CFrame = cf * CF(0, 1.6 + i * 1.6, 0),
			Material = "Metal",
			Color = if i == 0 then C(200, 120, 50) else C(90, 140, 190),
		})
	end
	for _, x in { -6, 6 } do
		P(model, { Name = "Support", Size = V(0.6, 3.6, 2.4), CFrame = cf * CF(x, 1.8, 0), Material = "Metal", Color = C(70, 70, 75) })
	end
end

function Decor.barrels(parent, pos: Vector3, rng: Random, color: Color3, glow: boolean)
	local model = newModel("Barrels", parent)
	for i = 1, rng:NextInteger(2, 4) do
		local p = pos + V(rng:NextNumber(-2.5, 2.5), 0, rng:NextNumber(-2.5, 2.5))
		P(model, {
			Name = "Barrel",
			Shape = "Cylinder",
			Size = V(3, 2.2, 2.2),
			CFrame = CF(p + V(0, 1.5, 0)) * UP * ANG(0, R(i * 40), 0),
			Material = "Metal",
			Color = color,
		})
		if glow then
			P(model, {
				Name = "Leak",
				Shape = "Cylinder",
				Size = V(0.15, 2.6, 2.6),
				CFrame = CF(p + V(1.2, 0.08, 0.6)) * UP,
				Material = "Neon",
				Color = C(120, 255, 70),
				CanCollide = false,
			})
		end
	end
end

function Decor.puddle(parent, pos: Vector3, rng: Random)
	local s = rng:NextNumber(4, 9)
	P(parent, {
		Name = "Puddle",
		Shape = "Cylinder",
		Size = V(0.12, s, s),
		CFrame = CF(pos + V(0, 0.06, 0)) * UP,
		Material = "Neon",
		Color = C(110, 255, 70),
		Transparency = 0.25,
		CanCollide = false,
	})
end

function Decor.warning(parent, pos: Vector3, yaw: number, text: string)
	local model = newModel("Warning", parent)
	local cf = CF(pos) * ANG(0, yaw, 0)
	P(model, { Name = "Post", Size = V(0.4, 5, 0.4), CFrame = cf * CF(0, 2.5, 0), Material = "Metal", Color = C(80, 80, 85) })
	local board = P(model, {
		Name = "Board",
		Size = V(4, 3, 0.3),
		CFrame = cf * CF(0, 5, 0),
		Material = "SmoothPlastic",
		Color = C(250, 210, 40),
	})
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		surface(board, face, function(gui)
			label(gui, { Text = text, TextColor3 = C(25, 25, 25), Size = UDim2.fromScale(0.9, 0.8), Position = UDim2.fromScale(0.05, 0.1) })
		end)
	end
end

function Decor.palm(parent, pos: Vector3, rng: Random)
	local model = newModel("Palm", parent)
	local lean = R(rng:NextNumber(6, 14))
	local yaw = R(rng:NextNumber(0, 360))
	local base = CF(pos) * ANG(0, yaw, 0)
	local top = pos
	for i = 0, 4 do
		local seg = base * ANG(lean * i * 0.35, 0, 0) * CF(0, i * 2.6 + 1.3, 0)
		P(model, {
			Name = "Trunk",
			Shape = "Cylinder",
			Size = V(2.8, 1.3 - i * 0.08, 1.3 - i * 0.08),
			CFrame = seg * UP,
			Material = "Wood",
			Color = C(150, 115, 75):Lerp(C(110, 85, 55), i / 4),
		})
		top = seg.Position + seg.UpVector * 1.3
	end
	for i = 0, 5 do
		local a = R(i * 60)
		local dir = V(math.cos(a), -0.35, math.sin(a)).Unit
		P(model, {
			Name = "Frond",
			Size = V(1.6, 0.15, 6),
			CFrame = CFrame.lookAt(top + dir * 3, top + dir * 6),
			Material = "Grass",
			Color = C(70, 160, 70),
			CanCollide = false,
		})
	end
	for i = 0, 2 do
		local a = R(i * 120 + 30)
		P(model, {
			Name = "Coconut",
			Shape = "Ball",
			Size = V(0.9, 0.9, 0.9),
			CFrame = CF(top + V(math.cos(a) * 0.7, -0.6, math.sin(a) * 0.7)),
			Material = "SmoothPlastic",
			Color = C(100, 70, 40),
			CanCollide = false,
		})
	end
end

function Decor.umbrella(parent, pos: Vector3, rng: Random)
	local model = newModel("BeachUmbrella", parent)
	local colors = { C(255, 90, 90), C(70, 160, 255), C(255, 210, 60), C(120, 220, 120) }
	P(model, {
		Name = "Pole",
		Shape = "Cylinder",
		Size = V(7, 0.3, 0.3),
		CFrame = CF(pos + V(0, 3.5, 0)) * UP,
		Material = "Metal",
		Color = C(230, 230, 230),
	})
	P(model, {
		Name = "Canopy",
		Shape = "Ball",
		Size = V(8, 1.6, 8),
		CFrame = CF(pos + V(0, 7, 0)),
		Material = "Fabric",
		Color = colors[rng:NextInteger(1, #colors)],
		CanCollide = false,
	})
	P(model, {
		Name = "Towel",
		Size = V(3, 0.1, 6),
		CFrame = CF(pos + V(2.5, 0.05, 0)) * ANG(0, R(rng:NextNumber(-20, 20)), 0),
		Material = "Fabric",
		Color = colors[rng:NextInteger(1, #colors)],
		CanCollide = false,
	})
end

function Decor.lighthouse(parent, pos: Vector3)
	local model = newModel("Lighthouse", parent)
	for i = 0, 5 do
		P(model, {
			Name = "Segment",
			Shape = "Cylinder",
			Size = V(6, 9 - i * 0.6, 9 - i * 0.6),
			CFrame = CF(pos + V(0, 3 + i * 6, 0)) * UP,
			Material = "SmoothPlastic",
			Color = if i % 2 == 0 then C(240, 240, 240) else C(220, 50, 50),
		})
	end
	local lamp = P(model, {
		Name = "Lamp",
		Shape = "Ball",
		Size = V(4, 4, 4),
		CFrame = CF(pos + V(0, 38, 0)),
		Material = "Neon",
		Color = C(255, 240, 160),
	})
	Util.create("PointLight", { Color = C(255, 240, 160), Range = 40, Brightness = 2, Parent = lamp })
	P(model, {
		Name = "Cap",
		Shape = "Cylinder",
		Size = V(1.5, 5, 5),
		CFrame = CF(pos + V(0, 40.8, 0)) * UP,
		Material = "Metal",
		Color = C(60, 60, 65),
	})
end

-- Места для декораций: не на дорожках, не у базы, не у реки
local function freeSpot(zoneId: number, x: number, z: number): boolean
	local oz = RiverMath.zoneOriginZ(zoneId)
	local rz = RiverMath.riverZ(zoneId)
	local localZ = z - oz
	if math.abs(z - rz) < W.RiverWidth / 2 + 5 then
		return false
	end
	if math.abs(localZ) > W.HalfDepth - 4 then
		return false
	end
	-- база
	local hubHalf = if zoneId == 1 then 100 else 46
	if math.abs(x) < hubHalf and localZ > -92 and localZ < -20 then
		return false
	end
	-- дорожки
	if math.abs(localZ + 26) < 6 or math.abs(localZ - 50) < 6 then
		return false
	end
	for _, bx in W.BridgeX do
		if math.abs(x - bx) < 8 and localZ < 56 then
			return false
		end
	end
	if math.abs(x) < 12 and localZ > 44 then
		return false
	end
	if math.abs(x) > W.HalfWidth - 4 then
		return false
	end
	return true
end

local function scatter(zoneId: number, rng: Random, count: number, minGap: number, placer: (Vector3) -> ())
	local oz = RiverMath.zoneOriginZ(zoneId)
	local placed: { Vector3 } = {}
	local tries = 0
	while #placed < count and tries < count * 30 do
		tries += 1
		local x = rng:NextNumber(-W.HalfWidth + 4, W.HalfWidth - 4)
		local z = oz + rng:NextNumber(-W.HalfDepth + 4, W.HalfDepth - 4)
		if freeSpot(zoneId, x, z) then
			local pos = V(x, 0, z)
			local ok = true
			for _, other in placed do
				if (other - pos).Magnitude < minGap then
					ok = false
					break
				end
			end
			if ok then
				table.insert(placed, pos)
				placer(pos)
			end
		end
	end
end

-- Полоса за забором (между стеной и морем) — для крупных декораций
local function outskirts(zoneId: number, rng: Random, count: number, placer: (Vector3, number) -> ())
	local oz = RiverMath.zoneOriginZ(zoneId)
	local rz = RiverMath.riverZ(zoneId)
	for i = 1, count do
		local side = if i % 2 == 0 then 1 else -1
		local z = oz + rng:NextNumber(-W.HalfDepth + 10, W.HalfDepth - 10)
		if math.abs(z - rz) > W.RiverWidth / 2 + 12 then
			local x = side * rng:NextNumber(W.HalfWidth + 8, LAND_HALF_X - 6)
			placer(V(x, 0, z), side)
		end
	end
end

local function decorateZone(zoneId: number)
	local zone = Config.Zones[zoneId]
	local theme = zone.Theme.Decor
	local rng = Random.new(zoneId * 7919)
	local folder = Instance.new("Folder")
	folder.Name = "Decor_" .. zoneId
	folder.Parent = Folders.Decor
	local oz = RiverMath.zoneOriginZ(zoneId)
	local rz = RiverMath.riverZ(zoneId)

	-- камыши вдоль берегов
	if theme == "Meadow" or theme == "Swamp" or theme == "Ocean" then
		for i = 1, 10 do
			local x = rng:NextNumber(-W.HalfWidth + 8, W.HalfWidth - 8)
			local side = if i % 2 == 0 then 1 else -1
			local z = rz + side * (W.RiverWidth / 2 + rng:NextNumber(1.5, 3.5))
			if math.abs(x - W.BridgeX[1]) > 9 and math.abs(x - W.BridgeX[2]) > 9 then
				Decor.reeds(folder, V(x, 0, z), rng)
			end
		end
	end

	if theme == "Meadow" then
		scatter(zoneId, rng, 26, 9, function(pos)
			local r = rng:NextNumber()
			if r < 0.4 then
				Decor.tree(folder, pos, rng, C(80, 170, 70), C(110, 80, 50), rng:NextNumber(0.9, 1.25))
			elseif r < 0.6 then
				Decor.bush(folder, pos, rng, C(70, 150, 60))
			elseif r < 0.8 then
				Decor.flowers(folder, pos, rng)
			else
				Decor.rock(folder, pos, rng, C(130, 130, 125))
			end
		end)
		outskirts(zoneId, rng, 14, function(pos)
			Decor.tree(folder, pos, rng, C(70, 160, 65), C(105, 75, 45), rng:NextNumber(1.1, 1.5))
		end)
		for _, x in { -40, 40 } do
			Decor.bench(folder, V(x, 0, oz - 21), R(180))
		end
	elseif theme == "City" then
		for x = -100, 100, 25 do
			if math.abs(x - W.BridgeX[1]) > 8 and math.abs(x - W.BridgeX[2]) > 8 then
				Decor.lamp(folder, V(x, 0, rz - W.RiverWidth / 2 - 4), C(255, 225, 160))
				Decor.lamp(folder, V(x, 0, rz + W.RiverWidth / 2 + 4), C(255, 225, 160))
			end
		end
		scatter(zoneId, rng, 14, 12, function(pos)
			local r = rng:NextNumber()
			if r < 0.4 then
				Decor.tree(folder, pos, rng, C(60, 140, 60), C(90, 65, 45), 0.9)
			elseif r < 0.7 then
				Decor.car(folder, pos, rng, R(rng:NextNumber(0, 360)))
			else
				Decor.bench(folder, pos, R(rng:NextNumber(0, 360)))
			end
		end)
		outskirts(zoneId, rng, 12, function(pos)
			Decor.building(folder, pos, rng)
		end)
	elseif theme == "Swamp" then
		scatter(zoneId, rng, 26, 9, function(pos)
			local r = rng:NextNumber()
			if r < 0.4 then
				Decor.deadTree(folder, pos, rng, C(70, 60, 45))
			elseif r < 0.7 then
				Decor.mushroom(folder, pos, rng)
			elseif r < 0.85 then
				Decor.bush(folder, pos, rng, C(70, 95, 50))
			else
				Decor.fireflies(folder, pos, C(210, 255, 120))
			end
		end)
		outskirts(zoneId, rng, 14, function(pos)
			Decor.deadTree(folder, pos, rng, C(60, 52, 40))
		end)
		for i = 1, 5 do
			Decor.fireflies(folder, V(-90 + i * 30, 0, rz), C(220, 255, 130))
		end
	elseif theme == "Industrial" then
		scatter(zoneId, rng, 16, 12, function(pos)
			local r = rng:NextNumber()
			if r < 0.4 then
				Decor.pipes(folder, pos, R(rng:NextNumber(0, 180)))
			elseif r < 0.75 then
				Decor.barrels(folder, pos, rng, C(60, 100, 160), false)
			else
				Decor.rock(folder, pos, rng, C(100, 100, 105))
			end
		end)
		outskirts(zoneId, rng, 8, function(pos)
			Decor.factoryBuilding(folder, pos, rng)
		end)
	elseif theme == "Toxic" then
		scatter(zoneId, rng, 24, 9, function(pos)
			local r = rng:NextNumber()
			if r < 0.35 then
				Decor.puddle(folder, pos, rng)
			elseif r < 0.6 then
				Decor.barrels(folder, pos, rng, C(230, 195, 40), true)
			elseif r < 0.8 then
				Decor.deadTree(folder, pos, rng, C(85, 85, 80))
			else
				Decor.warning(folder, pos, R(rng:NextNumber(0, 360)), "☢ ОПАСНО")
			end
		end)
		outskirts(zoneId, rng, 10, function(pos)
			Decor.factoryBuilding(folder, pos, rng)
		end)
		for i = 1, 5 do
			Decor.fireflies(folder, V(-90 + i * 30, -2, rz), C(130, 255, 90))
		end
	elseif theme == "Ocean" then
		scatter(zoneId, rng, 22, 10, function(pos)
			local r = rng:NextNumber()
			if r < 0.45 then
				Decor.palm(folder, pos, rng)
			elseif r < 0.7 then
				Decor.umbrella(folder, pos, rng)
			else
				Decor.rock(folder, pos, rng, C(170, 160, 140))
			end
		end)
		outskirts(zoneId, rng, 14, function(pos)
			Decor.palm(folder, pos, rng)
		end)
		Decor.lighthouse(folder, V(100, 0, oz + W.HalfDepth + 14))
	end
end

----------------------------------------------------------------------
-- Публичное API
----------------------------------------------------------------------
function WorldService.map(): Folder
	return Map
end

function WorldService.folder(name: string): Folder
	return Folders[name]
end

function WorldService:Init()
	local old = workspace:FindFirstChild("Map")
	if old then
		old:Destroy()
	end
	-- в новом месте Studio есть Baseplate — убираем, у нас свой остров
	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end

	Map = Instance.new("Folder")
	Map.Name = "Map"
	for _, name in { "Walls", "Fences", "Gates", "River", "Bridges", "SellPads", "Hubs", "Leaderboards", "Decor" } do
		local folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = Map
		Folders[name] = folder
	end

	setupLighting()
	buildTerrain()
	buildWalls()
	for zoneId = 1, #Config.Zones do
		buildRiverEnds(zoneId)
		buildBridges(zoneId)
		buildHub(zoneId)
		decorateZone(zoneId)
		if zoneId < #Config.Zones then
			buildGate(zoneId)
		end
	end
	Map.Parent = workspace
	buildSpawn()
end

return WorldService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">ZoneService</string>
            <string name="Source"><![CDATA[--[[
	ZoneService — зоны: покупка, телепорт, кто в какой зоне,
	и защита от прохода в закрытую зону (ворота открываются только на клиенте
	у того, кто зону купил, а сервер дополнительно проверяет позицию).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local RiverMath = require(Shared.RiverMath)

local ZoneService = {}

local Services
local playerZone: { [Player]: number } = {}
local lastWarn: { [Player]: number } = {}
local lastTeleport: { [Player]: number } = {}

local function rootOf(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function ZoneService.zoneOf(player: Player): number
	return playerZone[player] or 1
end

function ZoneService.playersIn(zoneId: number): { Player }
	local list = {}
	for player, zone in playerZone do
		if zone == zoneId and player.Parent then
			table.insert(list, player)
		end
	end
	return list
end

function ZoneService.teleport(player: Player, zoneId: number): boolean
	local character = player.Character
	local root = rootOf(player)
	if not character or not root then
		return false
	end
	local pos = RiverMath.hubPosition(zoneId) + Vector3.new(math.random(-3, 3), 4, math.random(-2, 2))
	character:PivotTo(CFrame.lookAt(pos, pos + Vector3.new(0, 0, 10)))
	playerZone[player] = zoneId
	player:SetAttribute("Zone", zoneId)
	local data = Services.DataService.get(player)
	if data then
		data.LastZone = zoneId
	end
	return true
end

function ZoneService:Init(services)
	Services = services
end

function ZoneService:Start()
	local Net = Services.NetService

	Net.on("BuyZone", function(player, data, zoneId)
		if type(zoneId) ~= "number" then
			return false
		end
		zoneId = math.floor(zoneId)
		local zone = Config.Zones[zoneId]
		if not zone then
			return false, "Такой зоны нет"
		end
		if zoneId <= data.MaxZone then
			return false, "Эта зона уже открыта"
		end
		if zoneId ~= data.MaxZone + 1 then
			return false, "Сначала открой предыдущую зону"
		end
		if data.Coins < zone.Cost then
			return false, "Не хватает монет: нужно ещё " .. Format.number(zone.Cost - data.Coins) .. " 💰"
		end
		data.Coins -= zone.Cost
		data.MaxZone = zoneId
		data.Tutorial.Bought = true
		Net.notifyAll(string.format("🎉 %s открывает зону «%s»!", player.DisplayName, zone.Name), "info")
		return true, "Зона «" .. zone.Name .. "» открыта! Проходи через ворота или жми 🗺️ Телепорт"
	end)

	Net.on("Teleport", function(player, data, zoneId)
		if type(zoneId) ~= "number" then
			return false
		end
		zoneId = math.floor(zoneId)
		if not Config.Zones[zoneId] then
			return false
		end
		if zoneId > data.MaxZone then
			return false, "Эта зона ещё закрыта 🔒"
		end
		local now = os.clock()
		if now - (lastTeleport[player] or 0) < 2 then
			return false, "Телепорт перезаряжается…"
		end
		lastTeleport[player] = now
		if not ZoneService.teleport(player, zoneId) then
			return false, "Персонаж ещё не появился"
		end
		return true, "🗺️ " .. Config.Zones[zoneId].Name
	end)

	Players.PlayerRemoving:Connect(function(player)
		playerZone[player] = nil
		lastWarn[player] = nil
		lastTeleport[player] = nil
	end)

	-- следим, кто где находится
	while true do
		task.wait(0.4)
		for _, player in Players:GetPlayers() do
			local data = Services.DataService.get(player)
			local root = rootOf(player)
			if data and root then
				local pos = root.Position
				local zone = RiverMath.zoneFromZ(pos.Z)
				if pos.Y < -70 then
					-- упал под карту
					ZoneService.teleport(player, math.min(data.LastZone, data.MaxZone))
				elseif zone > data.MaxZone then
					ZoneService.teleport(player, data.MaxZone)
					local now = os.clock()
					if now - (lastWarn[player] or 0) > 3 then
						lastWarn[player] = now
						Net.notify(player, "🔒 Эта зона ещё закрыта! Открой её в магазине (вкладка «Зоны»)", "error")
					end
				elseif zone ~= playerZone[player] then
					playerZone[player] = zone
					player:SetAttribute("Zone", zone)
					data.LastZone = zone
				end
			end
		end
	end
end

return ZoneService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="31">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="32">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="33">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="34">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--[[
	Чистая Река — точка входа клиента.
	Строит интерфейс и запускает контроллеры (анимация мусора, ловля, помощники,
	эффекты, зоны). Кнопки «E» у ларьков открывают нужные окна.
]]

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer

local State = require(script.State)
local ClientNet = require(script.ClientNet)
local Sounds = require(script.Sounds)

local Controllers = script:WaitForChild("Controllers")
local TrashAnimator = require(Controllers.TrashAnimator)
local CollectController = require(Controllers.CollectController)
local HelperRenderer = require(Controllers.HelperRenderer)
local Effects = require(Controllers.Effects)
local ZoneController = require(Controllers.ZoneController)

local UI = script:WaitForChild("UI")
local UIKit = require(UI.UIKit)
local Windows = require(UI.Windows)
local Notifications = require(UI.Notifications)
local Hud = require(UI.Hud)

local WINDOW_MODULES = {
	"ShopWindow",
	"HelpersWindow",
	"FactoryWindow",
	"BoostsWindow",
	"QuestsWindow",
	"CollectionWindow",
	"RebirthWindow",
	"TeleportWindow",
	"RewardsWindow",
	"SettingsWindow",
}

local function safe(name: string, fn: () -> ())
	local ok, err = pcall(fn)
	if not ok then
		warn("[Чистая Река] " .. name .. ": " .. tostring(err))
	end
end

-- Экран
local gui = Instance.new("ScreenGui")
gui.Name = "ChistayaRekaUI"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.IgnoreGuiInset = false
gui.Parent = player:WaitForChild("PlayerGui")

State.init()
UIKit.startScaling()
Notifications.init(gui)
ClientNet.setNotifier(Notifications.show)
CollectController.setNotifier(Notifications.show)
Windows.init(gui)

-- уведомления с сервера
local Remotes = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Remotes"))
Remotes.get("Notify").OnClientEvent:Connect(function(text, kind)
	Notifications.show(text, kind)
end)

safe("Sounds", Sounds.start)
safe("TrashAnimator", function()
	task.spawn(TrashAnimator.start)
end)
safe("HelperRenderer", HelperRenderer.start)
safe("Effects", Effects.start)
safe("ZoneController", ZoneController.start)
safe("CollectController", CollectController.start)

safe("Hud", function()
	Hud.build(gui)
end)
for _, name in WINDOW_MODULES do
	safe(name, function()
		require(UI:WaitForChild(name)).build()
	end)
end
safe("Windows", Windows.start)
safe("HudStart", Hud.start)

-- Кнопки «E» у ларьков, фабрики, портала и ворот
local PROMPT_WINDOWS = {
	Shop = { "Shop" },
	Zones = { "Shop", { tab = "Zones" } },
	Helpers = { "Helpers" },
	Factory = { "Factory" },
	Rebirth = { "Rebirth" },
	Teleport = { "Teleport" },
	Quests = { "Quests" },
}
ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
	if who ~= player then
		return
	end
	local target = PROMPT_WINDOWS[prompt:GetAttribute("OpenUI") or ""]
	if target then
		Windows.open(target[1], target[2])
	end
end)

-- Ежедневная награда сама открывается при входе
task.spawn(function()
	local data = State.waitReady()
	task.wait(3)
	local Formulas = require(game:GetService("ReplicatedStorage").Shared.Formulas)
	if Formulas.dailyStatus(data, State.now()) and not Windows.current() then
		Windows.open("Rewards")
	end
end)

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

print("[Чистая Река] Клиент запущен ✔")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">ClientNet</string>
            <string name="Source"><![CDATA[--[[
	ClientNet — запросы к серверу с показом ответа во всплывающем сообщении.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local ClientNet = {}

local RequestRemote = Remotes.get("Request")
local CollectRemote = Remotes.get("Collect")
local notifier: ((string, string) -> ())? = nil
local busy: { [string]: boolean } = {}

function ClientNet.setNotifier(fn: (string, string) -> ())
	notifier = fn
end

-- Возвращает (ok, сообщение). quiet = true — не показывать сообщение
function ClientNet.request(action: string, ...): (boolean, string?)
	if busy[action] then
		return false, nil
	end
	busy[action] = true
	local ok, result = pcall(RequestRemote.InvokeServer, RequestRemote, action, ...)
	busy[action] = nil
	if not ok then
		if notifier then
			notifier("Нет связи с сервером…", "error")
		end
		return false, nil
	end
	if type(result) ~= "table" then
		return false, nil
	end
	if result.msg and notifier then
		notifier(result.msg, if result.ok then "success" else "error")
	end
	return result.ok == true, result.msg
end

function ClientNet.quiet(action: string, ...): boolean
	local ok, result = pcall(RequestRemote.InvokeServer, RequestRemote, action, ...)
	return ok and type(result) == "table" and result.ok == true
end

function ClientNet.collect(id: number)
	CollectRemote:FireServer(id)
end

return ClientNet
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="36">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">CollectController</string>
              <string name="Source"><![CDATA[--[[
	CollectController — ловля мусора кликом мыши или касанием.
	• Клик по предмету — ловим. Промахнулся чуть-чуть — ловим ближайший к курсору.
	• Держишь кнопку — сачок машет сам с перезарядкой.
	• Кольцо на земле показывает дальность сачка.
	• Подсветка предмета под курсором (зелёная — достаёшь, красная — далеко).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Client = script.Parent.Parent
local ClientNet = require(Client.ClientNet)
local Sounds = require(Client.Sounds)
local State = require(Client.State)
local TrashAnimator = require(script.Parent.TrashAnimator)

local CollectController = {}

local player = Players.LocalPlayer

local holding = false
local activeInput: InputObject? = nil
local pointer: Vector2? = nil
local mousePos: Vector2? = nil
local nextSwing = 0
local lastWarn = 0
local highlight: Highlight
local ring: Model
local ringRange = 0
local ringParts: { BasePart } = {}
local statsCache = nil
local statsAt = 0

local SEGMENTS = 48
local GREEN = Color3.fromRGB(90, 255, 140)
local RED = Color3.fromRGB(255, 90, 90)

local notify: ((string, string) -> ())? = nil
function CollectController.setNotifier(fn)
	notify = fn
end

local function rootPart(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function stats()
	local now = os.clock()
	if not statsCache or now - statsAt > 0.25 then
		statsCache = State.stats()
		statsAt = now
	end
	return statsCache
end

local function warnOnce(text: string)
	local now = os.clock()
	if now - lastWarn > 2 then
		lastWarn = now
		if notify then
			notify(text, "error")
		end
	end
end

----------------------------------------------------------------------
-- Кольцо дальности
----------------------------------------------------------------------
local function buildRing(range: number)
	for _, part in ringParts do
		part:Destroy()
	end
	ringParts = {}
	local circumference = 2 * math.pi * range
	local segLen = circumference / SEGMENTS * 0.55
	for i = 0, SEGMENTS - 1 do
		local part = Instance.new("Part")
		part.Name = "Seg"
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Material = Enum.Material.Neon
		part.Color = GREEN
		part.Transparency = 0.45
		part.Size = Vector3.new(segLen, 0.12, 0.28)
		local a = i / SEGMENTS * math.pi * 2
		part.CFrame = CFrame.new(math.cos(a) * range, 0, math.sin(a) * range) * CFrame.Angles(0, -a + math.pi / 2, 0)
		part.Parent = ring
		table.insert(ringParts, part)
	end
	local center = Instance.new("Part")
	center.Name = "Center"
	center.Transparency = 1
	center.Anchored = true
	center.CanCollide = false
	center.CanQuery = false
	center.CanTouch = false
	center.Size = Vector3.new(0.2, 0.2, 0.2)
	center.CFrame = CFrame.identity
	center.Parent = ring
	ring.PrimaryPart = center
	table.insert(ringParts, center)
	ringRange = range
end

local function setRingColor(color: Color3)
	for _, part in ringParts do
		if part.Name == "Seg" then
			part.Color = color
		end
	end
end

local flashUntil = 0
local function flashRing()
	flashUntil = os.clock() + 0.5
	setRingColor(RED)
end

----------------------------------------------------------------------
-- Поиск цели
----------------------------------------------------------------------
local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Include

local function distanceTo(model: Model, root: BasePart): number
	local pos = TrashAnimator.position(model)
	if not pos then
		return math.huge
	end
	return Util.flatDistance(pos, root.Position)
end

-- Возвращает (модель, достаёт ли сачок)
local function findTarget(screenPos: Vector2, root: BasePart, range: number): (Model?, boolean)
	local camera = workspace.CurrentCamera
	local folder = TrashAnimator.folder()
	if not camera or not folder then
		return nil, false
	end

	raycastParams.FilterDescendantsInstances = { folder }
	local ray = camera:ScreenPointToRay(screenPos.X, screenPos.Y)
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 700, raycastParams)
	local direct = hit and TrashAnimator.modelOf(hit.Instance)
	if direct then
		return direct, distanceTo(direct, root) <= range + 1
	end

	-- промах: ищем ближайший к курсору предмет, до которого достаём
	local best: Model? = nil
	local bestScore = math.huge
	local maxPixels = if UserInputService.TouchEnabled then 90 else 65
	for model, info in TrashAnimator.tracked() do
		local pos = info.CFrame.Position
		if Util.flatDistance(pos, root.Position) <= range + 1 then
			local screen, onScreen = camera:WorldToScreenPoint(pos)
			if onScreen then
				local pixels = (Vector2.new(screen.X, screen.Y) - screenPos).Magnitude
				if pixels < maxPixels and pixels < bestScore then
					best = model
					bestScore = pixels
				end
			end
		end
	end
	return best, best ~= nil
end

local function tryCollect(screenPos: Vector2)
	local now = os.clock()
	if now < nextSwing then
		return
	end
	local data = State.Data
	local s = stats()
	local root = rootPart()
	if not data or not s or not root then
		return
	end

	local target, inRange = findTarget(screenPos, root, s.Range)
	if not target then
		return
	end
	if not inRange then
		flashRing()
		warnOnce("Далеко! 🥅 Подойди ближе или купи сачок длиннее")
		return
	end

	local zone = target:GetAttribute("Zone")
	if type(zone) == "number" and zone > data.MaxZone then
		return
	end

	local hasAutoSell = (data.Perks.AutoSell or 0) > 0 and data.Settings.AutoSell
	if data.InvSize >= s.Capacity and not hasAutoSell then
		flashRing()
		warnOnce(if (data.Perks.SellAnywhere or 0) > 0
			then "🎒 Рюкзак полон! Нажми «Продать»"
			else "🎒 Рюкзак полон! Беги на ♻️ переработку")
		nextSwing = now + 0.4
		return
	end

	local id = target:GetAttribute("Id")
	if type(id) == "number" then
		ClientNet.collect(id)
		nextSwing = now + s.Cooldown
		Sounds.play("Whoosh", 0.25, 1.2 + math.random() * 0.2)
	end
end

----------------------------------------------------------------------
-- Запуск
----------------------------------------------------------------------
function CollectController.start()
	ring = Instance.new("Model")
	ring.Name = "NetRange"
	ring.Parent = workspace

	highlight = Instance.new("Highlight")
	highlight.Name = "TrashHover"
	highlight.FillTransparency = 0.75
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Enabled = false
	highlight.Parent = workspace

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
			holding = true
			activeInput = input
			pointer = Vector2.new(input.Position.X, input.Position.Y)
			tryCollect(pointer)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseMovement then
			mousePos = Vector2.new(input.Position.X, input.Position.Y)
			if holding then
				pointer = mousePos
			end
		elseif kind == Enum.UserInputType.Touch and input == activeInput then
			pointer = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 or (kind == Enum.UserInputType.Touch and input == activeInput) then
			holding = false
			activeInput = nil
		end
	end)

	RunService.RenderStepped:Connect(function()
		local s = stats()
		local root = rootPart()
		local data = State.Data
		if not s or not root or not data then
			ring.Parent = nil
			highlight.Enabled = false
			return
		end

		-- кольцо дальности
		if State.setting("ShowRange") then
			if math.abs(ringRange - s.Range) > 0.01 then
				buildRing(s.Range)
			end
			ring.Parent = workspace
			local y = root.Position.Y - 2.8
			local overWater = root.Position.Y < Config.World.WaterY + 4
			if overWater then
				y = math.max(y, Config.World.WaterY + 0.15)
			end
			ring:PivotTo(CFrame.new(root.Position.X, y, root.Position.Z))
			if flashUntil > 0 and os.clock() > flashUntil then
				flashUntil = 0
				setRingColor(GREEN)
			end
		else
			ring.Parent = nil
		end

		-- подсветка под курсором (только мышь)
		if mousePos and UserInputService.MouseEnabled then
			local target, inRange = findTarget(mousePos, root, s.Range)
			if target then
				highlight.Adornee = target
				highlight.OutlineColor = if inRange then GREEN else RED
				highlight.FillColor = if inRange then GREEN else RED
				highlight.Enabled = true
			else
				highlight.Enabled = false
			end
		else
			highlight.Enabled = false
		end

		-- удержание кнопки = непрерывная ловля
		if holding and pointer then
			tryCollect(pointer)
		end
	end)
end

return CollectController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--[[
	Effects — брызги, мусор летит в рюкзак, всплывающие подписи, монеты при продаже.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local TrashModels = require(Shared.TrashModels)

local Client = script.Parent.Parent
local State = require(Client.State)
local Sounds = require(Client.Sounds)
local HelperRenderer = require(script.Parent.HelperRenderer)

local Effects = {}

local player = Players.LocalPlayer
local fxFolder: Folder
local activeFx = 0
local MAX_FX = 24

local function effectsOn(): boolean
	return State.setting("Effects")
end

local function rootOf(p: Player?): BasePart?
	local character = p and p.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function holder(pos: Vector3): Part
	local part = Instance.new("Part")
	part.Name = "Fx"
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CFrame = CFrame.new(pos)
	part.Parent = fxFolder
	return part
end

function Effects.splash(pos: Vector3, color: Color3?)
	if not effectsOn() then
		return
	end
	local part = holder(Vector3.new(pos.X, Config.World.WaterY + 0.2, pos.Z))
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.35, 0.6)
	emitter.Speed = NumberRange.new(7, 12)
	emitter.SpreadAngle = Vector2.new(35, 35)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Acceleration = Vector3.new(0, -40, 0)
	emitter.Color = ColorSequence.new(color or Color3.fromRGB(200, 235, 255))
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 0.1) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	emitter.Parent = part
	emitter:Emit(14)
	task.delay(1.2, function()
		part:Destroy()
	end)
end

-- Подпись, которая всплывает и тает
function Effects.popup(pos: Vector3, text: string, color: Color3, big: boolean?)
	if not effectsOn() then
		return
	end
	local part = holder(pos + Vector3.new(0, 2, 0))
	local gui = Instance.new("BillboardGui")
	gui.Size = if big then UDim2.fromOffset(320, 60) else UDim2.fromOffset(240, 40)
	gui.StudsOffset = Vector3.new(0, 0, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 150
	gui.Adornee = part
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Color = Color3.fromRGB(15, 20, 30)
	stroke.Parent = label

	local info = TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(gui, info, { StudsOffset = Vector3.new(0, 3.5, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 }):Play()
	TweenService:Create(stroke, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1 }):Play()
	task.delay(1.2, function()
		part:Destroy()
	end)
end

-- Предмет вылетает из воды и летит к персонажу
local function flyTo(key: string, from: Vector3, owner: Player, delay: number, shiny: boolean)
	if activeFx >= MAX_FX or not effectsOn() then
		return
	end
	local root = rootOf(owner)
	if not root then
		return
	end
	activeFx += 1
	local model = TrashModels.build(key)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanQuery = false
		end
	end
	if shiny then
		local sparkles = Instance.new("ParticleEmitter")
		sparkles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		sparkles.Rate = 30
		sparkles.Lifetime = NumberRange.new(0.3, 0.6)
		sparkles.Speed = NumberRange.new(1, 3)
		sparkles.SpreadAngle = Vector2.new(180, 180)
		sparkles.LightEmission = 1
		sparkles.Color = ColorSequence.new(Color3.fromRGB(255, 240, 150))
		sparkles.Parent = model.PrimaryPart
	end
	model:PivotTo(CFrame.new(from))
	model.Parent = fxFolder

	local started = os.clock()
	local duration = 0.5
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local a = (os.clock() - started - delay) / duration
		if a < 0 then
			return
		end
		local target = rootOf(owner)
		if a >= 1 or not target then
			connection:Disconnect()
			model:Destroy()
			activeFx -= 1
			return
		end
		local goal = target.Position + Vector3.new(0, 0.5, 0)
		local mid = (from + goal) / 2 + Vector3.new(0, 6, 0)
		local p = from:Lerp(mid, a):Lerp(mid:Lerp(goal, a), a)
		model:PivotTo(CFrame.new(p) * CFrame.Angles(a * 5, a * 3.5, 0))
		pcall(function()
			model:ScaleTo(math.max(0.08, 1 - a * 0.85))
		end)
	end)
end

local function onCollect(userId: number, key: string, pos: Vector3, shiny: boolean, helperIndex: number)
	local def = Config.Trash[key]
	if not def or typeof(pos) ~= "Vector3" then
		return
	end
	local owner = Players:GetPlayerByUserId(userId)
	local mine = owner == player
	local camera = workspace.CurrentCamera
	local near = camera and (camera.CFrame.Position - pos).Magnitude < 160

	if near or mine then
		Effects.splash(pos)
	end
	local delay = 0
	if owner and helperIndex > 0 then
		HelperRenderer.dart(owner, helperIndex, pos)
		delay = HelperRenderer.dartTime() * 0.5
	end
	if owner and (mine or near) then
		flyTo(key, pos, owner, delay, shiny)
	end

	if mine then
		local rarity = Config.Rarities[def.Rarity]
		local pitch = 1 + (rarity.Order - 1) * 0.08 + math.random() * 0.08
		Sounds.play("Collect", 0.35, if shiny then 1.5 else pitch)
		local text = "+ " .. def.Name
		if shiny then
			text = "✨ " .. def.Name .. " ✨"
		end
		Effects.popup(pos, text, if shiny then Color3.fromRGB(255, 240, 140) else rarity.Color, shiny or rarity.Order >= 4)
		State.Collected:Fire(key, shiny)
	end
end

local function onSell(coins: number, items: number)
	Sounds.play("Sell", 0.6, 1.2)
	State.Sold:Fire(coins, items)
	local root = rootOf(player)
	if root and effectsOn() then
		local part = holder(root.Position)
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emitter.Rate = 0
		emitter.Lifetime = NumberRange.new(0.6, 1)
		emitter.Speed = NumberRange.new(10, 16)
		emitter.SpreadAngle = Vector2.new(60, 60)
		emitter.EmissionDirection = Enum.NormalId.Top
		emitter.Acceleration = Vector3.new(0, -30, 0)
		emitter.LightEmission = 0.8
		emitter.Color = ColorSequence.new(Color3.fromRGB(255, 210, 60))
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0.2) })
		emitter.Parent = part
		emitter:Emit(30)
		task.delay(1.5, function()
			part:Destroy()
		end)
	end
end

function Effects.start()
	fxFolder = Instance.new("Folder")
	fxFolder.Name = "LocalEffects"
	fxFolder.Parent = workspace

	Remotes.get("Effect").OnClientEvent:Connect(function(kind, ...)
		if kind == "collect" then
			onCollect(...)
		elseif kind == "sell" then
			onSell(...)
		end
	end)
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">HelperRenderer</string>
              <string name="Source"><![CDATA[--[[
	HelperRenderer — рисует помощников всех игроков: они кружат вокруг хозяина
	и «бросаются» к мусору, когда ловят его.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local HelperModels = require(Shared.HelperModels)

local HelperRenderer = {}

type Rig = {
	Key: string,
	Models: { Model },
	Darts: { [number]: { Target: Vector3, Start: number } },
	LastPos: { [number]: Vector3 },
}

local rigs: { [Player]: Rig } = {}
local folder: Folder

local DART_TIME = 0.55

local function clear(rig: Rig)
	for _, model in rig.Models do
		model:Destroy()
	end
	rig.Models = {}
	rig.Darts = {}
	rig.LastPos = {}
end

local function rebuild(player: Player)
	local attr = player:GetAttribute("Helpers")
	local key = if type(attr) == "string" then attr else ""
	local rig = rigs[player]
	if rig and rig.Key == key then
		return
	end
	if not rig then
		rig = { Key = key, Models = {}, Darts = {}, LastPos = {} }
		rigs[player] = rig
	end
	clear(rig)
	rig.Key = key
	for helperKey in string.gmatch(key, "[^,]+") do
		if HelperModels.has(helperKey) then
			local model = HelperModels.build(helperKey)
			model.Parent = folder
			table.insert(rig.Models, model)
		end
	end
end

local function watch(player: Player)
	rebuild(player)
	player:GetAttributeChangedSignal("Helpers"):Connect(function()
		rebuild(player)
	end)
end

-- Помощник index игрока player летит к точке target
function HelperRenderer.dart(player: Player, index: number, target: Vector3)
	local rig = rigs[player]
	if rig and rig.Models[index] then
		rig.Darts[index] = { Target = target, Start = os.clock() }
	end
end

function HelperRenderer.dartTime(): number
	return DART_TIME
end

local function smooth(x: number): number
	return x * x * (3 - 2 * x)
end

function HelperRenderer.start()
	folder = Instance.new("Folder")
	folder.Name = "LocalHelpers"
	folder.Parent = workspace

	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(function(player)
		local rig = rigs[player]
		if rig then
			clear(rig)
			rigs[player] = nil
		end
	end)
	for _, player in Players:GetPlayers() do
		watch(player)
	end

	local hidden = CFrame.new(0, -500, 0)
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		for player, rig in rigs do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local count = #rig.Models
			for i, model in rig.Models do
				if not root then
					model:PivotTo(hidden)
					continue
				end
				local angle = t * 0.9 + (i - 1) * (math.pi * 2 / count)
				local radius = 4 + count * 0.45
				local base = root.Position
					+ Vector3.new(math.cos(angle) * radius, 2.3 + math.sin(t * 2.6 + i) * 0.35, math.sin(angle) * radius)
				local pos = base
				local dart = rig.Darts[i]
				if dart then
					local a = (t - dart.Start) / DART_TIME
					if a >= 1 then
						rig.Darts[i] = nil
					else
						local k = if a < 0.5 then a * 2 else (1 - a) * 2
						pos = base:Lerp(dart.Target + Vector3.new(0, 1.2, 0), smooth(k))
					end
				end
				local last = rig.LastPos[i] or pos
				rig.LastPos[i] = pos
				local dir = pos - last
				local forward
				if dir.Magnitude > 0.02 then
					forward = Vector3.new(dir.X, 0, dir.Z)
				else
					forward = root.CFrame.LookVector
				end
				if forward.Magnitude < 1e-3 then
					forward = Vector3.new(0, 0, -1)
				end
				model:PivotTo(CFrame.lookAt(pos, pos + forward.Unit))
			end
		end
	end)
end

return HelperRenderer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">TrashAnimator</string>
              <string name="Source"><![CDATA[--[[
	TrashAnimator — плавно двигает мусор по реке на клиенте.
	Сервер ставит модель один раз, а дальше клиент считает позицию по той же
	формуле (RiverMath), что и сервер, — без лагов и лишнего трафика.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local RiverMath = require(Shared.RiverMath)

local TrashAnimator = {}

type Info = {
	Model: Model,
	Origin: Vector3,
	Vel: Vector3,
	T0: number,
	Seed: number,
	Pivot0: CFrame,
	Parts: { BasePart },
	Offsets: { CFrame },
	CFrame: CFrame,
	Phase: number,
}

local tracked: { [Model]: Info } = {}
local folder: Folder? = nil
local frame = 0

local function addPart(info: Info, part: Instance)
	if part:IsA("BasePart") and not table.find(info.Parts, part) then
		table.insert(info.Parts, part)
		table.insert(info.Offsets, info.Pivot0:ToObjectSpace(part.CFrame))
	end
end

local function track(model: Instance)
	if not model:IsA("Model") or tracked[model] then
		return
	end
	local origin = model:GetAttribute("Origin")
	local vel = model:GetAttribute("Vel")
	local t0 = model:GetAttribute("T0")
	local seed = model:GetAttribute("Seed")
	local pivot0 = model:GetAttribute("Pivot0")
	if typeof(origin) ~= "Vector3" or typeof(vel) ~= "Vector3" or typeof(pivot0) ~= "CFrame" then
		return
	end
	local info: Info = {
		Model = model,
		Origin = origin,
		Vel = vel,
		T0 = t0 or 0,
		Seed = seed or 0,
		Pivot0 = pivot0,
		Parts = {},
		Offsets = {},
		CFrame = pivot0,
		Phase = math.random(0, 11),
	}
	for _, d in model:GetDescendants() do
		addPart(info, d)
	end
	model.DescendantAdded:Connect(function(d)
		addPart(info, d)
	end)
	tracked[model] = info
end

function TrashAnimator.tracked(): { [Model]: Info }
	return tracked
end

function TrashAnimator.folder(): Folder?
	return folder
end

-- Текущая позиция предмета (как её видит игрок)
function TrashAnimator.position(model: Model): Vector3?
	local info = tracked[model]
	return info and info.CFrame.Position or nil
end

-- По детали находим модель мусора
function TrashAnimator.modelOf(part: Instance?): Model?
	local f = folder
	if not part or not f then
		return nil
	end
	local current: Instance? = part
	while current and current.Parent ~= f do
		current = current.Parent
	end
	if current and current:IsA("Model") then
		return current
	end
	return nil
end

function TrashAnimator.start()
	local f = workspace:WaitForChild("Trash") :: Folder
	folder = f
	f.ChildAdded:Connect(track)
	f.ChildRemoved:Connect(function(child)
		tracked[child :: Model] = nil
	end)
	for _, child in f:GetChildren() do
		track(child)
	end

	RunService.RenderStepped:Connect(function()
		frame += 1
		local t = workspace:GetServerTimeNow()
		local camera = workspace.CurrentCamera
		local camPos = if camera then camera.CFrame.Position else Vector3.zero
		local parts: { BasePart } = {}
		local cframes: { CFrame } = {}
		for model, info in tracked do
			if model.Parent then
				local far = (info.CFrame.Position - camPos).Magnitude > 350
				if not far or (frame + info.Phase) % 12 == 0 then
					local cf = RiverMath.trashCFrame(info.Origin, info.Vel, info.T0, info.Seed, t)
					info.CFrame = cf
					for i, part in info.Parts do
						if part.Parent then
							table.insert(parts, part)
							table.insert(cframes, cf * info.Offsets[i])
						end
					end
				end
			end
		end
		if #parts > 0 then
			workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
		end
	end)
end

return TrashAnimator
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">ZoneController</string>
              <string name="Source"><![CDATA[--[[
	ZoneController — всё, что связано с зонами на клиенте:
	• открывает ворота купленных зон (только для тебя);
	• меняет цвет воды: чем больше мусора, тем грязнее река;
	• туман по теме зоны;
	• «Водомерка» — ходьба по воде;
	• сигнал о смене зоны (для баннера).
]]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local RiverMath = require(Shared.RiverMath)
local Signal = require(Shared.Signal)

local Client = script.Parent.Parent
local State = require(Client.State)

local ZoneController = {}
ZoneController.ZoneChanged = Signal.new() -- (zoneId)

local player = Players.LocalPlayer
local currentZone = 0
local platform: Part
local lastWater: Color3? = nil

function ZoneController.current(): number
	return math.max(1, currentZone)
end

local function rootPart(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function updateGates()
	local data = State.Data
	local map = workspace:FindFirstChild("Map")
	local gates = map and map:FindFirstChild("Gates")
	if not data or not gates then
		return
	end
	for _, gate in gates:GetChildren() do
		local zoneId = gate:GetAttribute("Zone")
		local zone = type(zoneId) == "number" and Config.Zones[zoneId]
		if zone then
			local open = zoneId <= data.MaxZone
			local blocker = gate:FindFirstChild("Gate") :: BasePart?
			local field = gate:FindFirstChild("GateField") :: BasePart?
			local sign = gate:FindFirstChild("GateSign")
			if blocker then
				blocker.CanCollide = not open
			end
			if field then
				field.Transparency = if open then 1 else 0
				local prompt = field:FindFirstChildOfClass("ProximityPrompt")
				if prompt then
					prompt.Enabled = not open
				end
			end
			if sign then
				for _, gui in sign:GetChildren() do
					local label = gui:FindFirstChild("Label") :: TextLabel?
					if label then
						if open then
							label.Text = string.format("✅ Зона %d: %s", zoneId, zone.Name)
						elseif zoneId == data.MaxZone + 1 then
							label.Text = string.format("🔒 Зона %d: %s\n💰 %s монет", zoneId, zone.Name, Format.number(zone.Cost))
						else
							label.Text = string.format("🔒 Зона %d: %s\nсначала открой зону %d", zoneId, zone.Name, zoneId - 1)
						end
					end
				end
			end
		end
	end
end

local function updateEnvironment(zoneId: number)
	local zone = Config.Zones[zoneId]
	local pollution = ReplicatedStorage:GetAttribute("Pollution" .. zoneId) or 0.5
	local color = zone.Theme.WaterClean:Lerp(zone.Theme.WaterDirty, math.clamp(pollution, 0, 1))
	local terrain = workspace.Terrain
	local previous = lastWater
	local changed = previous == nil
		or math.abs(previous.R - color.R) + math.abs(previous.G - color.G) + math.abs(previous.B - color.B) > 0.01
	if changed then
		lastWater = color
		TweenService:Create(terrain, TweenInfo.new(1.5), { WaterColor = color }):Play()
	end
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		TweenService:Create(atmosphere, TweenInfo.new(2), { Density = zone.Theme.Fog }):Play()
	end
end

function ZoneController.start()
	platform = Instance.new("Part")
	platform.Name = "WaterWalk"
	platform.Size = Vector3.new(9, 1, 9)
	platform.Transparency = 1
	platform.Anchored = true
	platform.CanCollide = true
	platform.CanQuery = false
	platform.CanTouch = false
	platform.CastShadow = false

	State.Changed:Connect(updateGates)
	task.spawn(function()
		local map = workspace:WaitForChild("Map")
		map:WaitForChild("Gates")
		State.waitReady()
		updateGates()
	end)

	-- текущая зона и окружение
	task.spawn(function()
		local tick = 0
		while true do
			task.wait(0.25)
			tick += 1
			local root = rootPart()
			if root then
				local zone = RiverMath.zoneFromZ(root.Position.Z)
				if zone ~= currentZone then
					currentZone = zone
					ZoneController.ZoneChanged:Fire(zone)
					updateEnvironment(zone)
				elseif tick % 8 == 0 then
					updateEnvironment(zone)
				end
			end
		end
	end)

	-- ходьба по воде
	RunService.Heartbeat:Connect(function()
		local data = State.Data
		local root = rootPart()
		local enabled = data and (data.Perks.WaterWalk or 0) > 0 and data.Settings.WaterWalk
		if not enabled or not root then
			platform.Parent = nil
			return
		end
		local over = RiverMath.isOverRiver(root.Position, 2)
		local waterY = Config.World.WaterY
		if over and root.Position.Y > waterY + 1.3 then
			platform.CFrame = CFrame.new(root.Position.X, waterY - 0.15, root.Position.Z)
			platform.Parent = workspace
		else
			platform.Parent = nil
		end
	end)
end

return ZoneController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Sounds</string>
            <string name="Source"><![CDATA[--[[
	Sounds — звуки и музыка (выключаются в настройках).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local State = require(script.Parent.State)

local Sounds = {}

local cache: { [string]: Sound } = {}
local music: Sound? = nil

local function get(name: string): Sound?
	local id = Config.Sounds[name]
	if not id or id == "" then
		return nil
	end
	local sound = cache[name]
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = "Sfx_" .. name
		sound.SoundId = id
		sound.Parent = SoundService
		cache[name] = sound
	end
	return sound
end

function Sounds.play(name: string, volume: number?, pitch: number?)
	if not State.setting("Sounds") then
		return
	end
	local sound = get(name)
	if not sound then
		return
	end
	sound.Volume = volume or 0.5
	sound.PlaybackSpeed = pitch or 1
	SoundService:PlayLocalSound(sound)
end

function Sounds.updateMusic()
	if Config.Sounds.Music == "" then
		return
	end
	if not music then
		local m = Instance.new("Sound")
		m.Name = "Music"
		m.SoundId = Config.Sounds.Music
		m.Looped = true
		m.Volume = 0.25
		m.Parent = SoundService
		music = m
	end
	local sound = music :: Sound
	if State.setting("Music") then
		if not sound.IsPlaying then
			sound:Play()
		end
	elseif sound.IsPlaying then
		sound:Stop()
	end
end

function Sounds.start()
	State.Changed:Connect(Sounds.updateMusic)
end

return Sounds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--[[
	State — данные игрока на клиенте (присылает сервер) и общие сигналы.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Formulas = require(Shared.Formulas)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Signal)

local State = {}

State.Data = nil :: any
State.Meta = {} :: { [string]: any }
State.Changed = Signal.new() -- (data, oldData)
State.Sold = Signal.new() -- (coins, items)
State.Collected = Signal.new() -- (key, shiny)
State.SettingChanged = Signal.new() -- (name, value)

function State.init()
	Remotes.get("State").OnClientEvent:Connect(function(data, meta)
		local old = State.Data
		State.Data = data
		State.Meta = meta or {}
		State.Changed:Fire(data, old)
	end)
	-- на случай, если сервер прислал данные раньше, чем мы подписались
	task.spawn(function()
		local remote = Remotes.get("Request")
		pcall(remote.InvokeServer, remote, "Sync")
	end)
end

function State.ready(): boolean
	return State.Data ~= nil
end

function State.waitReady()
	while not State.Data do
		task.wait(0.1)
	end
	return State.Data
end

function State.now(): number
	return workspace:GetServerTimeNow()
end

function State.event(): (string?, number)
	local id = ReplicatedStorage:GetAttribute("EventId")
	local ends = ReplicatedStorage:GetAttribute("EventEndsAt") or 0
	if type(id) == "string" and id ~= "" and ends > State.now() then
		return id, ends
	end
	return nil, 0
end

function State.stats()
	if not State.Data then
		return nil
	end
	return Formulas.getStats(State.Data, State.now(), (State.event()))
end

function State.setting(name: string): boolean
	local data = State.Data
	if not data or not data.Settings then
		return true
	end
	return data.Settings[name] ~= false
end

function State.perk(name: string): number
	local data = State.Data
	return data and data.Perks and data.Perks[name] or 0
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="44">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">BoostsWindow</string>
              <string name="Source"><![CDATA[--[[
	BoostsWindow — бесплатные бусты с перезарядкой.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)

local Client = script.Parent.Parent
local ClientNet = require(Client.ClientNet)
local Sounds = require(Client.Sounds)
local State = require(Client.State)
local UIKit = require(script.Parent.UIKit)
local Windows = require(script.Parent.Windows)

local BoostsWindow = {}

local T = UIKit.Theme

function BoostsWindow.build()
	local window = Windows.create("Boosts", "⚡ Бесплатные бусты", Vector2.new(720, 520), T.Cyan)
	local body = window.Body

	local info = UIKit.text(body, {
		Text = "Все бусты бесплатные! Включил — работает, потом перезаряжается. Купить нельзя — только подождать ⏳",
		TextSize = 15,
		TextColor3 = T.Sub,
		Size = UDim2.new(1, 0, 0, 40),
	})
	info.Font = UIKit.FontMedium

	local scroll = UIKit.scroll(body, {
		Position = UDim2.fromOffset(0, 44),
		Size = UDim2.new(1, 0, 1, -44),
	})
	UIKit.list(scroll, 8)
	UIKit.padding(scroll, 2, 4, 4)

	local updaters = {}
	for index, def in Config.Boosts do
		local card = UIKit.card(scroll, {
			LayoutOrder = index,
			Icon = def.Icon,
			Color = T.Cyan,
			Title = def.Name,
			Desc = def.Desc,
			ButtonWidth = 170,
			OnClick = function()
				if ClientNet.request("ActivateBoost", def.Key) then
					Sounds.play("Buy", 0.6, 1.3)
				end
			end,
		})
		table.insert(updaters, function(data)
			local state, left = Formulas.boostState(data, def.Key, State.now())
			if state == "active" then
				UIKit.setButton(card.Button, "✅ Работает\n" .. Format.time(left), T.GreenDark, false)
				card.Stroke.Color = T.Green
				card.Stroke.Transparency = 0
				card.Desc.Text = def.Desc
			elseif state == "cooldown" then
				UIKit.setButton(card.Button, "⏳ " .. Format.time(left), T.Disabled, false)
				card.Stroke.Color = T.Stroke
				card.Stroke.Transparency = 0.35
				card.Desc.Text = def.Desc .. "\nПерезарядка, подожди немного."
			else
				UIKit.setButton(card.Button, "⚡ Включить", T.Cyan)
				card.Stroke.Color = T.Cyan
				card.Stroke.Transparency = 0.1
				card.Desc.Text = string.format("%s\nДействует %s, перезарядка %s.", def.Desc, Format.duration(def.Duration), Format.duration(def.Cooldown))
			end
		end)
	end

	local function render(data)
		for _, update in updaters do
			update(data)
		end
	end
	window.onRender = render
	window.onTick = render
end

return BoostsWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">CollectionWindow</string>
              <string name="Source"><![CDATA[--[[
	CollectionWindow — коллекция мусора: 42 предмета по зонам.
	Каждый найденный предмет навсегда даёт +1.5% к монетам.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)
local TrashModels = require(Shared.TrashModels)

local UIKit = require(script.Parent.UIKit)
local Windows = require(script.Parent.Windows)

local CollectionWindow = {}

local T = UIKit.Theme

function CollectionWindow.build()
	local window = Windows.create("Collection", "📖 Коллекция мусора", Vector2.new(800, 560), T.Purple)
	local body = window.Body

	local summary = UIKit.text(body, {
		Text = "",
		Font = UIKit.FontBlack,
		TextSize = 18,
		Size = UDim2.new(1, 0, 0, 26),
	})
	local scroll = UIKit.scroll(body, {
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, 0, 1, -32),
	})
	UIKit.list(scroll, 10)
	UIKit.padding(scroll, 2, 4, 4)

	local cells: { [string]: any } = {}
	local headers: { [number]: TextLabel } = {}
	local built = false

	local function build()
		built = true
		for zoneId, zone in Config.Zones do
			local section = UIKit.frame(scroll, {
				Name = "Zone" .. zoneId,
				LayoutOrder = zoneId,
				BackgroundColor3 = T.Panel2,
				Size = UDim2.new(1, -10, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
			})
			UIKit.corner(section, 14)
			UIKit.padding(section, 10)
			UIKit.list(section, 8)
			headers[zoneId] = UIKit.text(section, {
				LayoutOrder = 0,
				Text = "",
				Font = UIKit.FontBlack,
				TextSize = 17,
				TextColor3 = zone.Theme.Accent,
				Size = UDim2.new(1, 0, 0, 22),
			})
			local grid = UIKit.frame(section, {
				Name = "Grid",
				LayoutOrder = 1,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
			})
			UIKit.grid(grid, UDim2.fromOffset(100, 132), 8)
			for index, key in zone.Trash do
				local def = Config.Trash[key]
				local rarity = Config.Rarities[def.Rarity]
				local cell = UIKit.frame(grid, {
					Name = key,
					LayoutOrder = index,
					BackgroundColor3 = T.Card,
				})
				UIKit.corner(cell, 12)
				UIKit.stroke(cell, rarity.Color, 2, 0.15)
				local preview = UIKit.frame(cell, {
					Name = "Preview",
					BackgroundTransparency = 1,
					Position = UDim2.fromOffset(10, 4),
					Size = UDim2.fromOffset(80, 70),
				})
				local unknown = UIKit.text(cell, {
					Text = "❓",
					TextSize = 40,
					TextXAlignment = Enum.TextXAlignment.Center,
					Position = UDim2.fromOffset(10, 4),
					Size = UDim2.fromOffset(80, 70),
				})
				local name = UIKit.text(cell, {
					Text = "???",
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Center,
					Position = UDim2.fromOffset(4, 74),
					Size = UDim2.new(1, -8, 0, 30),
				})
				local info = UIKit.text(cell, {
					Text = rarity.Name,
					TextSize = 11,
					TextColor3 = rarity.Color,
					TextXAlignment = Enum.TextXAlignment.Center,
					Position = UDim2.fromOffset(4, 104),
					Size = UDim2.new(1, -8, 0, 24),
				})
				cells[key] = { Preview = preview, Unknown = unknown, Name = name, Info = info, Model = false }
			end
		end
	end

	window.onRender = function(data)
		if not built then
			build()
		end
		local count = Formulas.collectionCount(data)
		summary.Text = string.format(
			"Найдено %d из %d  •  Бонус коллекции: +%s к монетам навсегда",
			count,
			Config.TotalTrashTypes,
			Format.percent(Formulas.collectionBonus(data))
		)
		for zoneId, zone in Config.Zones do
			local found = 0
			for _, key in zone.Trash do
				if data.Discovered[key] then
					found += 1
				end
			end
			local locked = if zoneId > data.MaxZone then "  🔒" else ""
			headers[zoneId].Text = string.format("Зона %d • %s  (%d/%d)%s", zoneId, zone.Name, found, #zone.Trash, locked)
		end
		for key, cell in cells do
			local def = Config.Trash[key]
			local known = data.Discovered[key] == true
			cell.Unknown.Visible = not known
			cell.Preview.Visible = known
			if known then
				cell.Name.Text = def.Name
				cell.Info.Text = Format.number(def.Value) .. " 💰 • " .. def.Size .. " м."
				if not cell.Model then
					cell.Model = true
					pcall(function()
						UIKit.viewport(cell.Preview, TrashModels.build(key), { Size = UDim2.fromScale(1, 1) })
					end)
				end
			else
				cell.Name.Text = "???"
				cell.Info.Text = Config.Rarities[def.Rarity].Name
			end
		end
	end
end

return CollectionWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">FactoryWindow</string>
              <string name="Source"><![CDATA[--[[
	FactoryWindow — фабрика переработки: забрать накопленное, построить/улучшить.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)

local Client = script.Parent.Parent
local ClientNet = require(Client.ClientNet)
local Sounds = require(Client.Sounds)
local State = require(Client.State)
local UIKit = require(script.Parent.UIKit)
local Windows = require(script.Parent.Windows)

local FactoryWindow = {}

local T = UIKit.Theme

local function rateText(perSecond: number): string
	if perSecond < 10 then
		return string.format("%.1f", perSecond)
	end
	return Format.number(perSecond)
end

function FactoryWindow.build()
	local window = Windows.create("Factory", "🏭 Фабрика переработки", Vector2.new(700, 520), T.Gold)
	local body = window.Body
	UIKit.list(body, 10)

	local status = UIKit.text(body, {
		LayoutOrder = 1,
		Text = "",
		Font = UIKit.FontBlack,
		TextSize = 24,
		Size = UDim2.new(1, 0, 0, 30),
	})
	local stats = UIKit.text(body, {
		LayoutOrder = 2,
		Text = "",
		TextSize = 17,
		TextColor3 = T.Sub,
		Size = UDim2.new(1, 0, 0, 44),
	})

	local storageLabel = UIKit.text(body, {
		LayoutOrder = 3,
		Text = "📦 Склад",
		TextSize = 16,
		Size = UDim2.new(1, 0, 0, 20),
	})
	storageLabel.Font = UIKit.FontMedium
	local storage = UIKit.bar(body, { LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 30), Color = T.Gold })

	local claim = UIKit.button(body, {
		LayoutOrder = 5,
		Text = "Забрать",
		TextSize = 20,
		Color = T.Green,
		Size = UDim2.new(1, 0, 0, 52),
	}, function()
		if ClientNet.request("FactoryClaim") then
			Sounds.play("Sell", 0.6, 1)
		end
	end)

	local buildLabel = UIKit.text(body, {
		LayoutOrder = 6,
		Text = "🏗️ Стройка",
		TextSize = 16,
		Size = UDim2.new(1, 0, 0, 20),
	})
	buildLabel.Font = UIKit.FontMedium
	local progress = UIKit.bar(body, { LayoutOrder = 7, Size = UDim2.new(1, 0, 0, 30), Color = T.Blue })

	local upgrade = UIKit.button(body, {
		LayoutOrder = 8,
		Text = "Построить",
		TextSize = 18,
		Color = T.Blue,
		Size = UDim2.new(1, 0, 0, 52),
	}, function()
		if ClientNet.request("FactoryUpgrade") then
			Sounds.play("Buy", 0.6, 0.9)
		end
	end)

	local note = UIKit.text(body, {
		LayoutOrder = 9,
		Text = "Фабрика работает, даже когда тебя нет в игре — пока не заполнится склад. "
			.. "Ускорить стройку за робуксы нельзя: тут всё бесплатно, нужно просто подождать 😉",
		TextSize = 14,
		TextColor3 = T.Sub,
		Size = UDim2.new(1, 0, 0, 40),
	})
	note.Font = UIKit.FontMedium

	local function render(data)
		local now = State.now()
		local f = Formulas.simulateFactory(data, now)
		local multiplier = Formulas.rebirthMultiplier(data.Rebirths)
		local turbo = Formulas.boostActive(data, "FactoryTurbo", now)
		local rate = Formulas.factoryRate(f.Level) * multiplier * (if turbo then 3 else 1)
		local cap = Formulas.factoryCap(data, f.Level)
		local hours = Formulas.factoryStorageHours(data)

		if f.Level == 0 then
			status.Text = "Фабрика ещё не построена"
			stats.Text = "Построй её — и монеты начнут капать сами, даже пока ты спишь 💤"
		else
			status.Text = string.format("Уровень %d из %d%s", f.Level, Config.Factory.MaxLevel, if turbo then "  ⚡ ТУРБО x3" else "")
			stats.Text = string.format(
				"Доход: %s 💰/сек (≈ %s в час)  •  Склад на %d ч",
				rateText(rate),
				Format.number(rate * 3600),
				hours
			)
		end

		if cap > 0 then
			storage.set(f.Stored / cap, Format.number(f.Stored) .. " / " .. Format.number(cap), if f.Stored >= cap then T.Red else T.Gold)
		else
			storage.set(0, "—")
		end

		local amount = math.floor(f.Stored)
		if amount >= 1 then
			UIKit.setButton(claim, "💰 Забрать " .. Format.number(amount), T.Green)
		else
			UIKit.setButton(claim, "Пока пусто ⏳", T.Disabled)
		end

		if f.BuildingTo > 0 then
			local total = Formulas.factoryBuildTime(f.BuildingTo)
			local left = math.max(0, f.BuildEndsAt - now)
			progress.set(1 - left / math.max(1, total), "Строится ур. " .. f.BuildingTo .. " — осталось " .. Format.time(left), T.Blue)
			UIKit.setButton(upgrade, "⏳ Идёт стройка… просто подожди", T.Disabled, false)
		elseif f.Level >= Config.Factory.MaxLevel then
			progress.set(1, "Максимальный уровень 🏆", T.Gold)
			UIKit.setButton(upgrade, "🏆 Фабрика на максимуме", T.GreenDark, false)
		else
			local target = f.Level + 1
			local cost = Formulas.factoryCost(target)
			local nextRate = Formulas.factoryRate(target) * multiplier
			progress.set(0, string.format("Ур. %d: %s 💰/сек  •  стройка %s", target, rateText(nextRate), Format.duration(Formulas.factoryBuildTime(target))))
			local label = if f.Level == 0 then "🏗️ Построить за " else "⬆️ Улучшить за "
			UIKit.setButton(upgrade, label .. Format.number(cost) .. " 💰", if data.Coins >= cost then T.Blue else T.Disabled)
		end
	end

	window.onRender = render
	window.onTick = render
end

return FactoryWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">HelpersWindow</string>
              <string name="Source"><![CDATA[--[[
	HelpersWindow — помощники: купить, надеть, снять.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local HelperModels = require(Shared.HelperModels)

local Client = script.Parent.Parent
local ClientNet = require(Client.ClientNet)
local Sounds = require(Client.Sounds)
local State = require(Client.State)
local UIKit = require(script.Parent.UIKit)
local Windows = require(script.Parent.Windows)

local HelpersWindow = {}

local T = UIKit.Theme
local updaters: { (any) -> () } = {}

function HelpersWindow.build()
	local window = Windows.create("Helpers", "🐾 Помощники", Vector2.new(780, 540), T.Orange)
	local body = window.Body

	local info = UIKit.text(body, {
		Name = "Info",
		Text = "",
		TextSize = 16,
		TextColor3 = T.Sub,
		Size = UDim2.new(1, 0, 0, 40),
	})

	local scroll = UIKit.scroll(body, {
		Position = UDim2.fromOffset(0, 44),
		Size = UDim2.new(1, 0, 1, -44),
	})
	UIKit.list(scroll, 8)
	UIKit.padding(scroll, 2, 4, 4)

	for index, helper in Config.Helpers do
		local card = UIKit.card(scroll, {
			LayoutOrder = index,
			Height = 96,
			Title = helper.Name,
			Desc = string.format("%s\nЛовит раз в %.1f с • Радиус %d", helper.Desc, helper.Interval, helper.Range),
			IconNode = function(parent, size)
				local box = UIKit.frame(parent, {
					Name = "Preview",
					BackgroundColor3 = T.Panel2,
					Size = UDim2.fromOffset(size, size),
				})
				UIKit.corner(box, 12)
				UIKit.stroke(box, T.Orange, 2, 0.3)
				local ok = pcall(function()
					UIKit.viewport(box, HelperModels.build(helper.Key), { Size = UDim2.fromScale(1, 1) })
				end)
				if not ok then
					UIKit.text(box, { Text = "🐾", TextScaled = true, Size = UDim2.fromScale(1, 1) })
				end
				return box
			end,
			OnClick = function()
				local data = State.Data
				if not data then
					return
				end
				if not data.HelpersOwned[helper.Key] then
					if ClientNet.request("BuyHelper", helper.Key) then
						Sounds.play("Buy", 0.6, 1.1)
					end
				elseif table.find(data.Equipped, helper.Key) then
					ClientNet.request("UnequipHelper", helper.Key)
				else
					ClientNet.request("EquipHelper", helper.Key)
				end
			end,
		})
		table.insert(updaters, function(data)
			if not data.HelpersOwned[helper.Key] then
				local affordable = data.Coins >= helper.Cost
				UIKit.setButton(card.Button, "💰 " .. Format.number(helper.Cost), if affordable then T.Green else T.Disabled)
				card.Stroke.Color = T.Stroke
				card.Stroke.Transparency = 0.35
			elseif table.find(data.Equipped, helper.Key) then
				UIKit.setButton(card.Button, "✓ Помогает\n(снять)", T.GreenDark)
				card.Stroke.Color = T.Gold
				card.Stroke.Transparency = 0
			else
				UIKit.setButton(card.Button, "Взять с собой", T.Blue)
				card.Stroke.Color = T.Orange
				card.Stroke.Transparency = 0.3
			end
		end)
	end

	window.onRender = function(data)
		local slots = 1 + (data.Perks.HelperSlots or 0)
		info.Text = string.format(
			"Слоты: %d/%d. Помощники летают рядом и сами ловят мусор. Больше слотов — во вкладке «Перки» магазина.",
			#data.Equipped,
			slots
		)
		for _, update in updaters do
			update(data)
		end
	end
end

return HelpersWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--[[
	Hud — то, что всегда на экране:
	монеты, рюкзак, текущая зона, событие, меню слева (с красными значками),
	кнопки справа (подарок, «Продать», авто-сбор), подсказки для новичков,
	баннер новой зоны и луч-указатель к переработке.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)
local RiverMath = require(Shared.RiverMath)

local Client = script.Parent.Parent
local ClientNet = require(Client.ClientNet)
local State = require(Client.State)
local ZoneController = require(Client.Controllers.ZoneController)
local UIKit = require(script.Parent.UIKit)
local Windows = require(script.Parent.Windows)

local Hud = {}

local T = UIKit.Theme
local player = Players.LocalPlayer

local refs: { [string]: any } = {}
local badges: { [string]: GuiObject } = {}
local displayedCoins = 0
local targetCoins = 0
local gainLabel: TextLabel

local MENU = {
	{ Key = "Shop", Icon = "🛒", Label = "Магазин", Color = T.Blue },
	{ Key = "Helpers", Icon = "🐾", Label = "Помощники", Color = T.Orange },
	{ Key = "Factory", Icon = "🏭", Label = "Фабрика", Color = T.Gold },
	{ Key = "Boosts", Icon = "⚡", Label = "Бусты", Color = T.Cyan },
	{ Key = "Quests", Icon = "📜", Label = "Задания", Color = T.Green },
	{ Key = "Collection", Icon = "📖", Label = "Коллекция", Color = T.Purple },
	{ Key = "Rewards", Icon = "🎁", Label = "Награды", Color = T.Red },
	{ Key = "Rebirth", Icon = "🌀", Label = "Перерожд.", Color = Color3.fromRGB(200, 120, 255) },
	{ Key = "Teleport", Icon = "🗺️", Label = "Телепорт", Color = Color3.fromRGB(90, 200, 170) },
	{ Key = "Settings", Icon = "⚙️", Label = "Настройки", Color = Color3.fromRGB(150, 160, 180) },
}

----------------------------------------------------------------------
-- Значки «есть что сделать»
----------------------------------------------------------------------
local function anyGiftReady(): boolean
	local claimed = State.Meta.GiftsClaimed or {}
	local start = State.Meta.SessionStart or State.now()
	local elapsed = State.now() - start
	for index, gift in Config.Gifts do
		if not table.find(claimed, index) and elapsed >= gift.Minutes * 60 then
			return true
		end
	end
	return false
end

local function computeBadges(data)
	local now = State.now()
	local coins = data.Coins
	local result = {}

	local function canBuy(list, current)
		local nextItem = list[current + 1]
		return nextItem ~= nil and coins >= nextItem.Cost
	end
	local nextZone = Config.Zones[data.MaxZone + 1]
	result.Shop = canBuy(Config.Nets, data.Net)
		or canBuy(Config.Backpacks, data.Backpack)
		or canBuy(Config.Boots, data.Boots)
		or (nextZone ~= nil and coins >= nextZone.Cost)

	local helperAffordable = false
	for _, helper in Config.Helpers do
		if not data.HelpersOwned[helper.Key] and coins >= helper.Cost then
			helperAffordable = true
			break
		end
	end
	result.Helpers = helperAffordable

	local factory = Formulas.simulateFactory(data, now)
	local cap = Formulas.factoryCap(data, factory.Level)
	result.Factory = (factory.Level == 0 and factory.BuildingTo == 0 and coins >= Formulas.factoryCost(1))
		or (cap > 0 and factory.Stored >= cap * 0.3)

	local boostReady = false
	for _, boost in Config.Boosts do
		if Formulas.boostState(data, boost.Key, now) == "ready" then
			boostReady = true
			break
		end
	end
	result.Boosts = boostReady

	local questDone = false
	for _, quest in data.Quests do
		if quest.Done then
			questDone = true
			break
		end
	end
	result.Quests = questDone

	local dailyReady = Formulas.dailyStatus(data, now)
	result.Rewards = dailyReady or anyGiftReady()
	result.Rebirth = coins >= Formulas.rebirthCost(data.Rebirths)
	return result
end

----------------------------------------------------------------------
-- Построение
----------------------------------------------------------------------
local function buildTop(gui: ScreenGui)
	local top = UIKit.frame(gui, {
		Name = "Top",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 4),
		Size = UDim2.fromOffset(420, 160),
		BackgroundTransparency = 1,
	})
	UIKit.scaleGroup(top)

	local coins = UIKit.frame(top, {
		Name = "Coins",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(300, 52),
		BackgroundColor3 = T.Panel,
		BackgroundTransparency = 0.1,
	})
	UIKit.corner(coins, 26)
	UIKit.stroke(coins, T.Gold, 3)
	UIKit.text(coins, {
		Text = "💰",
		TextSize = 30,
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(0, 40, 1, 0),
	})
	refs.Coins = UIKit.text(coins, {
		Name = "Value",
		Text = "0",
		Font = UIKit.FontBlack,
		TextSize = 32,
		TextColor3 = T.Gold,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(48, 0),
		Size = UDim2.new(1, -64, 1, 0),
		Stroke = true,
	})
	refs.CoinsScale = UIKit.new("UIScale", { Parent = coins })

	gainLabel = UIKit.text(top, {
		Name = "Gain",
		Text = "",
		Font = UIKit.FontBlack,
		TextSize = 26,
		TextColor3 = T.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0.5, 158, 0, 26),
		Size = UDim2.fromOffset(200, 30),
		TextTransparency = 1,
		Stroke = true,
	})

	local backpack = UIKit.frame(top, {
		Name = "Backpack",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 58),
		Size = UDim2.fromOffset(300, 30),
		BackgroundTransparency = 1,
	})
	refs.Backpack = UIKit.bar(backpack, { Size = UDim2.fromScale(1, 1), Color = T.Green })
	UIKit.stroke(refs.Backpack.Frame, T.Stroke, 2)

	refs.Zone = UIKit.text(top, {
		Name = "Zone",
		Text = "",
		TextSize = 16,
		TextColor3 = T.Sub,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 92),
		Size = UDim2.fromOffset(420, 20),
		Stroke = true,
	})

	local event = UIKit.frame(top, {
		Name = "Event",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 116),
		Size = UDim2.fromOffset(380, 36),
		BackgroundColor3 = T.Purple,
		Visible = false,
	})
	UIKit.corner(event, 18)
	UIKit.gradient(event, T.Purple, T.Blue, 0)
	refs.EventText = UIKit.text(event, {
		Text = "",
		Font = UIKit.FontBlack,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Stroke = true,
	})
	refs.Event = event
end

local function buildMenu(gui: ScreenGui)
	local cell = 78
	local gap = 8
	local menu = UIKit.frame(gui, {
		Name = "Menu",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 10),
		Size = UDim2.fromOffset(cell * 2 + gap, cell * 5 + gap * 4),
		BackgroundTransparency = 1,
	})
	UIKit.scaleGroup(menu)
	UIKit.grid(menu, UDim2.fromOffset(cell, cell), gap)

	for index, item in MENU do
		local button = UIKit.button(menu, {
			Name = item.Key,
			Text = "",
			LayoutOrder = index,
			Color = T.Panel,
			Radius = 16,
		}, function()
			Windows.toggle(item.Key)
		end)
		local edge = button:FindFirstChild("Edge") :: UIStroke
		edge.Color = item.Color
		edge.Thickness = 2.5
		UIKit.text(button, {
			Text = item.Icon,
			TextSize = 32,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 6),
			Size = UDim2.new(1, 0, 0, 40),
		})
		UIKit.text(button, {
			Text = item.Label,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.new(0, 2, 1, -26),
			Size = UDim2.new(1, -4, 0, 20),
			TextScaled = true,
			Stroke = true,
		})
		local badge = UIKit.frame(button, {
			Name = "Badge",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -6, 0, 6),
			Size = UDim2.fromOffset(22, 22),
			BackgroundColor3 = T.Red,
			Visible = false,
			ZIndex = 5,
		})
		UIKit.corner(badge, 11)
		UIKit.stroke(badge, Color3.new(1, 1, 1), 2)
		UIKit.text(badge, {
			Text = "!",
			Font = UIKit.FontBlack,
			TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 6,
		})
		badges[item.Key] = badge
	end
end

local function buildRight(gui: ScreenGui)
	local right = UIKit.frame(gui, {
		Name = "Right",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, -20),
		Size = UDim2.fromOffset(176, 200),
		BackgroundTransparency = 1,
	})
	UIKit.scaleGroup(right)
	UIKit.list(right, 8, false, Enum.HorizontalAlignment.Right)

	refs.Gift = UIKit.button(right, {
		Name = "Gift",
		Text = "🎁 Подарок",
		TextSize = 17,
		LayoutOrder = 1,
		Color = T.Purple,
		Size = UDim2.fromOffset(176, 54),
	}, function()
		Windows.toggle("Rewards")
	end)

	refs.Sell = UIKit.button(right, {
		Name = "Sell",
		Text = "♻️ Продать",
		TextSize = 20,
		LayoutOrder = 2,
		Color = T.Green,
		Size = UDim2.fromOffset(176, 54),
		Visible = false,
	}, function()
		ClientNet.request("SellAll")
	end)

	refs.Auto = UIKit.button(right, {
		Name = "Auto",
		Text = "🤖 Авто-сбор",
		TextSize = 16,
		LayoutOrder = 3,
		Color = T.Blue,
		Size = UDim2.fromOffset(176, 44),
		Visible = false,
	}, function()
		local data = State.Data
		if data then
			ClientNet.request("SetSetting", "AutoCollect", not data.Settings.AutoCollect)
		end
	end)
end

local function buildHintAndBanner(gui: ScreenGui)
	local hintHolder = UIKit.frame(gui, {
		Name = "Hint",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -96),
		Size = UDim2.fromOffset(660, 46),
		BackgroundColor3 = T.Panel,
		BackgroundTransparency = 0.15,
		Visible = false,
	})
	UIKit.scaleGroup(hintHolder)
	UIKit.corner(hintHolder, 14)
	UIKit.stroke(hintHolder, T.Gold, 2)
	refs.HintText = UIKit.text(hintHolder, {
		Text = "",
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Stroke = true,
	})
	refs.Hint = hintHolder

	local banner = UIKit.frame(gui, {
		Name = "ZoneBanner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(760, 110),
		BackgroundTransparency = 1,
	})
	UIKit.scaleGroup(banner)
	refs.BannerTitle = UIKit.text(banner, {
		Text = "",
		Font = UIKit.FontBlack,
		TextSize = 54,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 64),
		TextTransparency = 1,
		Stroke = true,
	})
	refs.BannerSub = UIKit.text(banner, {
		Text = "",
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 66),
		Size = UDim2.new(1, 0, 0, 30),
		TextTransparency = 1,
		TextColor3 = T.Sub,
		Stroke = true,
	})
end

----------------------------------------------------------------------
-- Обновление
----------------------------------------------------------------------
local function setStrokeTransparency(label: TextLabel, value: number)
	local stroke = label:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Transparency = value
	end
end

local bannerToken = 0
local function showBanner(zoneId: number)
	local zone = Config.Zones[zoneId]
	bannerToken += 1
	local token = bannerToken
	refs.BannerTitle.Text = string.format("Зона %d • %s", zoneId, zone.Name)
	refs.BannerTitle.TextColor3 = zone.Theme.Accent
	local data = State.Data
	local best = Config.Trash[zone.Trash[#zone.Trash]]
	refs.BannerSub.Text = "Легенда этой реки: " .. best.Name .. " ★"
	if data and zoneId > data.MaxZone then
		refs.BannerSub.Text = "Зона закрыта 🔒"
	end
	for _, label in { refs.BannerTitle, refs.BannerSub } do
		UIKit.tween(label, 0.4, { TextTransparency = 0 })
		setStrokeTransparency(label, 0.2)
	end
	task.delay(2.6, function()
		if token ~= bannerToken then
			return
		end
		for _, label in { refs.BannerTitle, refs.BannerSub } do
			UIKit.tween(label, 0.6, { TextTransparency = 1 })
			setStrokeTransparency(label, 1)
		end
	end)
end

local function hintFor(data, stats): string?
	local full = data.InvSize >= stats.Capacity
	local sellAnywhere = (data.Perks.SellAnywhere or 0) > 0
	if not data.Tutorial.Collected then
		return "👆 Кликай (или тапай) по мусору в реке — сачок выловит его!"
	end
	if full then
		if sellAnywhere then
			return "🎒 Рюкзак полон! Жми «♻️ Продать» справа"
		end
		return "🎒 Рюкзак полон! Беги на зелёную площадку ♻️ (следуй за лучом)"
	end
	if not data.Tutorial.Sold and data.InvSize > 0 then
		return "♻️ Отнеси мусор на зелёную площадку переработки, чтобы получить монеты"
	end
	if not data.Tutorial.Bought and data.Coins >= Config.Nets[2].Cost then
		return "🛒 Открой Магазин слева и купи улучшение!"
	end
	return nil
end

-- Луч к площадке переработки
local beam: Beam? = nil
local beamTarget: Part? = nil
local beamAttachment: Attachment? = nil

local function updateBeam(show: boolean)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not show or not root then
		if beam then
			beam.Enabled = false
		end
		return
	end
	if not beam then
		local target = Instance.new("Part")
		target.Name = "SellGuide"
		target.Anchored = true
		target.CanCollide = false
		target.CanQuery = false
		target.CanTouch = false
		target.Transparency = 1
		target.Size = Vector3.new(0.2, 0.2, 0.2)
		target.Parent = workspace
		local a1 = Instance.new("Attachment")
		a1.Parent = target
		local newBeam = Instance.new("Beam")
		newBeam.Attachment1 = a1
		newBeam.Color = ColorSequence.new(Color3.fromRGB(90, 255, 140))
		newBeam.Transparency = NumberSequence.new(0.25)
		newBeam.Width0 = 1
		newBeam.Width1 = 2
		newBeam.FaceCamera = true
		newBeam.LightEmission = 1
		newBeam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		newBeam.TextureMode = Enum.TextureMode.Wrap
		newBeam.TextureLength = 3
		newBeam.TextureSpeed = 2
		newBeam.Segments = 12
		newBeam.Parent = target
		beam = newBeam
		beamTarget = target
	end
	if not beamAttachment or beamAttachment.Parent ~= root then
		local a0 = Instance.new("Attachment")
		a0.Name = "SellGuideAttachment"
		a0.Parent = root
		beamAttachment = a0
	end
	local zone = ZoneController.current()
	local pad = RiverMath.sellPadPosition(zone)
	local b = beam :: Beam
	local target = beamTarget :: Part
	target.CFrame = CFrame.new(pad + Vector3.new(0, 2.5, 0))
	b.Attachment0 = beamAttachment
	b.Enabled = true
end

function Hud.update(data)
	local stats = State.stats()
	if not stats then
		return
	end
	targetCoins = data.Coins

	local fraction = data.InvSize / math.max(1, stats.Capacity)
	local color = if fraction >= 1 then T.Red elseif fraction >= 0.75 then T.Orange else T.Green
	local valueNow = data.InvValue * stats.CoinMult
	refs.Backpack.set(
		fraction,
		string.format("🎒 %s / %s   •   ≈ %s 💰", Format.number(data.InvSize), Format.number(stats.Capacity), Format.number(valueNow)),
		color
	)

	refs.Sell.Visible = (data.Perks.SellAnywhere or 0) > 0
	refs.Auto.Visible = (data.Perks.AutoCollect or 0) > 0
	if refs.Auto.Visible then
		local on = data.Settings.AutoCollect
		UIKit.setButton(refs.Auto, if on then "🤖 Авто-сбор: ВКЛ" else "🤖 Авто-сбор: ВЫКЛ", if on then T.Blue else T.Disabled)
	end

	local hint = hintFor(data, stats)
	refs.Hint.Visible = hint ~= nil
	refs.HintText.Text = hint or ""

	local full = data.InvSize >= stats.Capacity
	local needGuide = (data.Perks.SellAnywhere or 0) == 0 and (full or (not data.Tutorial.Sold and data.InvSize >= 3))
	updateBeam(needGuide)

	local result = computeBadges(data)
	for key, badge in badges do
		badge.Visible = result[key] == true
	end
end

local function tick()
	local data = State.Data
	if not data then
		return
	end
	-- зона
	local zoneId = ZoneController.current()
	local zone = Config.Zones[zoneId]
	local saveNote = if State.Meta.CanSave == false then "   ⚠️ сохранение выключено" else ""
	refs.Zone.Text = string.format("📍 Зона %d • %s%s", zoneId, zone.Name, saveNote)

	-- событие
	local eventId, endsAt = State.event()
	if eventId then
		local def = Config.EventByKey[eventId]
		refs.Event.Visible = true
		refs.EventText.Text = string.format("%s %s  %s", def.Icon, def.Name, Format.time(endsAt - State.now()))
	else
		refs.Event.Visible = false
	end

	-- подарок за время
	local claimed = State.Meta.GiftsClaimed or {}
	local start = State.Meta.SessionStart or State.now()
	local elapsed = State.now() - start
	local nextGift = nil
	local ready = false
	for index, gift in Config.Gifts do
		if not table.find(claimed, index) then
			if elapsed >= gift.Minutes * 60 then
				ready = true
				break
			elseif not nextGift then
				nextGift = gift.Minutes * 60 - elapsed
			end
		end
	end
	if ready then
		UIKit.setButton(refs.Gift, "🎁 Забери подарок!", T.Green)
	elseif nextGift then
		UIKit.setButton(refs.Gift, "🎁 Подарок через\n" .. Format.time(nextGift), T.Purple)
	else
		UIKit.setButton(refs.Gift, "🎁 Награды", T.Purple)
	end

	local result = computeBadges(data)
	for key, badge in badges do
		badge.Visible = result[key] == true
	end
end

local gainToken = 0
local function showGain(amount: number)
	gainToken += 1
	local token = gainToken
	gainLabel.Text = "+" .. Format.number(amount)
	gainLabel.TextTransparency = 0
	setStrokeTransparency(gainLabel, 0.2)
	gainLabel.Position = UDim2.new(0.5, 158, 0, 26)
	UIKit.tween(gainLabel, 0.8, { Position = UDim2.new(0.5, 158, 0, 10) })
	refs.CoinsScale.Scale = 1.15
	UIKit.tween(refs.CoinsScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(1.2, function()
		if token == gainToken then
			UIKit.tween(gainLabel, 0.5, { TextTransparency = 1 })
			setStrokeTransparency(gainLabel, 1)
		end
	end)
end

function Hud.build(gui: ScreenGui)
	buildTop(gui)
	buildMenu(gui)
	buildRight(gui)
	buildHintAndBanner(gui)
end

function Hud.start()
	State.Changed:Connect(function(data, old)
		if old and data.Coins > old.Coins then
			showGain(data.Coins - old.Coins)
		end
		if not old then
			displayedCoins = data.Coins
		end
		Hud.update(data)
	end)
	if State.Data then
		displayedCoins = State.Data.Coins
		Hud.update(State.Data)
	end

	ZoneController.ZoneChanged:Connect(showBanner)

	RunService.RenderStepped:Connect(function(dt)
		if math.abs(targetCoins - displayedCoins) < 0.5 then
			displayedCoins = targetCoins
		else
			displayedCoins += (targetCoins - displayedCoins) * math.min(1, dt * 7)
		end
		refs.Coins.Text = Format.number(displayedCoins)
	end)

	task.spawn(function()
		while true do
			task.wait(0.5)
			local ok, err = pcall(tick)
			if not ok then
				warn("[HUD]", err)
			end
			if State.Data then
				local stats = State.stats()
				if stats then
					local full = State.Data.InvSize >= stats.Capacity
					local needGuide = (State.Data.Perks.SellAnywhere or 0) == 0
						and (full or (not State.Data.Tutorial.Sold and State.Data.InvSize >= 3))
					updateBeam(needGuide)
				end
			end
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[--[[
	Notifications — всплывающие сообщения сверху экрана.
	kind: "success" | "error" | "info" | "legendary" | "event"
]]

local Client = script.Parent.Parent
local Sounds = require(Client.Sounds)
local UIKit = require(script.Parent.UIKit)

local Notifications = {}

local T = UIKit.Theme
local container: Frame
local lastText = ""
local lastAt = 0
local order = 0

local KIND = {
	success = { Color = T.Green, Time = 3.2 },
	error = { Color = T.Red, Time = 2.6 },
	info = { Color = T.Blue, Time = 3.5 },
	legendary = { Color = T.Gold, Time = 5 },
	event = { Color = T.Purple, Time = 6 },
}

function Notifications.init(gui: ScreenGui)
	container = UIKit.frame(gui, {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 132),
		Size = UDim2.fromOffset(560, 320),
		BackgroundTransparency = 1,
		ZIndex = 50,
	})
	UIKit.scaleGroup(container)
	UIKit.list(container, 6, false, Enum.HorizontalAlignment.Center)
end

function Notifications.show(text: string, kind: string?)
	if not container or type(text) ~= "string" or text == "" then
		return
	end
	local now = os.clock()
	if text == lastText and now - lastAt < 1.2 then
		return
	end
	lastText = text
	lastAt = now

	local style = KIND[kind or "info"] or KIND.info
	order += 1

	-- не больше 4 сообщений одновременно
	local toasts = {}
	for _, child in container:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #toasts >= 4 do
		table.remove(toasts, 1):Destroy()
	end

	local toast = UIKit.frame(container, {
		Name = "Toast",
		LayoutOrder = order,
		BackgroundColor3 = T.Panel,
		BackgroundTransparency = 0.05,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 50,
	})
	UIKit.corner(toast, 12)
	local stroke = UIKit.stroke(toast, style.Color, 2.5)
	UIKit.padding(toast, 14, 8, 8)
	local label = UIKit.text(toast, {
		Text = text,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 51,
	})

	if kind == "error" then
		Sounds.play("Error", 0.25, 0.7)
	elseif kind == "legendary" or kind == "event" then
		Sounds.play("Buy", 0.5, 0.8)
	end

	task.delay(style.Time, function()
		if toast.Parent then
			UIKit.tween(toast, 0.35, { BackgroundTransparency = 1 })
			UIKit.tween(label, 0.35, { TextTransparency = 1 })
			UIKit.tween(stroke, 0.35, { Transparency = 1 })
			task.wait(0.4)
			toast:Destroy()
		end
	end)
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">QuestsWindow</string>
              <string name="Source"><![CDATA[--[[
	QuestsWindow — три задания с прогрессом, наградой и заменой.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local Client = script.Parent.Parent
local ClientNet = require(Client.ClientNet)
local Sounds = require(Client.Sounds)
local State = require(Client.State)
local UIKit = require(script.Parent.UIKit)
local Windows = require(script.Parent.Windows)

local QuestsWindow = {}

local T = UIKit.Theme

local ICONS = {
	Collect = "🗑️",
	CollectType = "🎯",
	CollectRare = "💎",
	Earn = "💰",
	Sell = "♻️",
	Helper = "🐾",
	Shiny = "✨",
	ZoneCollect = "📍",
}

function QuestsWindow.build()
	local window = Windows.create("Quests", "📜 Задания", Vector2.new(720, 500), T.Green)
	local body = window.Body
	UIKit.list(body, 10)

	local slots = {}
	for i = 1, Config.Quests.Slots do
		local card = UIKit.frame(body, {
			Name = "Quest" .. i,
			LayoutOrder = i,
			BackgroundColor3 = T.Card,
			Size = UDim2.new(1, 0, 0, 112),
		})
		UIKit.corner(card, 14)
		local stroke = UIKit.stroke(card, T.Stroke, 1.5, 0.35)
		local icon = UIKit.icon(card, "📜", T.Green, 64)
		icon.Position = UDim2.fromOffset(10, 10)
		local title = UIKit.text(card, {
			Text = "",
			Font = UIKit.FontBlack,
			TextSize = 18,
			Position = UDim2.fromOffset(86, 8),
			Size = UDim2.new(1, -260, 0, 44),
			TextYAlignment = Enum.TextYAlignment.Top,
		})
		local reward = UIKit.text(card, {
			Text = "",
			TextSize = 15,
			TextColor3 = T.Gold,
			Position = UDim2.fromOffset(86, 52),
			Size = UDim2.new(1, -260, 0, 20),
		})
		local bar = UIKit.bar(card, {
			Position = UDim2.fromOffset(86, 76),
			Size = UDim2.new(1, -260, 0, 24),
			Color = T.Green,
		})
		local claim = UIKit.button(card, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 12),
			Size = UDim2.fromOffset(150, 46),
			Text = "Забрать",
			Color = T.Green,
		}, function()
			local quest = slots[i].Quest
			if quest and ClientNet.request("ClaimQuest", quest.Id) then
				Sounds.play("Sell", 0.6, 1.1)
			end
		end)
		local reroll = UIKit.button(card, {
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -12, 1, -10),
			Size = UDim2.fromOffset(150, 36),
			Text = "🔄 Заменить",
			TextSize = 14,
			Color = T.Panel2,
		}, function()
			local quest = slots[i].Quest
			if quest then
				ClientNet.request("RerollQuest", quest.Id)
			end
		end)
		slots[i] = {
			Card = card,
			Stroke = stroke,
			Icon = icon,
			Title = title,
			Reward = reward,
			Bar = bar,
			Claim = claim,
			Reroll = reroll,
			Quest = nil,
		}
	end

	local footer = UIKit.text(body, {
		LayoutOrder = 10,
		Text = "",
		TextSize = 15,
		TextColor3 = T.Sub,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 24),
	})

	local function render(data)
		local now = State.now()
		local rerollLeft = math.max(0, (data.QuestRerollAt or 0) - now)
		for i, slot in slots do
			local quest = data.Quests[i]
			slot.Quest = quest
			slot.Card.Visible = quest ~= nil
			if quest then
				local iconLabel = slot.Icon:FindFirstChildOfClass("TextLabel")
				if iconLabel then
					iconLabel.Text = ICONS[quest.Kind] or "📜"
				end
				slot.Title.Text = quest.Text
				slot.Reward.Text = "🏆 Награда: " .. Format.number(quest.Reward) .. " 💰"
				local progressText = if quest.Kind == "Earn"
					then Format.number(quest.Progress) .. " / " .. Format.number(quest.Target)
					else quest.Progress .. " / " .. quest.Target
				slot.Bar.set(quest.Progress / math.max(1, quest.Target), progressText, if quest.Done then T.Gold else T.Green)
				if quest.Done then
					UIKit.setButton(slot.Claim, "🏆 Забрать!", T.Gold)
					slot.Stroke.Color = T.Gold
					slot.Stroke.Transparency = 0
					slot.Reroll.Visible = false
				else
					UIKit.setButton(slot.Claim, "В процессе…", T.Disabled, false)
					slot.Stroke.Color = T.Stroke
					slot.Stroke.Transparency = 0.35
					slot.Reroll.Visible = true
					if rerollLeft > 0 then
						UIKit.setButton(slot.Reroll, "🔄 через " .. Format.time(rerollLeft), T.Panel2, false)
					else
						UIKit.setButton(slot.Reroll, "🔄 Заменить", T.Panel2)
					end
				end
			end
		end
		footer.Text = "Выполнено заданий за всё время: " .. Format.number(data.QuestsDone or 0)
	end

	window.onRender = render
	window.onTick = render
end

return QuestsWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">RebirthWindow</string>
              <string name="Source"><![CDATA[--[[
	RebirthWindow — перерождение с подтверждением.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)

local Client = script.Parent.Parent
local ClientNet = require(Client.ClientNet)
local Sounds = require(Client.Sounds)
local State = require(Client.State)
local UIKit = require(script.Parent.UIKit)
local Windows = require(script.Parent.Windows)

local RebirthWindow = {}

local T = UIKit.Theme
local PURPLE = Color3.fromRGB(190, 110, 255)

function RebirthWindow.build()
	local window = Windows.create("Rebirth", "🌀 Перерождение", Vector2.new(680, 520), PURPLE)
	local body = window.Body
	UIKit.list(body, 10)

	local count = UIKit.text(body, {
		LayoutOrder = 1,
		Text = "",
		Font = UIKit.FontBlack,
		TextSize = 24,
		Size = UDim2.new(1, 0, 0, 30),
	})
	local bonus = UIKit.text(body, {
		LayoutOrder = 2,
		Text = "",
		TextSize = 18,
		TextColor3 = T.Gold,
		Size = UDim2.new(1, 0, 0, 48),
	})
	local progress = UIKit.bar(body, { LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 30), Color = PURPLE })

	local lists = UIKit.frame(body, {
		LayoutOrder = 4,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 150),
	})
	local function column(x: number, title: string, color: Color3, lines: { string })
		local frame = UIKit.frame(lists, {
			BackgroundColor3 = T.Card,
			Position = UDim2.new(x, if x > 0 then 5 else 0, 0, 0),
			Size = UDim2.new(0.5, -5, 1, 0),
		})
		UIKit.corner(frame, 12)
		UIKit.stroke(frame, color, 2, 0.3)
		UIKit.padding(frame, 12)
		UIKit.list(frame, 4)
		UIKit.text(frame, { Text = title, Font = UIKit.FontBlack, TextSize = 17, TextColor3 = color, Size = UDim2.new(1, 0, 0, 22) })
		for i, line in lines do
			local label = UIKit.text(frame, { LayoutOrder = i, Text = line, TextSize = 15, Size = UDim2.new(1, 0, 0, 18) })
			label.Font = UIKit.FontMedium
		end
	end
	column(0, "Сбросится:", T.Red, { "• монеты", "• сачок, рюкзак, обувь", "• открытые зоны", "• мусор в рюкзаке" })
	column(0.5, "Останется навсегда:", T.Green, { "• перки и помощники", "• фабрика и её уровень", "• коллекция и бусты", "• статистика" })

	local armedUntil = 0
	local button
	button = UIKit.button(body, {
		LayoutOrder = 5,
		Text = "🌀 Переродиться",
		TextSize = 20,
		Color = PURPLE,
		Size = UDim2.new(1, 0, 0, 56),
	}, function()
		local data = State.Data
		if not data then
			return
		end
		local cost = Formulas.rebirthCost(data.Rebirths)
		if data.Coins < cost then
			ClientNet.request("Rebirth") -- сервер покажет, сколько не хватает
			return
		end
		if os.clock() < armedUntil then
			armedUntil = 0
			if ClientNet.request("Rebirth") then
				Sounds.play("Buy", 0.8, 0.7)
				Windows.close()
			end
		else
			armedUntil = os.clock() + 4
			UIKit.setButton(button, "Точно? Нажми ещё раз для подтверждения", T.Red)
		end
	end)

	local function render(data)
		local cost = Formulas.rebirthCost(data.Rebirths)
		local now = Formulas.rebirthMultiplier(data.Rebirths)
		local after = Formulas.rebirthMultiplier(data.Rebirths + 1)
		count.Text = "Перерождений: " .. data.Rebirths
		bonus.Text = string.format(
			"Монеты: %s → %s   •   Удача: +%s → +%s",
			Format.multiplier(now),
			Format.multiplier(after),
			Format.percent(data.Rebirths * Config.Rebirth.LuckBonus),
			Format.percent((data.Rebirths + 1) * Config.Rebirth.LuckBonus)
		)
		progress.set(data.Coins / cost, Format.number(data.Coins) .. " / " .. Format.number(cost) .. " 💰")
		if os.clock() >= armedUntil then
			if data.Coins >= cost then
				UIKit.setButton(button, "🌀 Переродиться", PURPLE)
			else
				UIKit.setButton(button, "Нужно " .. Format.number(cost) .. " 💰", T.Disabled)
			end
		end
	end

	window.onOpen = function()
		armedUntil = 0
	end
	window.onRender = render
	window.onTick = render
end

return RebirthWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">RewardsWindow</string>
              <string name="Source"><![CDATA[--[[
	RewardsWindow — ежедневная награда (серия 7 дней) и подарки за время в игре.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)

local Client = script.Parent.Parent
local ClientNet = require(Client.ClientNet)
local Sounds = require(Client.Sounds)
local State = require(Client.State)
local UIKit = require(script.Parent.UIKit)
local Windows = require(script.Parent.Windows)

local RewardsWindow = {}

local T = UIKit.Theme

function RewardsWindow.build()
	local window = Windows.create("Rewards", "🎁 Бесплатные награды", Vector2.new(780, 560), T.Red)
	local body = window.Body

	UIKit.text(body, {
		Text = "📅 Ежедневная награда — заходи каждый день, серия растёт!",
		Font = UIKit.FontBlack,
		TextSize = 17,
		Size = UDim2.new(1, 0, 0, 24),
	})

	local strip = UIKit.frame(body, {
		Name = "Days",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 0, 92),
	})
	UIKit.list(strip, 6, true)
	local days = {}
	for day = 1, #Config.Daily.Mults do
		local cell = UIKit.frame(strip, {
			LayoutOrder = day,
			BackgroundColor3 = T.Card,
			Size = UDim2.new(1 / #Config.Daily.Mults, -6, 1, 0),
		})
		UIKit.corner(cell, 12)
		local stroke = UIKit.stroke(cell, T.Stroke, 2, 0.3)
		UIKit.text(cell, {
			Text = "День " .. day,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 6),
			Size = UDim2.new(1, 0, 0, 18),
		})
		UIKit.text(cell, {
			Text = if day == #Config.Daily.Mults then "🎉" else "💰",
			TextSize = 26,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 24),
			Size = UDim2.new(1, 0, 0, 30),
		})
		local amount = UIKit.text(cell, {
			Text = "",
			TextSize = 14,
			TextColor3 = T.Gold,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(2, 58),
			Size = UDim2.new(1, -4, 0, 30),
		})
		days[day] = { Cell = cell, Stroke = stroke, Amount = amount }
	end

	local dailyButton = UIKit.button(body, {
		Position = UDim2.fromOffset(0, 130),
		Size = UDim2.new(1, 0, 0, 50),
		Text = "Забрать",
		TextSize = 19,
		Color = T.Green,
	}, function()
		if ClientNet.request("ClaimDaily") then
			Sounds.play("Sell", 0.7, 1)
		end
	end)

	UIKit.text(body, {
		Text = "⏱️ Подарки за время в игре (каждый заход заново)",
		Font = UIKit.FontBlack,
		TextSize = 17,
		Position = UDim2.fromOffset(0, 192),
		Size = UDim2.new(1, 0, 0, 24),
	})

	local gifts = UIKit.frame(body, {
		Name = "Gifts",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 222),
		Size = UDim2.new(1, 0, 1, -222),
	})
	UIKit.grid(gifts, UDim2.new(1 / 3, -8, 0, 96), 8)
	local giftCells = {}
	for index, gift in Config.Gifts do
		local cell = UIKit.frame(gifts, {
			LayoutOrder = index,
			BackgroundColor3 = T.Card,
		})
		UIKit.corner(cell, 12)
		local stroke = UIKit.stroke(cell, T.Stroke, 2, 0.3)
		local title = UIKit.text(cell, {
			Text = string.format("🎁 %d мин", gift.Minutes),
			Font = UIKit.FontBlack,
			TextSize = 16,
			Position = UDim2.fromOffset(12, 6),
			Size = UDim2.new(1, -24, 0, 22),
		})
		local amount = UIKit.text(cell, {
			Text = "",
			TextSize = 14,
			TextColor3 = T.Gold,
			Position = UDim2.fromOffset(12, 28),
			Size = UDim2.new(1, -24, 0, 18),
		})
		local button = UIKit.button(cell, {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.new(1, -20, 0, 36),
			Text = "",
			TextSize = 15,
			Color = T.Disabled,
		}, function()
			if ClientNet.request("ClaimGift", index) then
				Sounds.play("Sell", 0.6, 1.2)
			end
		end)
		giftCells[index] = { Stroke = stroke, Title = title, Amount = amount, Button = button }
	end

	local function render(data)
		local now = State.now()
		local available, streak, wait = Formulas.dailyStatus(data, now)
		local doneUpTo = if available then streak - 1 else (data.Daily.Streak or 0)
		for day, cell in days do
			cell.Amount.Text = Format.number(Formulas.dailyReward(data, day))
			if day <= doneUpTo then
				cell.Cell.BackgroundColor3 = T.GreenDark
				cell.Stroke.Color = T.Green
			elseif day == streak then
				cell.Cell.BackgroundColor3 = T.Card
				cell.Stroke.Color = T.Gold
				cell.Stroke.Transparency = 0
			else
				cell.Cell.BackgroundColor3 = T.Card
				cell.Stroke.Color = T.Stroke
				cell.Stroke.Transparency = 0.3
			end
		end
		if available then
			local extra = if streak == #Config.Daily.Mults then " + все бусты ⚡" else ""
			UIKit.setButton(
				dailyButton,
				string.format("🎁 Забрать день %d: %s 💰%s", streak, Format.number(Formulas.dailyReward(data, streak)), extra),
				T.Green
			)
		else
			UIKit.setButton(dailyButton, "⏳ Следующая награда через " .. Format.time(wait), T.Disabled, false)
		end

		local claimed = State.Meta.GiftsClaimed or {}
		local start = State.Meta.SessionStart or now
		local elapsed = now - start
		for index, gift in Config.Gifts do
			local cell = giftCells[index]
			local extra = ""
			if gift.Boost then
				local boost = Config.BoostByKey[gift.Boost]
				extra = " + " .. boost.Icon
			end
			cell.Amount.Text = Format.number(Formulas.giftReward(data, index)) .. " 💰" .. extra
			if table.find(claimed, index) then
				UIKit.setButton(cell.Button, "✓ Получено", T.GreenDark, false)
				cell.Stroke.Color = T.Stroke
			elseif elapsed >= gift.Minutes * 60 then
				UIKit.setButton(cell.Button, "Забрать!", T.Green)
				cell.Stroke.Color = T.Gold
			else
				UIKit.setButton(cell.Button, "⏳ " .. Format.time(gift.Minutes * 60 - elapsed), T.Disabled, false)
				cell.Stroke.Color = T.Stroke
			end
		end
	end

	window.onRender = render
	window.onTick = render
end

return RewardsWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">SettingsWindow</string>
              <string name="Source"><![CDATA[--[[
	SettingsWindow — переключатели и статистика игрока.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)

local Client = script.Parent.Parent
local ClientNet = require(Client.ClientNet)
local State = require(Client.State)
local UIKit = require(script.Parent.UIKit)
local Windows = require(script.Parent.Windows)

local SettingsWindow = {}

local T = UIKit.Theme

local TOGGLES = {
	{ Key = "AutoCollect", Icon = "🤖", Title = "Авто-сбор", Desc = "Сачок сам ловит ближайший мусор", Perk = "AutoCollect" },
	{ Key = "AutoSell", Icon = "♻️", Title = "Авто-продажа", Desc = "Полный рюкзак продаётся сам", Perk = "AutoSell" },
	{ Key = "WaterWalk", Icon = "🦶", Title = "Ходьба по воде", Desc = "Перк «Водомерка»", Perk = "WaterWalk" },
	{ Key = "ShowRange", Icon = "⭕", Title = "Кольцо дальности", Desc = "Показывать радиус сачка на земле" },
	{ Key = "Effects", Icon = "✨", Title = "Эффекты", Desc = "Брызги, летящий мусор, подписи" },
	{ Key = "Sounds", Icon = "🔊", Title = "Звуки", Desc = "Звуки вылова, продажи и кнопок" },
	{ Key = "Music", Icon = "🎵", Title = "Музыка", Desc = "Фоновая музыка (если задана в Config)" },
}

function SettingsWindow.build()
	local window = Windows.create("Settings", "⚙️ Настройки и статистика", Vector2.new(720, 560), Color3.fromRGB(150, 160, 180))
	local scroll = UIKit.scroll(window.Body, {})
	UIKit.list(scroll, 8)
	UIKit.padding(scroll, 2, 4, 4)

	local toggles = {}
	for index, def in TOGGLES do
		toggles[def.Key] = UIKit.toggle(scroll, def.Icon, def.Title, def.Desc, index, function()
			local data = State.Data
			if not data then
				return
			end
			if def.Perk and (data.Perks[def.Perk] or 0) <= 0 then
				-- перк ещё не куплен — открываем магазин на вкладке «Перки»
				Windows.open("Shop", { tab = "Perks" })
				return
			end
			local value = not (data.Settings[def.Key] ~= false)
			ClientNet.request("SetSetting", def.Key, value)
			State.SettingChanged:Fire(def.Key, value)
		end)
	end

	local stats = UIKit.frame(scroll, {
		LayoutOrder = 100,
		BackgroundColor3 = T.Card,
		Size = UDim2.new(1, -10, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	})
	UIKit.corner(stats, 14)
	UIKit.padding(stats, 14)
	local statsText = UIKit.text(stats, {
		Text = "",
		TextSize = 16,
		TextYAlignment = Enum.TextYAlignment.Top,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		RichText = true,
	})

	window.onRender = function(data)
		for _, def in TOGGLES do
			local available = def.Perk == nil or (data.Perks[def.Perk] or 0) > 0
			toggles[def.Key].set(data.Settings[def.Key] ~= false, available)
		end
		local s = data.Stats
		local playtime = (s.PlayTime or 0) + math.max(0, State.now() - (State.Meta.SessionStart or State.now()))
		local save = if State.Meta.CanSave == false
			then "<font color=\"#ff7070\">выключено (Studio без доступа к API)</font>"
			else "<font color=\"#70e090\">включено ✅</font>"
		statsText.Text = table.concat({
			"<b>📊 Статистика</b>",
			"🗑️ Выловлено мусора: " .. Format.spaced(s.TrashCollected),
			"🌟 Легендарных: " .. Format.spaced(s.Legendary) .. "   ✨ Сияющих: " .. Format.spaced(s.Shiny),
			"🐾 Поймали помощники: " .. Format.spaced(s.HelperCollected),
			"♻️ Продаж: " .. Format.spaced(s.Sells) .. "   🏆 Лучшая продажа: " .. Format.number(s.BestSell or 0) .. " 💰",
			"💰 Заработано за всё время: " .. Format.number(data.TotalCoins),
			"⏱️ Время в игре: " .. Format.duration(playtime),
			"💾 Сохранение: " .. save,
		}, "\n")
	end
end

return SettingsWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">ShopWindow</string>
              <string name="Source"><![CDATA[--[[
	ShopWindow — магазин: сачки, рюкзаки, обувь, перки, зоны.
	Всё только за монеты. Доната нет.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)

local Client = script.Parent.Parent
local ClientNet = require(Client.ClientNet)
local Sounds = require(Client.Sounds)
local State = require(Client.State)
local UIKit = require(script.Parent.UIKit)
local Windows = require(script.Parent.Windows)

local ShopWindow = {}

local T = UIKit.Theme
local pages: { [string]: ScrollingFrame } = {}
local updaters: { (any) -> () } = {}
local tabs

local function priceButton(button: TextButton, cost: number, coins: number)
	local affordable = coins >= cost
	UIKit.setButton(button, "💰 " .. Format.number(cost), if affordable then T.Green else T.Disabled)
end

local function buy(action: string, ...)
	local ok = ClientNet.request(action, ...)
	if ok then
		Sounds.play("Buy", 0.6, 1.1)
	end
end

local function page(key: string): ScrollingFrame
	local scroll = pages[key]
	return scroll
end

-- Вкладка с уровнями (сачки, рюкзаки, обувь)
local function buildTiers(key: string, list, field: string, action: string, describe: (any) -> string, color: Color3)
	local scroll = page(key)
	for tier, item in list do
		local card = UIKit.card(scroll, {
			LayoutOrder = tier,
			Icon = item.Icon,
			Color = color,
			Title = item.Name,
			Desc = describe(item),
			OnClick = function()
				buy(action, tier)
			end,
		})
		table.insert(updaters, function(data)
			local current = data[field]
			if tier < current then
				UIKit.setButton(card.Button, "✓ Было", T.Disabled, false)
				card.Stroke.Color = T.Stroke
				card.Stroke.Transparency = 0.35
			elseif tier == current then
				UIKit.setButton(card.Button, "✓ Сейчас", T.GreenDark, false)
				card.Stroke.Color = T.Gold
				card.Stroke.Transparency = 0
			elseif tier == current + 1 then
				priceButton(card.Button, item.Cost, data.Coins)
				card.Stroke.Color = T.Blue
				card.Stroke.Transparency = 0.2
			else
				UIKit.setButton(card.Button, "🔒 " .. Format.number(item.Cost), T.Panel2, false)
				card.Stroke.Color = T.Stroke
				card.Stroke.Transparency = 0.35
			end
		end)
	end
end

local function buildPerks()
	local scroll = page("Perks")
	for index, key in Config.PerkOrder do
		local def = Config.Perks[key]
		local card = UIKit.card(scroll, {
			LayoutOrder = index,
			Icon = def.Icon,
			Color = T.Gold,
			Title = def.Name,
			Desc = def.Desc,
			OnClick = function()
				buy("BuyPerk", key)
			end,
		})
		table.insert(updaters, function(data)
			local level = data.Perks[key] or 0
			if def.MaxLevel > 1 then
				card.Title.Text = string.format("%s  (ур. %d/%d)", def.Name, level, def.MaxLevel)
			else
				card.Title.Text = def.Name
			end
			if level >= def.MaxLevel then
				UIKit.setButton(card.Button, if def.MaxLevel > 1 then "✓ Максимум" else "✓ Куплено", T.GreenDark, false)
			else
				priceButton(card.Button, Formulas.perkCost(key, level + 1) :: number, data.Coins)
			end
			if key == "Storage" then
				card.Desc.Text = string.format(
					"%s Сейчас: %d ч → дальше %d ч.",
					def.Desc,
					Formulas.factoryStorageHours(data),
					Config.Factory.StorageHours[math.min(level + 2, #Config.Factory.StorageHours)]
				)
			elseif key == "HelperSlots" then
				card.Desc.Text = string.format("%s Сейчас слотов: %d.", def.Desc, 1 + level)
			end
		end)
	end
end

local function buildZones()
	local scroll = page("Zones")
	for zoneId, zone in Config.Zones do
		local legend = Config.Trash[zone.Trash[#zone.Trash]]
		local common = Config.Trash[zone.Trash[1]]
		local card = UIKit.card(scroll, {
			LayoutOrder = zoneId,
			Icon = tostring(zoneId),
			Color = zone.Theme.Accent,
			Title = "Зона " .. zoneId .. ": " .. zone.Name,
			Desc = string.format(
				"Мусор от %s 💰 • ★ Легенда: %s (%s 💰)",
				Format.number(common.Value),
				legend.Name,
				Format.number(legend.Value)
			),
			OnClick = function()
				local data = State.Data
				if not data then
					return
				end
				if zoneId <= data.MaxZone then
					if ClientNet.request("Teleport", zoneId) then
						Windows.close()
					end
				else
					buy("BuyZone", zoneId)
				end
			end,
		})
		table.insert(updaters, function(data)
			if zoneId <= data.MaxZone then
				UIKit.setButton(card.Button, "🗺️ Телепорт", T.Blue)
				card.Stroke.Color = zone.Theme.Accent
				card.Stroke.Transparency = 0.2
			elseif zoneId == data.MaxZone + 1 then
				priceButton(card.Button, zone.Cost, data.Coins)
				card.Stroke.Color = T.Gold
				card.Stroke.Transparency = 0
			else
				UIKit.setButton(card.Button, "🔒 " .. Format.number(zone.Cost), T.Panel2, false)
				card.Stroke.Color = T.Stroke
				card.Stroke.Transparency = 0.35
			end
		end)
	end
end

function ShopWindow.build()
	local window = Windows.create("Shop", "🛒 Магазин", Vector2.new(780, 540), T.Blue)
	local body = window.Body

	local content = UIKit.frame(body, {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 50),
		Size = UDim2.new(1, 0, 1, -82),
	})
	local footer = UIKit.text(body, {
		Name = "Footer",
		Text = "💡 Здесь нет доната: всё покупается за монеты, заработанные уборкой реки!",
		TextSize = 14,
		TextColor3 = T.Sub,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 24),
	})
	footer.Font = UIKit.FontMedium

	local tabList = {
		{ Key = "Nets", Text = "🥅 Сачки" },
		{ Key = "Backpacks", Text = "🎒 Рюкзаки" },
		{ Key = "Boots", Text = "👟 Обувь" },
		{ Key = "Perks", Text = "⭐ Перки" },
		{ Key = "Zones", Text = "🗺️ Зоны" },
	}
	for _, tab in tabList do
		local scroll = UIKit.scroll(content, { Name = tab.Key, Visible = false })
		UIKit.list(scroll, 8)
		UIKit.padding(scroll, 2, 4, 4)
		pages[tab.Key] = scroll
	end

	tabs = UIKit.tabs(body, tabList, function(key)
		for name, scroll in pages do
			scroll.Visible = name == key
		end
	end)

	buildTiers("Nets", Config.Nets, "Net", "BuyNet", function(item)
		return string.format("Дальность %d • Взмах раз в %.2f с • Ловит до %d шт. за раз", item.Range, item.Cooldown, item.Multi)
	end, T.Cyan)
	buildTiers("Backpacks", Config.Backpacks, "Backpack", "BuyBackpack", function(item)
		return "Вместимость: " .. Format.number(item.Capacity) .. " мест"
	end, T.Orange)
	buildTiers("Boots", Config.Boots, "Boots", "BuyBoots", function(item)
		return string.format("Скорость бега %d • Прыжок %.1f", item.WalkSpeed, item.JumpHeight)
	end, T.Purple)
	buildPerks()
	buildZones()
	tabs.select("Nets")

	window.onOpen = function(arg)
		if type(arg) == "table" and arg.tab and pages[arg.tab] then
			tabs.select(arg.tab)
		end
	end
	window.onRender = function(data)
		for _, update in updaters do
			update(data)
		end
	end
end

return ShopWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">TeleportWindow</string>
              <string name="Source"><![CDATA[--[[
	TeleportWindow — быстрый переход в любую открытую зону.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local Client = script.Parent.Parent
local ClientNet = require(Client.ClientNet)
local State = require(Client.State)
local UIKit = require(script.Parent.UIKit)
local Windows = require(script.Parent.Windows)

local TeleportWindow = {}

local T = UIKit.Theme

function TeleportWindow.build()
	local window = Windows.create("Teleport", "🗺️ Телепорт", Vector2.new(640, 540), Color3.fromRGB(90, 200, 170))
	local scroll = UIKit.scroll(window.Body, {})
	UIKit.list(scroll, 8)
	UIKit.padding(scroll, 2, 4, 4)

	local updaters = {}
	for zoneId, zone in Config.Zones do
		local card = UIKit.card(scroll, {
			LayoutOrder = zoneId,
			Height = 72,
			Icon = tostring(zoneId),
			Color = zone.Theme.Accent,
			Title = zone.Name,
			Desc = "",
			ButtonWidth = 160,
			OnClick = function()
				local data = State.Data
				if not data then
					return
				end
				if zoneId <= data.MaxZone then
					if ClientNet.request("Teleport", zoneId) then
						Windows.close()
					end
				else
					Windows.open("Shop", { tab = "Zones" })
				end
			end,
		})
		table.insert(updaters, function(data)
			if zoneId <= data.MaxZone then
				card.Desc.Text = "Открыта ✅"
				UIKit.setButton(card.Button, "Перенестись", T.Blue)
			else
				card.Desc.Text = "Открывается за " .. Format.number(zone.Cost) .. " 💰"
				UIKit.setButton(card.Button, "🔒 В магазин", T.Disabled)
			end
		end)
	end

	window.onRender = function(data)
		for _, update in updaters do
			update(data)
		end
	end
end

return TeleportWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">UIKit</string>
              <string name="Source"><![CDATA[--[[
	UIKit — набор для быстрой сборки интерфейса: цвета, кнопки, карточки,
	полоски прогресса, окна с прокруткой, превью 3D-моделей.
]]

local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared.Util)

local Client = script.Parent.Parent
local Sounds = require(Client.Sounds)

local UIKit = {}

local C = Color3.fromRGB

UIKit.Theme = {
	Bg = C(18, 24, 36),
	Panel = C(27, 36, 53),
	Panel2 = C(35, 46, 67),
	Card = C(43, 56, 81),
	CardHover = C(54, 70, 100),
	Stroke = C(72, 92, 128),
	Text = C(242, 245, 250),
	Sub = C(165, 178, 200),
	Green = C(70, 205, 115),
	GreenDark = C(40, 140, 80),
	Gold = C(255, 202, 60),
	Red = C(235, 85, 85),
	Blue = C(80, 160, 255),
	Purple = C(178, 108, 255),
	Orange = C(255, 152, 60),
	Cyan = C(80, 215, 230),
	Disabled = C(80, 88, 104),
	Dark = C(12, 16, 24),
}

UIKit.Font = Enum.Font.GothamBold
UIKit.FontBlack = Enum.Font.GothamBlack
UIKit.FontMedium = Enum.Font.GothamMedium

local T = UIKit.Theme

function UIKit.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	return Util.create(className, props, children)
end

function UIKit.corner(parent: Instance, radius: number?): UICorner
	return Util.create("UICorner", { CornerRadius = UDim.new(0, radius or 12), Parent = parent })
end

function UIKit.stroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?): UIStroke
	return Util.create("UIStroke", {
		Color = color or T.Stroke,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = if parent:IsA("TextLabel") or parent:IsA("TextBox") then Enum.ApplyStrokeMode.Contextual else Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function UIKit.padding(parent: Instance, all: number, top: number?, bottom: number?): UIPadding
	return Util.create("UIPadding", {
		PaddingLeft = UDim.new(0, all),
		PaddingRight = UDim.new(0, all),
		PaddingTop = UDim.new(0, top or all),
		PaddingBottom = UDim.new(0, bottom or all),
		Parent = parent,
	})
end

function UIKit.list(parent: Instance, padding: number?, horizontal: boolean?, align: Enum.HorizontalAlignment?): UIListLayout
	return Util.create("UIListLayout", {
		Padding = UDim.new(0, padding or 8),
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

function UIKit.grid(parent: Instance, cell: UDim2, padding: number?): UIGridLayout
	return Util.create("UIGridLayout", {
		CellSize = cell,
		CellPadding = UDim2.fromOffset(padding or 8, padding or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	})
end

function UIKit.gradient(parent: Instance, top: Color3, bottom: Color3, rotation: number?): UIGradient
	return Util.create("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = rotation or 90,
		Parent = parent,
	})
end

function UIKit.tween(inst: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tween = TweenService:Create(
		inst,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		props
	)
	tween:Play()
	return tween
end

-- Текст с обводкой для читаемости
function UIKit.text(parent: Instance?, props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = UIKit.Font,
		TextColor3 = T.Text,
		TextSize = 18,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Size = UDim2.new(1, 0, 0, 24),
		Parent = parent,
	}
	local strokeIt = props.Stroke
	props.Stroke = nil
	for key, value in props do
		defaults[key] = value
	end
	local label = Util.create("TextLabel", defaults)
	if strokeIt then
		local stroke = Util.create("UIStroke", { Thickness = 2, Color = T.Dark, Transparency = 0.2, Parent = label })
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	end
	return label
end

function UIKit.frame(parent: Instance?, props: { [string]: any }): Frame
	local defaults = {
		BackgroundColor3 = T.Card,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = parent,
	}
	for key, value in props do
		defaults[key] = value
	end
	return Util.create("Frame", defaults)
end

-- Кнопка с анимацией нажатия. button:SetAttribute("Color", ...) не нужен — используй UIKit.setButton
function UIKit.button(parent: Instance?, props: { [string]: any }, onClick: (() -> ())?): TextButton
	local color = props.Color or T.Green
	props.Color = nil
	local radius = props.Radius or 10
	props.Radius = nil
	local defaults = {
		BackgroundColor3 = color,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Font = UIKit.FontBlack,
		TextColor3 = T.Text,
		TextSize = 18,
		TextWrapped = true,
		Size = UDim2.fromOffset(140, 44),
		Parent = parent,
	}
	for key, value in props do
		defaults[key] = value
	end
	local button = Util.create("TextButton", defaults)
	button:SetAttribute("BaseColor", color)
	UIKit.corner(button, radius)
	local stroke = Util.create("UIStroke", {
		Thickness = 2,
		Color = color:Lerp(C(0, 0, 0), 0.35),
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = button,
	})
	stroke.Name = "Edge"
	local scale = Util.create("UIScale", { Scale = 1, Parent = button })

	button.MouseEnter:Connect(function()
		local base = button:GetAttribute("BaseColor") :: Color3
		UIKit.tween(button, 0.12, { BackgroundColor3 = base:Lerp(C(255, 255, 255), 0.15) })
	end)
	button.MouseLeave:Connect(function()
		local base = button:GetAttribute("BaseColor") :: Color3
		UIKit.tween(button, 0.12, { BackgroundColor3 = base })
		UIKit.tween(scale, 0.1, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		UIKit.tween(scale, 0.08, { Scale = 0.94 })
	end)
	button.MouseButton1Up:Connect(function()
		UIKit.tween(scale, 0.12, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	if onClick then
		button.Activated:Connect(function()
			Sounds.play("Click", 0.35)
			onClick()
		end)
	end
	return button
end

-- Меняет цвет и текст кнопки
function UIKit.setButton(button: TextButton, text: string, color: Color3, enabled: boolean?)
	button.Text = text
	button:SetAttribute("BaseColor", color)
	button.BackgroundColor3 = color
	local edge = button:FindFirstChild("Edge") :: UIStroke?
	if edge then
		edge.Color = color:Lerp(C(0, 0, 0), 0.35)
	end
	button.Active = enabled ~= false
	button.AutoButtonColor = false
	button.TextTransparency = if enabled == false then 0.25 else 0
end

-- Полоска прогресса
function UIKit.bar(parent: Instance?, props: { [string]: any })
	local color = props.Color or T.Green
	props.Color = nil
	local defaults = {
		BackgroundColor3 = T.Dark,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 22),
		Parent = parent,
	}
	for key, value in props do
		defaults[key] = value
	end
	local back = Util.create("Frame", defaults)
	UIKit.corner(back, 8)
	local fill = Util.create("Frame", {
		Name = "Fill",
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = back,
	})
	UIKit.corner(fill, 8)
	UIKit.gradient(fill, C(255, 255, 255), C(200, 200, 200))
	local label = UIKit.text(back, {
		Name = "Label",
		Size = UDim2.fromScale(1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 14,
		Text = "",
		Stroke = true,
		ZIndex = 3,
	})
	local api = {}
	api.Frame = back
	function api.set(fraction: number, text: string?, newColor: Color3?)
		local f = math.clamp(fraction, 0, 1)
		UIKit.tween(fill, 0.25, { Size = UDim2.fromScale(f, 1) })
		fill.Visible = f > 0.001
		if text then
			label.Text = text
		end
		if newColor then
			fill.BackgroundColor3 = newColor
		end
	end
	return api
end

function UIKit.scroll(parent: Instance?, props: { [string]: any }): ScrollingFrame
	local defaults = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = T.Stroke,
		Parent = parent,
	}
	for key, value in props do
		defaults[key] = value
	end
	return Util.create("ScrollingFrame", defaults)
end

-- Квадратик с эмодзи-иконкой
function UIKit.icon(parent: Instance?, emoji: string, color: Color3, size: number): Frame
	local box = UIKit.frame(parent, {
		Name = "Icon",
		BackgroundColor3 = color:Lerp(T.Panel, 0.55),
		Size = UDim2.fromOffset(size, size),
	})
	UIKit.corner(box, 12)
	UIKit.stroke(box, color, 2, 0.2)
	UIKit.text(box, {
		Text = emoji,
		Size = UDim2.fromScale(1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextScaled = true,
	})
	UIKit.padding(box, math.floor(size * 0.14))
	return box
end

-- 3D-превью модели в интерфейсе
function UIKit.viewport(parent: Instance?, model: Model, props: { [string]: any }?): ViewportFrame
	local defaults = {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(80, 80),
		Ambient = C(200, 200, 210),
		LightColor = C(255, 255, 255),
		LightDirection = Vector3.new(-1, -1, -0.6),
		Parent = parent,
	}
	for key, value in props or {} do
		defaults[key] = value
	end
	local frame = Util.create("ViewportFrame", defaults)
	local world = Util.create("WorldModel", { Parent = frame })
	model:PivotTo(CFrame.identity)
	model.Parent = world
	local _, size = model:GetBoundingBox()
	local radius = math.max(size.X, size.Y, size.Z)
	local camera = Util.create("Camera", { FieldOfView = 40, Parent = frame })
	local eye = Vector3.new(radius * 0.9, radius * 0.75, -radius * 1.5)
	camera.CFrame = CFrame.lookAt(eye, Vector3.zero)
	frame.CurrentCamera = camera
	return frame
end

--[[
	Карточка товара/задания: иконка слева, заголовок, описание, кнопка справа.
	opts: Height, Icon (эмодзи) или IconNode(parent, size) -> GuiObject,
	      Color, Title, Desc, ButtonText, ButtonColor, ButtonWidth, OnClick, LayoutOrder
]]
function UIKit.card(parent: Instance, opts: { [string]: any })
	local height = opts.Height or 84
	local buttonWidth = opts.ButtonWidth or 150
	local frame = UIKit.frame(parent, {
		Name = opts.Name or "Card",
		Size = UDim2.new(1, -10, 0, height),
		BackgroundColor3 = T.Card,
		LayoutOrder = opts.LayoutOrder or 0,
	})
	UIKit.corner(frame, 14)
	local stroke = UIKit.stroke(frame, T.Stroke, 1.5, 0.35)
	local iconSize = height - 20
	local icon
	if opts.IconNode then
		icon = opts.IconNode(frame, iconSize)
	else
		icon = UIKit.icon(frame, opts.Icon or "❔", opts.Color or T.Blue, iconSize)
	end
	icon.Position = UDim2.fromOffset(10, 10)
	local left = iconSize + 22
	local title = UIKit.text(frame, {
		Name = "Title",
		Text = opts.Title or "",
		Font = UIKit.FontBlack,
		TextSize = 19,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(left, 8),
		Size = UDim2.new(1, -(left + buttonWidth + 20), 0, 26),
	})
	local desc = UIKit.text(frame, {
		Name = "Desc",
		Text = opts.Desc or "",
		Font = UIKit.FontMedium,
		TextSize = 15,
		TextColor3 = T.Sub,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(left, 36),
		Size = UDim2.new(1, -(left + buttonWidth + 20), 1, -42),
	})
	local button = UIKit.button(frame, {
		Name = "Action",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(buttonWidth, 46),
		Text = opts.ButtonText or "",
		TextSize = 16,
		Color = opts.ButtonColor or T.Green,
	}, opts.OnClick)
	return { Frame = frame, Stroke = stroke, Icon = icon, Title = title, Desc = desc, Button = button }
end

-- Вкладки. tabs = { {Key = "Nets", Text = "🥅 Сачки"}, ... }
function UIKit.tabs(parent: Instance, tabs: { { Key: string, Text: string } }, onSelect: (string) -> ())
	local bar = UIKit.frame(parent, {
		Name = "Tabs",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 42),
	})
	UIKit.list(bar, 6, true)
	local buttons = {}
	local api = {}
	local width = math.floor(1 / #tabs * 1000) / 1000
	for index, tab in tabs do
		local button = UIKit.button(bar, {
			Name = tab.Key,
			Text = tab.Text,
			TextSize = 16,
			LayoutOrder = index,
			Color = T.Panel2,
			Size = UDim2.new(width, -6, 1, 0),
		}, function()
			api.select(tab.Key)
		end)
		buttons[tab.Key] = button
	end
	function api.select(key: string)
		for k, button in buttons do
			UIKit.setButton(button, button.Text, if k == key then T.Blue else T.Panel2)
		end
		onSelect(key)
	end
	api.Bar = bar
	api.Buttons = buttons
	return api
end

-- Переключатель «ВКЛ/ВЫКЛ»
function UIKit.toggle(parent: Instance, icon: string, title: string, desc: string, layoutOrder: number, onClick: () -> ())
	local card = UIKit.card(parent, {
		Height = 72,
		Icon = icon,
		Color = T.Stroke,
		Title = title,
		Desc = desc,
		ButtonText = "",
		ButtonWidth = 120,
		LayoutOrder = layoutOrder,
		OnClick = onClick,
	})
	local api = {}
	function api.set(on: boolean, available: boolean?)
		if available == false then
			UIKit.setButton(card.Button, "🔒 Перк", T.Disabled)
		else
			UIKit.setButton(card.Button, if on then "ВКЛ" else "ВЫКЛ", if on then T.Green else T.Disabled)
		end
	end
	api.Card = card
	return api
end

-- Масштаб интерфейса под размер экрана
local scales: { UIScale } = {}
local currentScale = 1

local function computeScale(): number
	local camera = workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	local inset = GuiService:GetGuiInset()
	local h = size.Y - inset.Y
	return math.clamp(math.min(size.X / 1150, h / 660), 0.5, 1.15)
end

function UIKit.scaleGroup(target: GuiObject): UIScale
	local scale = Util.create("UIScale", { Name = "AutoScale", Scale = currentScale, Parent = target })
	table.insert(scales, scale)
	return scale
end

function UIKit.globalScale(): number
	return currentScale
end

function UIKit.startScaling()
	local function update()
		currentScale = computeScale()
		for _, scale in scales do
			scale.Scale = currentScale
		end
	end
	update()
	local function hook()
		local camera = workspace.CurrentCamera
		if camera then
			camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
		end
	end
	hook()
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		hook()
		update()
	end)
end

return UIKit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">Windows</string>
              <string name="Source"><![CDATA[--[[
	Windows — менеджер окон: открыто всегда не больше одного окна.
	Окно = рамка с заголовком, кнопкой «✕» и телом (Body).

	local w = Windows.create("Shop", "🛒 Магазин", Vector2.new(720, 500), color)
	w.onOpen = function(arg) end       -- при открытии
	w.onRender = function(data) end    -- при изменении данных игрока
	w.onTick = function(data) end      -- раз в полсекунды, пока окно открыто
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Signal)

local Client = script.Parent.Parent
local State = require(Client.State)
local UIKit = require(script.Parent.UIKit)

local Windows = {}
Windows.Changed = Signal.new() -- (name | nil)

local T = UIKit.Theme
local registry: { [string]: any } = {}
local current: string? = nil
local screen: ScreenGui

function Windows.init(gui: ScreenGui)
	screen = gui
end

function Windows.create(name: string, title: string, size: Vector2, accent: Color3?)
	local color = accent or T.Blue
	local holder = UIKit.frame(screen, {
		Name = name .. "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.53),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundTransparency = 1,
		Visible = false,
	})
	UIKit.scaleGroup(holder)

	local frame = UIKit.frame(holder, {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = T.Panel,
	})
	UIKit.corner(frame, 18)
	UIKit.stroke(frame, color, 3)
	UIKit.gradient(frame, T.Panel2, T.Bg)
	local anim = UIKit.new("UIScale", { Scale = 1, Parent = frame })

	local header = UIKit.frame(frame, {
		Name = "Header",
		BackgroundColor3 = color,
		Size = UDim2.new(1, 0, 0, 56),
	})
	UIKit.corner(header, 18)
	UIKit.gradient(header, color, color:Lerp(Color3.new(0, 0, 0), 0.35))
	-- прямой нижний край шапки
	UIKit.frame(header, {
		Name = "Flat",
		BackgroundColor3 = color:Lerp(Color3.new(0, 0, 0), 0.35),
		Position = UDim2.new(0, 0, 1, -14),
		Size = UDim2.new(1, 0, 0, 14),
	})
	local titleLabel = UIKit.text(header, {
		Name = "Title",
		Text = title,
		Font = UIKit.FontBlack,
		TextSize = 26,
		Position = UDim2.fromOffset(20, 0),
		Size = UDim2.new(1, -90, 1, 0),
		Stroke = true,
	})

	local window = {
		Name = name,
		Holder = holder,
		Frame = frame,
		Header = header,
		Title = titleLabel,
		Accent = color,
		onOpen = nil :: ((any) -> ())?,
		onRender = nil :: ((any) -> ())?,
		onTick = nil :: ((any) -> ())?,
	}

	UIKit.button(header, {
		Name = "Close",
		Text = "✕",
		TextSize = 24,
		Color = T.Red,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(42, 42),
	}, function()
		Windows.close()
	end)

	local body = UIKit.frame(frame, {
		Name = "Body",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 60),
		Size = UDim2.new(1, 0, 1, -64),
	})
	UIKit.padding(body, 16, 10, 14)
	window.Body = body
	window.Anim = anim

	registry[name] = window
	return window
end

function Windows.get(name: string)
	return registry[name]
end

function Windows.current(): string?
	return current
end

function Windows.render(name: string?)
	local key = name or current
	local window = key and registry[key]
	if window and window.Holder.Visible and window.onRender and State.Data then
		local ok, err = pcall(window.onRender, State.Data)
		if not ok then
			warn("[Окно " .. tostring(key) .. "]", err)
		end
	end
end

function Windows.open(name: string, arg: any?)
	local window = registry[name]
	if not window then
		return
	end
	if current and current ~= name then
		Windows.close()
	end
	current = name
	window.Holder.Visible = true
	window.Anim.Scale = 0.85
	UIKit.tween(window.Anim, 0.22, { Scale = 1 }, Enum.EasingStyle.Back)
	if window.onOpen then
		local ok, err = pcall(window.onOpen, arg)
		if not ok then
			warn("[Окно " .. name .. "]", err)
		end
	end
	Windows.render(name)
	Windows.Changed:Fire(name)
end

function Windows.close()
	if current then
		local window = registry[current]
		window.Holder.Visible = false
		current = nil
		Windows.Changed:Fire(nil)
	end
end

function Windows.toggle(name: string, arg: any?)
	if current == name then
		Windows.close()
	else
		Windows.open(name, arg)
	end
end

function Windows.start()
	State.Changed:Connect(function()
		Windows.render()
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			local window = current and registry[current]
			if window and window.onTick and State.Data then
				local ok, err = pcall(window.onTick, State.Data)
				if not ok then
					warn("[Окно " .. tostring(current) .. "]", err)
				end
			end
		end
	end)
end

return Windows
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="59">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>