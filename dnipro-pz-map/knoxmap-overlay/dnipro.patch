+# The Ukrainian / post-Soviet private house (privatnyi sektor): brick - red
+# or the pale silicate kind - or plastered and painted, one storey or two,
+# under a pitched or hipped roof of slate or sheet metal, behind a fence.
+# Not weatherboard, not log cabins, not trailers, not American vinyl siding.
+# Old village-style houses still wear wooden shutters, so a share keeps them.
+UA_BASES = ("brick", "stucco", "render", "painted")
+UA_SHUTTERED = ("brick", "painted")
+
+_UA_STYLES: list | None = None
+
+
+def ua_house_styles() -> list[dict]:
+    """The house styles a Ukrainian town's private sector is built from."""
+    global _UA_STYLES
+    if _UA_STYLES is None:
+        from . import catalog as C
+        by_name = {s["name"]: s for s in C.HOUSE_STYLES}
+        out = []
+        for name in UA_BASES:
+            base = by_name.get(name)
+            if not base:
+                continue
+            plain = dict(base)
+            plain["name"] = f"ua_{name}"
+            plain.pop("shutters", None)
+            out.append(plain)
+            if name in UA_SHUTTERED and base.get("shutters"):
+                shuttered = dict(base)
+                shuttered["name"] = f"ua_{name}_shutters"
+                out.append(shuttered)
+        _UA_STYLES = out
+    return _UA_STYLES
+
+
+def house_styles_for(region: str | None) -> list[dict] | None:
+    """The regional house pool, or None for the game's own Knox County mix."""
+    if region == "cn":
+        return cn_house_styles()
+    if region == "ua":
+        return ua_house_styles()
+    return None
+
+
